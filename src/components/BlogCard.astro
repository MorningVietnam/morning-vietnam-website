---
import { BLOG_CATEGORIES } from '../data/blog-categories';

interface Props {
  entry: {
    id: string;
    data: {
      title: string;
      excerpt: string;
      category: 'travel-guides' | 'deep-culture' | 'behind-the-tour';
      publishedAt: Date;
      coverImage: string;
      readTime: number;
    };
  };
}

const { entry } = Astro.props;
const cat = BLOG_CATEGORIES[entry.data.category];
const dateStr = entry.data.publishedAt.toLocaleDateString('en-US', {
  day: 'numeric', month: 'long', year: 'numeric'
});
---

<a href={`/blog/${entry.id}`} class="blog-card">
  <div class="blog-card__image">
    <img src={entry.data.coverImage} alt={entry.data.title} loading="lazy" />
  </div>
  <div class="blog-card__body">
    <div class="blog-card__meta">
      <span class="blog-card__cat">{cat.label}</span>
      <span class="blog-card__dot">•</span>
      <span class="blog-card__date">{dateStr}</span>
    </div>
    <h3 class="blog-card__title">{entry.data.title}</h3>
  </div>
</a>

<style>
  .blog-card {
    display: flex;
    flex-direction: column;
    gap: 20px;
    text-decoration: none;
    color: inherit;
    transition: transform 0.4s var(--ease-smooth);
  }
  .blog-card:hover { transform: translateY(-6px); }

  .blog-card__image {
    aspect-ratio: 16/10;
    border-radius: 16px;
    overflow: hidden;
    background: var(--color-light-cyan);
  }
  .blog-card__image img {
    width: 100%; height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease-smooth);
  }
  .blog-card:hover .blog-card__image img { transform: scale(1.05); }

  .blog-card__body { display: flex; flex-direction: column; gap: 10px; }

  .blog-card__meta {
    display: flex; align-items: center; gap: 8px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-java);
  }
  .blog-card__dot { opacity: 0.4; }
  .blog-card__date { color: var(--color-nordic); opacity: 0.5; }

  .blog-card__title {
    font-family: var(--font-heading);
    font-size: clamp(18px, 1.6vw, 22px);
    font-weight: 700;
    color: var(--color-nordic);
    line-height: 1.3;
  }
</style>
