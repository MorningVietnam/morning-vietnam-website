---
interface Props {
  author: { name: string; role?: string; avatar?: string };
  headings: Array<{ depth: number; slug: string; text: string }>;
  url: string;
}
const { author, headings, url } = Astro.props;

const tocItems = headings.filter(h => h.depth === 2);
---

<aside class="blog-sidebar">
  {tocItems.length > 0 && (
    <nav class="blog-sidebar__toc">
      <p class="blog-sidebar__label">In this post</p>
      <ul>
        {tocItems.map(h => (
          <li><a href={`#${h.slug}`}>{h.text}</a></li>
        ))}
      </ul>
    </nav>
  )}

  <div class="blog-sidebar__author">
    {author.avatar && (
      <img src={author.avatar} alt={author.name} class="blog-sidebar__avatar" />
    )}
    <div>
      <p class="blog-sidebar__author-name">{author.name}</p>
      {author.role && <p class="blog-sidebar__author-role">{author.role}</p>}
    </div>
  </div>

  <div class="blog-sidebar__share">
    <p class="blog-sidebar__label">Share</p>
    <div class="blog-sidebar__share-icons">
      <a href={`https://wa.me/?text=${encodeURIComponent(url)}`} target="_blank" rel="noopener" aria-label="WhatsApp">WA</a>
      <a href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(url)}`} target="_blank" rel="noopener" aria-label="Facebook">FB</a>
      <a href={`https://twitter.com/intent/tweet?url=${encodeURIComponent(url)}`} target="_blank" rel="noopener" aria-label="Twitter">TW</a>
    </div>
  </div>
</aside>

<style>
  .blog-sidebar {
    position: sticky;
    top: calc(var(--site-header-h, 100px) + 24px);
    display: flex;
    flex-direction: column;
    gap: 32px;
    padding: 28px 24px;
    background: var(--color-white-nectar);
    border-radius: 16px;
    align-self: start;
  }

  .blog-sidebar__label {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-java);
    margin-bottom: 12px;
  }

  .blog-sidebar__toc ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .blog-sidebar__toc a {
    display: block;
    font-size: 13px;
    line-height: 1.5;
    color: var(--color-nordic);
    opacity: 0.75;
    text-decoration: none;
    transition: opacity 0.2s ease, color 0.2s ease;
  }
  .blog-sidebar__toc a:hover { opacity: 1; color: var(--color-java); }

  .blog-sidebar__author {
    display: flex;
    align-items: center;
    gap: 12px;
    padding-top: 24px;
    border-top: 1px solid rgba(4, 51, 65, 0.1);
  }
  .blog-sidebar__avatar {
    width: 44px; height: 44px;
    border-radius: 50%;
    object-fit: cover;
  }
  .blog-sidebar__author-name {
    font-weight: 700;
    font-size: 14px;
    color: var(--color-nordic);
  }
  .blog-sidebar__author-role {
    font-size: 12px;
    color: var(--color-nordic);
    opacity: 0.6;
  }

  .blog-sidebar__share-icons {
    display: flex;
    gap: 10px;
  }
  .blog-sidebar__share-icons a {
    width: 36px; height: 36px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: white;
    border: 1px solid rgba(4, 51, 65, 0.15);
    font-size: 11px;
    font-weight: 700;
    color: var(--color-nordic);
    text-decoration: none;
    transition: all 0.2s ease;
  }
  .blog-sidebar__share-icons a:hover {
    background: var(--color-java);
    color: white;
    border-color: var(--color-java);
  }

  @media (max-width: 900px) {
    .blog-sidebar { position: static; }
  }
</style>
