---
import LangSwitcher from './LangSwitcher.astro';
import { getLangFromPath, stripLang, navPath, type Lang } from '../i18n/config';
import { useTranslations } from '../i18n/ui';

const path = Astro.url.pathname;

// Ngôn ngữ hiện tại + hàm dịch. `t('nav.tours')` sẽ trả về "Tours" hoặc "Tour"
// tuỳ khách đang xem bản nào.
const lang: Lang = getLangFromPath(path);
const t = useTranslations(lang);

// `l()` = biến '/tours' thành '/vi/tours' khi đang ở bản tiếng Việt.
// Nếu trang đó CHƯA được dịch (chưa khai báo trong VI_ROUTES), hàm tự trả về
// bản tiếng Anh để khách không rơi vào trang 404.
// MỌI link nội bộ trong header phải bọc qua hàm này.
const l = (p: string) => navPath(p, lang);

// Xác định mục nào đang active — so sánh trên đường dẫn ĐÃ bỏ tiền tố ngôn ngữ
const base       = stripLang(path);
const isExplore  = base.startsWith('/explore');
const isTours    = base === '/tours' || base.startsWith('/tours/');
const isContact  = base === '/contact';
const isPartners = base.startsWith('/catalogue');

const marqueeItems = [
  t('marquee.1'),
  t('marquee.2'),
  t('marquee.3'),
  t('marquee.4'),
  t('marquee.5'),
  t('marquee.6'),
];
---

<!-- ═══ SITE HEADER WRAPPER (fixed) ═══════════════════════════════════════ -->
<div class="header" id="site-header">

  <!-- 1. Marquee banner -->
  <div class="b-marquee" aria-hidden="true">
    <div class="b-marquee__track">
      {[...marqueeItems, ...marqueeItems].map(item => (
        <span class="b-marquee__item">
          {item}
          <span class="b-marquee__sep">✦</span>
        </span>
      ))}
    </div>
  </div>

  <!-- 2. Nav bar -->
  <div class="header__bar">
    <div class="wrapper header__inner">

      <!-- Logo -->
      <a href={l('/')} class="header__logo" aria-label="Morning Vietnam — home">
        <img src="/logo.png" alt="Morning Vietnam" class="header__logo-img" />
      </a>

      <!-- Desktop nav -->
      <nav class="header__nav" aria-label="Main navigation">
        <ul class="header__nav-list">

          <!-- Explore (dropdown only — NOT a link) -->
          <li class="nav-item nav-item--dropdown">
            <span class:list={["nav-link", "nav-link--trigger", { "nav-link--active": isExplore }]}>
              {t('nav.explore')}
              <svg class="nav-arrow" width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                <path d="M2 4L6 8L10 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
            <div class="nav-dropdown" role="menu">
              <a href={l('/explore/about')} class="nav-dropdown__link" role="menuitem">
                <span class="nav-dropdown__label">{t('nav.about')}</span>
                <span class="nav-dropdown__desc">{t('nav.about.desc')}</span>
              </a>
              <a href={l('/explore/vietnam-facts')} class="nav-dropdown__link" role="menuitem">
                <span class="nav-dropdown__label">{t('nav.facts')}</span>
                <span class="nav-dropdown__desc">{t('nav.facts.desc')}</span>
              </a>
              <a href={l('/explore/faq')} class="nav-dropdown__link" role="menuitem">
                <span class="nav-dropdown__label">{t('nav.faq')}</span>
                <span class="nav-dropdown__desc">{t('nav.faq.desc')}</span>
              </a>
              <a href={l('/explore/travel-guide')} class="nav-dropdown__link" role="menuitem">
                <span class="nav-dropdown__label">{t('nav.travelGuide')}</span>
                <span class="nav-dropdown__desc">{t('nav.travelGuide.desc')}</span>
              </a>
            </div>
          </li>

          <!-- Tours (direct link) -->
          <li class="nav-item">
            <a
              href={l('/tours')}
              class:list={["nav-link", { "nav-link--active": isTours }]}
            >{t('nav.tours')}</a>
          </li>

          <!-- For Partners (dropdown — B2B) -->
          <li class="nav-item nav-item--dropdown">
            <span class:list={["nav-link", "nav-link--trigger", { "nav-link--active": isPartners }]}>
              {t('nav.partners')}
              <svg class="nav-arrow" width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                <path d="M2 4L6 8L10 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
            <div class="nav-dropdown" role="menu">
              <a href={l('/catalogue')} class="nav-dropdown__link" role="menuitem">
                <span class="nav-dropdown__label">{t('nav.catalogue')}</span>
                <span class="nav-dropdown__desc">{t('nav.catalogue.desc')}</span>
              </a>
              <a href={l('/contact')} class="nav-dropdown__link" role="menuitem">
                <span class="nav-dropdown__label">{t('nav.partnerWithUs')}</span>
                <span class="nav-dropdown__desc">{t('nav.partnerWithUs.desc')}</span>
              </a>
            </div>
          </li>

          <!-- Contact (direct link) -->
          <li class="nav-item">
            <a
              href={l('/contact')}
              class:list={["nav-link", { "nav-link--active": isContact }]}
            >{t('nav.contact')}</a>
          </li>

        </ul>
      </nav>

      <!-- Right: CTA + hamburger -->
      <div class="header__right">
        <!-- Nút chọn ngôn ngữ — đặt TRƯỚC nút CTA để không cạnh tranh sự chú ý -->
        <LangSwitcher variant="desktop" />
        <a href={l('/contact')} class="c-button c-button--primary header__book-btn">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true" style="flex-shrink:0">
            <circle cx="12" cy="12" r="4.5" fill="currentColor" stroke="none"/>
            <line x1="12" y1="2" x2="12" y2="5"/><line x1="12" y1="19" x2="12" y2="22"/>
            <line x1="4.22" y1="4.22" x2="6.34" y2="6.34"/><line x1="17.66" y1="17.66" x2="19.78" y2="19.78"/>
            <line x1="2" y1="12" x2="5" y2="12"/><line x1="19" y1="12" x2="22" y2="12"/>
            <line x1="4.22" y1="19.78" x2="6.34" y2="17.66"/><line x1="17.66" y1="6.34" x2="19.78" y2="4.22"/>
          </svg>
          {t('cta.book')}
        </a>
        <button
          class="hamburger"
          aria-label={t('mobile.open')}
          aria-expanded="false"
          aria-controls="mobile-nav"
        >
          <span class="hamburger__line"></span>
          <span class="hamburger__line"></span>
          <span class="hamburger__line"></span>
        </button>
      </div>

    </div>
  </div>
</div><!-- /.header -->


<!-- ═══ MOBILE NAV ════════════════════════════════════════════════════════ -->
<nav
  class="mobile-nav"
  id="mobile-nav"
  aria-label="Navigation menu"
  aria-hidden="true"
>
  <button class="mobile-nav__close" aria-label={t('mobile.close')}>✕</button>

  <ul class="mobile-nav__list">
    <li class="mobile-nav__group">
      <span>{t('nav.explore')}</span>
      <ul class="mobile-nav__sub">
        <li><a href={l('/explore/about')}>{t('nav.about')}</a></li>
        <li><a href={l('/explore/vietnam-facts')}>{t('nav.facts')}</a></li>
        <li><a href={l('/explore/faq')}>{t('nav.faq')}</a></li>
        <li><a href={l('/explore/travel-guide')}>{t('nav.travelGuide')}</a></li>
      </ul>
    </li>
    <li><a href={l('/tours')}>{t('nav.tours')}</a></li>
    <li class="mobile-nav__group">
      <span>{t('nav.partners')}</span>
      <ul class="mobile-nav__sub">
        <li><a href={l('/catalogue')}>{t('nav.catalogue')}</a></li>
        <li><a href={l('/contact')}>{t('nav.partnerWithUs')}</a></li>
      </ul>
    </li>
    <li><a href={l('/contact')}>{t('nav.contact')}</a></li>
  </ul>

  <a href={l('/contact')} class="c-button c-button--primary">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true" style="flex-shrink:0">
      <circle cx="12" cy="12" r="4.5" fill="currentColor" stroke="none"/>
      <line x1="12" y1="2" x2="12" y2="5"/><line x1="12" y1="19" x2="12" y2="22"/>
      <line x1="4.22" y1="4.22" x2="6.34" y2="6.34"/><line x1="17.66" y1="17.66" x2="19.78" y2="19.78"/>
      <line x1="2" y1="12" x2="5" y2="12"/><line x1="19" y1="12" x2="22" y2="12"/>
      <line x1="4.22" y1="19.78" x2="6.34" y2="17.66"/><line x1="17.66" y1="6.34" x2="19.78" y2="4.22"/>
    </svg>
    {t('cta.book')}
  </a>

  <!-- Chọn ngôn ngữ trong menu di động — đặt cuối, dưới nút CTA -->
  <LangSwitcher variant="mobile" />
</nav>

<div class="mobile-nav-overlay" aria-hidden="true"></div>


<!-- ═══ HEADER SCRIPTS ════════════════════════════════════════════════════ -->
<script>
  (() => {
    const mobileNav    = document.getElementById('mobile-nav') as HTMLElement;
    const overlay      = document.querySelector('.mobile-nav-overlay') as HTMLElement;
    const hamburger    = document.querySelector('.hamburger') as HTMLButtonElement;
    const closeBtn     = document.querySelector('.mobile-nav__close') as HTMLButtonElement;

    const header = document.querySelector('.header') as HTMLElement;

    function openMobileNav() {
      mobileNav.classList.add('open');
      mobileNav.setAttribute('aria-hidden', 'false');
      overlay.classList.add('open');
      hamburger.classList.add('open');
      header?.classList.add('open');     // để CSS .header.open đổi màu logo
      hamburger.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
    }

    function closeMobileNav() {
      mobileNav.classList.remove('open');
      mobileNav.setAttribute('aria-hidden', 'true');
      overlay.classList.remove('open');
      hamburger.classList.remove('open');
      header?.classList.remove('open');
      hamburger.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
    }

    hamburger?.addEventListener('click', () => {
      mobileNav.classList.contains('open') ? closeMobileNav() : openMobileNav();
    });

    closeBtn?.addEventListener('click', closeMobileNav);
    overlay?.addEventListener('click', closeMobileNav);

    // Close on any nav link click
    mobileNav?.querySelectorAll('a').forEach(a => a.addEventListener('click', closeMobileNav));

    // Escape key
    document.addEventListener('keydown', e => {
      if (e.key === 'Escape' && mobileNav.classList.contains('open')) closeMobileNav();
    });
  })();
</script>


<!-- ═══ STYLES ════════════════════════════════════════════════════════════ -->
<style is:global>
  /* ── Layout variables ────────────────────────────────────────────── */
  :root {
    --marquee-height: 40px;
    --nav-height:     60px;
    --site-header-h:  calc(var(--marquee-height) + var(--nav-height));
  }

  /* ── Fixed wrapper ───────────────────────────────────────────────── */
  .header {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 800;
  }

  /* ── Nav bar ─────────────────────────────────────────────────────── */
  .header__bar {
    height: var(--nav-height);
    transition: background 0.3s ease, box-shadow 0.3s ease;
  }

  /* Scrolled: frosted glass */
  .header.scrolled .header__bar {
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: 0 2px 24px rgba(4, 51, 65, 0.08);
  }

  .header__inner {
    display: flex;
    align-items: center;
    height: 100%;
    gap: 32px;
  }

  /* ── Logo ────────────────────────────────────────────────────────── */
  .header__logo {
    flex-shrink: 0;
    display: flex;
    align-items: center;
  }

  .header__logo-img {
    height: 65px;
    width: auto;
    display: block;
    transition: opacity 0.3s ease;
  }

  .header__logo:hover .header__logo-img {
    opacity: 0.8;
  }

  /* ── Desktop nav ─────────────────────────────────────────────────── */
  .header__nav {
    flex: 1;
    display: flex;
    justify-content: center;
  }

  .header__nav-list {
    display: flex;
    align-items: center;
    gap: 4px;
    list-style: none;
    margin: 0; padding: 0;
  }

  /* Nav link — white on transparent, nordic on scrolled */
  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 8px 16px;
    border-radius: 100px;
    font-family: var(--font-heading);
    font-size: 15px;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.88);
    cursor: pointer;
    transition: color 0.25s ease, background 0.25s ease;
    white-space: nowrap;
    text-decoration: none;
    user-select: none;
  }

  .header.scrolled .nav-link {
    color: var(--color-nordic);
  }

  .nav-link:hover {
    color: var(--color-java);
    background: rgba(29, 160, 160, 0.12);
  }

  .header.scrolled .nav-link:hover {
    background: rgba(29, 160, 160, 0.1);
  }

  /* Active state: sorbus underline */
  .nav-link--active {
    color: var(--color-riptide) !important;
    position: relative;
  }

  .nav-link--active::after {
    content: '';
    position: absolute;
    bottom: 4px;
    left: 16px;
    right: 16px;
    height: 2px;
    background: var(--color-riptide);
    border-radius: 1px;
  }

  .header.scrolled .nav-link--active {
    color: var(--color-sorbus) !important;
  }

  .header.scrolled .nav-link--active::after {
    background: var(--color-sorbus);
  }

  /* ── Explore dropdown (exact Happly spec) ────────────────────────── */
  .nav-item--dropdown { position: relative; }

  .nav-link--trigger {
    cursor: pointer;
    user-select: none;
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .nav-arrow {
    width: 12px;
    height: 12px;
    transition: transform 0.25s ease;
    flex-shrink: 0;
  }

  .nav-item--dropdown:hover .nav-arrow { transform: rotate(180deg); }

  .nav-dropdown {
    position: absolute;
    top: calc(100% + 12px);
    left: 50%;
    transform: translateX(-50%) translateY(-8px);
    min-width: 240px;
    background: white;
    border-radius: 16px;
    padding: 8px;
    box-shadow: 0 8px 40px rgba(4, 51, 65, 0.15);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s ease, transform 0.25s ease;
    z-index: 10;
  }

  /* Bridge the 12px gap between trigger and dropdown so hover doesn't drop */
  .nav-dropdown::before {
    content: '';
    position: absolute;
    top: -14px;
    left: -20px;
    right: -20px;
    height: 14px;
  }

  .nav-item--dropdown:hover .nav-dropdown {
    opacity: 1;
    pointer-events: all;
    transform: translateX(-50%) translateY(0);
  }

  .nav-dropdown__link {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 12px 16px;
    border-radius: 10px;
    transition: background 0.2s ease;
    text-decoration: none;
  }

  .nav-dropdown__link:hover { background: var(--color-light-cyan); }

  .nav-dropdown__label {
    font-weight: 600;
    font-size: 15px;
    color: var(--color-nordic);
  }

  .nav-dropdown__desc {
    font-size: 12px;
    color: var(--color-nordic);
    opacity: 0.6;
  }

  /* ── Right side ──────────────────────────────────────────────────── */
  .header__right {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-shrink: 0;
  }

  .header__book-btn {
    font-size: 13px;
    padding: 10px 22px;
    display: inline-flex;
    align-items: center;
    gap: 7px;
  }

  /* ── Hamburger ───────────────────────────────────────────────────── */
  .hamburger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 40px;
    height: 40px;
    padding: 8px;
    background: none;
    border: none;
    cursor: pointer;
    border-radius: 8px;
    transition: background 0.2s ease;
  }

  .hamburger:hover { background: rgba(255,255,255,0.12); }
  .header.scrolled .hamburger:hover { background: rgba(4,51,65,0.08); }

  .hamburger__line {
    display: block;
    width: 22px;
    height: 2px;
    background: rgba(255,255,255,0.9);
    border-radius: 2px;
    transition: transform 0.3s ease, opacity 0.3s ease, background 0.3s ease;
    transform-origin: center;
  }

  .header.scrolled .hamburger__line { background: var(--color-nordic); }

  .hamburger.open .hamburger__line:nth-child(1) { transform: translateY(7px) rotate(45deg);  }
  .hamburger.open .hamburger__line:nth-child(2) { opacity: 0; transform: scaleX(0); }
  .hamburger.open .hamburger__line:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  /* ── Mobile nav — Happly drop-down pattern ────────────────────────
     Animation: height 0 → ~96vh, trượt xuống từ ngay dưới BANNER
     marquee (không phải dưới toàn header). Header bar (logo +
     hamburger) sẽ nằm TRÊN menu — vẫn click hamburger để đóng được.
     Background Teal Java; bỏ border đậm (gây ấn tượng "thanh chém").
  */
  .mobile-nav {
    position: fixed;
    top: var(--marquee-height, 24px);  /* dưới banner marquee */
    left: 0;
    right: 0;
    z-index: 750;                       /* dưới header (z=800) → hamburger luôn click được */
    background: var(--color-java);      /* Teal Java #1da0a0 */
    display: flex;
    flex-direction: column;
    padding: 0 32px;
    height: 0;
    overflow: hidden;
    border-radius: 0 0 28px 28px;
    /* Bỏ border đậm để không có "thanh chém ngang" */
    box-shadow: 0 12px 30px rgba(4, 51, 65, 0.22);
    transition: height 0.45s cubic-bezier(0.645, 0.045, 0.355, 1),
                padding 0.45s cubic-bezier(0.645, 0.045, 0.355, 1);
  }

  .mobile-nav.open {
    height: calc(100vh - var(--marquee-height, 24px) - 12px);
    /* Padding-top cố định 152px — đủ vượt nav-bar và đẩy text xuống */
    padding: 152px 32px 32px;
  }

  /* Elements bên trong: ẩn mặc định, fade in bằng KEYFRAMES khi panel
     có class .open. Lý do dùng keyframes thay vì transition: khi browser
     batch nhiều thay đổi class cùng lúc, transition đôi khi bị skip.
     Animation luôn chạy đúng. */
  .mobile-nav__list,
  .mobile-nav > .c-button {
    opacity: 0;
    transform: translateY(12px);
  }

  .mobile-nav.open .mobile-nav__list {
    animation: mvFadeInUp 0.35s ease 0.35s forwards;
  }
  .mobile-nav.open > .c-button {
    animation: mvFadeInUp 0.35s ease 0.5s forwards;  /* trễ hơn list 0.15s */
  }

  @keyframes mvFadeInUp {
    from { opacity: 0; transform: translateY(12px); }
    to   { opacity: 1; transform: translateY(0);   }
  }

  /* Header bar luôn ở trên menu — hamburger luôn click được */
  .header { z-index: 800; }

  /* Hamburger đã làm vai trò close — ẩn nút close cũ */
  .mobile-nav__close { display: none; }

  .mobile-nav__list {
    list-style: none;
    margin-top: 0;
    padding: 0;
    overflow-y: auto;            /* scrollable nếu menu dài hơn viewport */
    flex: 1;
    scrollbar-width: none;        /* Firefox */
  }
  .mobile-nav__list::-webkit-scrollbar { display: none; }

  .mobile-nav__list > li > a,
  .mobile-nav__list > li > span {
    font-family: var(--font-heading);
    font-size: 30px;
    font-weight: 700;
    color: white;
    display: block;
    padding: 10px 0;
    text-decoration: none;
    transition: color 0.2s ease, transform 0.2s ease;
  }

  .mobile-nav__list > li > a:hover {
    color: var(--color-white-nectar);  /* cream nổi trên teal */
  }

  .mobile-nav__sub {
    list-style: none;
    padding: 2px 0 8px 20px;
  }

  .mobile-nav__sub li a {
    font-size: 17px;
    color: var(--color-white-nectar);  /* cream — đọc rõ trên teal */
    opacity: 0.85;
    display: block;
    padding: 5px 0;
    text-decoration: none;
    transition: color 0.2s ease, opacity 0.2s ease;
  }

  .mobile-nav__sub li a:hover { color: white; opacity: 1; }

  .mobile-nav > .c-button {
    margin-top: 16px;
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 13px;
    padding: 11px 22px;
    letter-spacing: 0.04em;
    /* Sorbus CTA — pop trên nền teal */
    background: var(--color-sorbus);
    color: white;
    border: 2px solid var(--color-sorbus);
  }
  .mobile-nav > .c-button:hover {
    background: transparent;
    color: white;
    border-color: white;
  }

  /* Mobile rất nhỏ: thu thêm + giảm font menu items để không bị chật */
  @media (max-width: 420px) {
    /* Padding-top cố định 152px; chỉ giảm padding ngang */
    .mobile-nav.open { padding: 152px 24px 24px; }
    .mobile-nav__list > li > a,
    .mobile-nav__list > li > span { font-size: 26px; padding: 8px 0; }
    .mobile-nav__sub li a { font-size: 16px; }
    .mobile-nav > .c-button { font-size: 12px; padding: 10px 18px; }
  }

  /* ── Overlay (nhẹ — menu kiểu rèm cửa, không full-screen) ───── */
  .mobile-nav-overlay {
    position: fixed;
    top: var(--marquee-height, 24px);   /* khớp top của menu */
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 700;                        /* dưới menu (750) */
