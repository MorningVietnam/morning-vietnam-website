---
interface Side {
  src?: string;
  alt: string;
  caption?: string;
  resolution?: string;
  filename?: string;
  direction?: string;
}
interface Props {
  left: Side;
  right: Side;
}
const { left, right } = Astro.props;

const renderSide = (side: Side) => ({
  ...side,
  hasImage: side.src && side.src.length > 0,
  resolution: side.resolution || '1200 × 900',
  filename: side.filename || 'image.jpg',
  direction: side.direction || 'Add image direction here',
});

const L = renderSide(left);
const R = renderSide(right);
---

<div class="image-compare">
  <figure>
    {L.hasImage ? (
      <img src={L.src} alt={L.alt} loading="lazy" />
    ) : (
      <div class="photo-ph" style="aspect-ratio: 4/3">
        <span class="photo-ph__icon">📷</span>
        <span class="photo-ph__label">Photo needed · LEFT</span>
        <span class="photo-ph__spec">Resolution: <strong>{L.resolution}</strong> · Aspect 4:3</span>
        <span class="photo-ph__file">public/blog/rice-harvest-sapa/{L.filename}</span>
        <span class="photo-ph__direction">{L.direction}</span>
      </div>
    )}
    {L.caption && <figcaption>{L.caption}</figcaption>}
  </figure>
  <figure>
    {R.hasImage ? (
      <img src={R.src} alt={R.alt} loading="lazy" />
    ) : (
      <div class="photo-ph" style="aspect-ratio: 4/3">
        <span class="photo-ph__icon">📷</span>
        <span class="photo-ph__label">Photo needed · RIGHT</span>
        <span class="photo-ph__spec">Resolution: <strong>{R.resolution}</strong> · Aspect 4:3</span>
        <span class="photo-ph__file">public/blog/rice-harvest-sapa/{R.filename}</span>
        <span class="photo-ph__direction">{R.direction}</span>
      </div>
    )}
    {R.caption && <figcaption>{R.caption}</figcaption>}
  </figure>
</div>

<style>
  .image-compare {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin: 40px 0;
  }
  .image-compare figure { margin: 0; }
  .image-compare img {
    width: 100%;
    aspect-ratio: 4/3;
    object-fit: cover;
    border-radius: 12px;
    display: block;
  }
  .image-compare figcaption {
    margin-top: 10px;
    font-size: 13px;
    font-style: italic;
    color: var(--color-nordic);
    opacity: 0.65;
    line-height: 1.5;
  }
  @media (max-width: 700px) {
    .image-compare { grid-template-columns: 1fr; }
  }
</style>
