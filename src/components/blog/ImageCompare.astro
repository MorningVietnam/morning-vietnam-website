---
interface Props {
  left: { src: string; alt: string; caption?: string };
  right: { src: string; alt: string; caption?: string };
}
const { left, right } = Astro.props;
---

<div class="image-compare">
  <figure>
    <img src={left.src} alt={left.alt} loading="lazy" />
    {left.caption && <figcaption>{left.caption}</figcaption>}
  </figure>
  <figure>
    <img src={right.src} alt={right.alt} loading="lazy" />
    {right.caption && <figcaption>{right.caption}</figcaption>}
  </figure>
</div>

<style>
  .image-compare {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin: 40px 0;
  }
  .image-compare figure { margin: 0; }
  .image-compare img {
    width: 100%;
    aspect-ratio: 4/3;
    object-fit: cover;
    border-radius: 12px;
    display: block;
  }
  .image-compare figcaption {
    margin-top: 10px;
    font-size: 13px;
    font-style: italic;
    color: var(--color-nordic);
    opacity: 0.65;
    line-height: 1.5;
  }
  @media (max-width: 700px) {
    .image-compare { grid-template-columns: 1fr; }
  }
</style>
