---
interface Props {
  src?: string;
  alt: string;
  caption?: string;
  aspect?: string;
  resolution?: string;
  filename?: string;
  direction?: string;
}
const {
  src = '',
  alt,
  caption,
  aspect = '16/9',
  resolution = '1600 × 900',
  filename = 'image.jpg',
  direction = 'Add image direction here',
} = Astro.props;
const hasImage = src && src.length > 0;
---

<figure class="inline-image" style={`--aspect: ${aspect}`}>
  {hasImage ? (
    <img src={src} alt={alt} loading="lazy" />
  ) : (
    <div class="photo-ph" style={`aspect-ratio: ${aspect}`}>
      <span class="photo-ph__icon">📷</span>
      <span class="photo-ph__label">Photo needed</span>
      <span class="photo-ph__spec">Resolution: <strong>{resolution}</strong> · Aspect {aspect}</span>
      <span class="photo-ph__file">public/blog/rice-harvest-sapa/{filename}</span>
      <span class="photo-ph__direction">{direction}</span>
    </div>
  )}
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .inline-image { margin: 40px 0; }
  .inline-image img {
    width: 100%;
    aspect-ratio: var(--aspect);
    object-fit: cover;
    border-radius: 16px;
    display: block;
  }
  .inline-image figcaption {
    margin-top: 12px;
    font-size: 13px;
    font-style: italic;
    color: var(--color-nordic);
    opacity: 0.65;
    text-align: center;
  }
</style>
