---
interface Props { children?: any; }
---
<blockquote class="pullquote">
  <slot />
</blockquote>

<style>
  .pullquote {
    margin: 56px 0;
    padding: 24px 0 24px 32px;
    border-left: 4px solid var(--color-sorbus);
    font-family: var(--font-heading);
    font-style: italic;
    font-size: clamp(22px, 2.6vw, 32px);
    line-height: 1.35;
    color: var(--color-nordic);
    font-weight: 500;
  }
</style>
