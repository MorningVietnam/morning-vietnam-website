---
// Rain go / no-go infographic for the rainy-season trekking guide.
// Self-contained SVG; colours use brand CSS variables, so it stays on-brand
// and recolours automatically if the design system changes.
const H  = "var(--font-heading, 'Commissioner', sans-serif)";
const B  = "var(--font-body, 'Google Sans', sans-serif)";
const DARK   = "var(--color-nordic, #043341)";
const JAVA   = "var(--color-java, #1da0a0)";
const CAUTION= "var(--color-lucky, #a08f1d)";
const NOGO   = "var(--color-sorbus, #ea6739)";
const MUTED  = "#4a7a8a";
---

<svg viewBox="0 0 820 860" xmlns="http://www.w3.org/2000/svg" role="img"
     aria-label="Rain go / no-go guide for rainy-season trekking in northern Vietnam"
     style="width:100%;height:auto;display:block;">
  <rect x="0" y="0" width="820" height="860" rx="20" fill="#ffffff" stroke="#b8ece8" stroke-width="2"/>

  <text x="40" y="58" font-family={H} font-weight="700" font-size="30" fill={DARK}>Rain go / no-go</text>
  <text x="40" y="90" font-family={B} font-size="17" fill={MUTED}>Trekking the Northwest in the wet season · read the rainfall, not the icon</text>
  <line x1="40" y1="112" x2="780" y2="112" stroke="#b8ece8" stroke-width="2"/>

  <!-- GO -->
  <rect x="40" y="134" width="740" height="180" rx="14" fill="#eafaf8"/>
  <rect x="40" y="134" width="12" height="180" rx="6" fill={JAVA}/>
  <circle cx="92" cy="186" r="22" fill={JAVA}/>
  <path d="M82 186 l7 7 l13 -15" fill="none" stroke="#ffffff" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"/>
  <text x="128" y="180" font-family={H} font-weight="700" font-size="23" fill={JAVA}>GO — with care</text>
  <text x="128" y="212" font-family={H} font-weight="700" font-size="21" fill={DARK}>Light / intermittent rain</text>
  <text x="128" y="244" font-family={B} font-size="17" fill={DARK}>~0.x–2 mm per hour, in short spells, clearing to sun.</text>
  <text x="128" y="270" font-family={B} font-size="16" fill={MUTED}>Usually fine. Trails hold, and the cloud pouring over the peaks is</text>
  <text x="128" y="292" font-family={B} font-size="16" fill={MUTED}>the best part of the season.</text>

  <!-- CAUTION -->
  <rect x="40" y="330" width="740" height="180" rx="14" fill="#f7f2df"/>
  <rect x="40" y="330" width="12" height="180" rx="6" fill={CAUTION}/>
  <circle cx="92" cy="382" r="22" fill={CAUTION}/>
  <text x="92" y="392" text-anchor="middle" font-family={H} font-weight="700" font-size="28" fill="#ffffff">!</text>
  <text x="128" y="376" font-family={H} font-weight="700" font-size="23" fill={CAUTION}>CAUTION — reconsider</text>
  <text x="128" y="408" font-family={H} font-weight="700" font-size="21" fill={DARK}>Rain building up</text>
  <text x="128" y="440" font-family={B} font-size="17" fill={DARK}>50+ mm over the past 3–5 days at your destination.</text>
  <text x="128" y="466" font-family={B} font-size="16" fill={MUTED}>Landslide risk stays high even after it stops. Keep your dates</text>
  <text x="128" y="488" font-family={B} font-size="16" fill={MUTED}>flexible and be ready to postpone.</text>

  <!-- NO-GO -->
  <rect x="40" y="526" width="740" height="180" rx="14" fill="#fdeee7"/>
  <rect x="40" y="526" width="12" height="180" rx="6" fill={NOGO}/>
  <circle cx="92" cy="578" r="22" fill={NOGO}/>
  <rect x="82" y="575" width="20" height="6" rx="3" fill="#ffffff"/>
  <text x="128" y="572" font-family={H} font-weight="700" font-size="23" fill={NOGO}>DON'T GO</text>
  <text x="128" y="604" font-family={H} font-weight="700" font-size="21" fill={DARK}>Heavy rain</text>
  <text x="128" y="636" font-family={B} font-size="17" fill={DARK}>50+ mm in 24h, or 25+ mm in 12h (Vietnam "heavy rain").</text>
  <text x="128" y="662" font-family={B} font-size="16" fill={MUTED}>On steep ground this means local flooding and landslides.</text>
  <text x="128" y="684" font-family={B} font-size="16" fill={MUTED}>Not worth it — wait it out.</text>

  <!-- footer -->
  <rect x="40" y="722" width="740" height="104" rx="14" fill={DARK}/>
  <text x="64" y="758" font-family={H} font-weight="700" font-size="18" fill="#ffffff">Before any wet-season trek</text>
  <text x="64" y="786" font-family={B} font-size="15" fill="#ffffff" opacity="0.92">Check Windy  ·  Read NCHMF warnings  ·  Ask trusted locals</text>
  <text x="64" y="810" font-family={B} font-size="15" fill="#ffffff" opacity="0.92">Stay near major roads  ·  Avoid streams &amp; waterfalls after rain</text>
  <text x="756" y="812" text-anchor="end" font-family={B} font-size="13" fill="#ffffff" opacity="0.6">morningvietnam.co</text>
</svg>
