---
/**
 * Thanh CTA dính đáy màn hình cho trang bài viết blog.
 *
 * Mục đích: bài blog kéo rất dài, người đọc cuộn hết thì CTA ở cuối bài mới xuất
 * hiện. Thanh này giữ một lối dẫn về tour trong suốt lúc đọc.
 *
 * Quy tắc trải nghiệm:
 *  - Chỉ hiện sau khi người đọc đã cuộn qua ~25% bài (đọc thật, không phải vừa vào).
 *  - Có nút đóng; đóng rồi thì phiên đó không hiện lại nữa.
 *  - Không che nội dung trên mobile (thu gọn chữ).
 */
interface Props {
  /** Đường dẫn tour muốn đẩy. Mặc định: trang tổng hợp tour. */
  href?: string;
  /** Câu dẫn bên trái. */
  text?: string;
  /** Chữ trên nút. */
  ctaLabel?: string;
}
const {
  href = '/tours',
  text = 'Planning the trip itself? See the small-group tours we run in the north.',
  ctaLabel = 'Explore tours',
} = Astro.props;
---

<div class="sticky-tour-bar" id="sticky-tour-bar" data-hidden="true" aria-hidden="true">
  <p class="sticky-tour-bar__text">{text}</p>
  <div class="sticky-tour-bar__actions">
    <a class="sticky-tour-bar__cta" href={href}>{ctaLabel} →</a>
    <button
      class="sticky-tour-bar__close"
      type="button"
      aria-label="Dismiss"
      id="sticky-tour-bar-close"
    >×</button>
  </div>
</div>

<style>
  .sticky-tour-bar {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 60;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 20px;
    padding: 14px 20px;
    background: var(--color-nordic);
    color: var(--color-white);
    transform: translateY(100%);
    transition: transform 0.35s ease;
  }
  .sticky-tour-bar[data-hidden='false'] {
    transform: translateY(0);
  }
  .sticky-tour-bar__text {
    margin: 0;
    font-family: var(--font-body);
    font-size: 15px;
    line-height: 1.4;
  }
  .sticky-tour-bar__actions {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
  }
  .sticky-tour-bar__cta {
    display: inline-block;
    padding: 10px 20px;
    border-radius: 999px;
    background: var(--color-sorbus);
    color: var(--color-white);
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 14px;
    letter-spacing: 0.02em;
    text-decoration: none;
    white-space: nowrap;
  }
  .sticky-tour-bar__cta:hover { background: var(--color-accent-dark); }
  .sticky-tour-bar__close {
    background: none;
    border: none;
    color: var(--color-white);
    opacity: 0.6;
    font-size: 22px;
    line-height: 1;
    cursor: pointer;
    padding: 4px 8px;
  }
  .sticky-tour-bar__close:hover { opacity: 1; }

  @media (max-width: 700px) {
    .sticky-tour-bar { gap: 12px; padding: 12px 14px; }
    .sticky-tour-bar__text { font-size: 13px; }
    .sticky-tour-bar__cta { padding: 9px 14px; font-size: 13px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .sticky-tour-bar { transition: none; }
  }
</style>

<script>
  (() => {
    const bar = document.getElementById('sticky-tour-bar');
    const closeBtn = document.getElementById('sticky-tour-bar-close');
    if (!bar || !closeBtn) return;

    const DISMISS_KEY = 'mvn-sticky-tour-bar-dismissed';
    let dismissed = false;
    try { dismissed = sessionStorage.getItem(DISMISS_KEY) === '1'; } catch (e) { /* ignore */ }
    if (dismissed) return;

    const show = (on: boolean) => {
      bar.setAttribute('data-hidden', on ? 'false' : 'true');
      bar.setAttribute('aria-hidden', on ? 'false' : 'true');
    };

    const onScroll = () => {
      const scrolled = window.scrollY;
      const total = document.body.scrollHeight - window.innerHeight;
      if (total <= 0) return;
      show(scrolled / total > 0.25);
    };

    closeBtn.addEventListener('click', () => {
      show(false);
      window.removeEventListener('scroll', onScroll);
      try { sessionStorage.setItem(DISMISS_KEY, '1'); } catch (e) { /* ignore */ }
    });

    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  })();
</script>
