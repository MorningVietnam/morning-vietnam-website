---
interface Props {
  heading: string;
  subheading?: string;
  align?: 'left' | 'center';
  divider?: boolean;
  level?: 1 | 2 | 3;
}

const {
  heading,
  subheading,
  align = 'left',
  divider = false,
  level = 2,
} = Astro.props;

const HeadingTag = `h${level}` as 'h1' | 'h2' | 'h3';
---

<div class:list={['section-header', `section-header--${align}`]}>
  <HeadingTag class="section-header__heading">{heading}</HeadingTag>
  {divider && <div class="section-header__divider" aria-hidden="true" />}
  {subheading && <p class="section-header__sub">{subheading}</p>}
</div>

<style>
  .section-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .section-header--center {
    align-items: center;
    text-align: center;
  }

  .section-header__heading {
    font-family: var(--font-heading);
    font-weight: var(--font-weight-bold);
    font-size: var(--text-h2);
    line-height: var(--leading-h2);
    color: var(--color-nordic);
  }

  /* Decorative pattern divider — three dots in brand teal */
  .section-header__divider {
    width: 48px;
    height: 4px;
    background: repeating-linear-gradient(
      to right,
      var(--color-java) 0px,
      var(--color-java) 12px,
      transparent 12px,
      transparent 18px
    );
    border-radius: 2px;
  }

  .section-header--center .section-header__divider {
    align-self: center;
  }

  .section-header__sub {
    font-family: var(--font-body);
    font-size: var(--text-body-lg);
    line-height: var(--leading-body-lg);
    font-weight: var(--font-weight-regular);
    color: var(--color-text-muted, #4a7a8a);
  }
</style>
