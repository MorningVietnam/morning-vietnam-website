---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogSidebar from '../../components/BlogSidebar.astro';
import { BLOG_CATEGORIES } from '../../data/blog-categories';
import { tours } from '../../data/tours';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map(post => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

const cat = BLOG_CATEGORIES[post.data.category];
const dateStr = post.data.publishedAt.toLocaleDateString('en-US', {
  day: 'numeric', month: 'long', year: 'numeric'
});

const relatedTour = post.data.relatedTourSlug
  ? tours.find(t => t.slug === post.data.relatedTourSlug)
  : null;

const pageUrl = `https://morningvietnam.co/blog/${post.id}`;
---

<BaseLayout
  title={post.data.title}
  description={post.data.excerpt}
  navTheme="on-white"
  ogImage={post.data.coverImage}
  ogType="article"
  publishedAt={post.data.publishedAt}
  author={post.data.author.name}
>
  <article class="blog-post">
    <header class="blog-post__hero">
      <div class="container blog-post__hero-inner">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span>›</span>
          <a href="/blog">Journal</a>
          <span>›</span>
          <a href={`/blog/category/${post.data.category}`}>{cat.label}</a>
        </nav>
        <div class="blog-post__meta">
          <span class="blog-post__cat">{cat.label}</span>
          <span class="blog-post__dot">•</span>
          <time datetime={post.data.publishedAt.toISOString()}>{dateStr}</time>
          <span class="blog-post__dot">•</span>
          <span>{post.data.readTime} min read</span>
        </div>
        <h1 class="blog-post__title">{post.data.title}</h1>
        <p class="blog-post__excerpt">{post.data.excerpt}</p>
      </div>
    </header>

    <div class="blog-post__cover">
      <img src={post.data.coverImage} alt={post.data.title} />
    </div>

    <div class="container blog-post__layout">
      <div class="blog-post__content prose">
        <Content />

        {relatedTour && (
          <aside class="blog-post__related-tour">
            <p class="blog-post__related-label">Mentioned in this post</p>
            <a href={`/tours/${relatedTour.slug}`} class="blog-post__tour-card">
              <img src={relatedTour.image} alt={relatedTour.name} />
              <div>
                <p class="blog-post__tour-name">{relatedTour.name}</p>
                <p class="blog-post__tour-tagline">{relatedTour.tagline}</p>
              </div>
            </a>
          </aside>
        )}
      </div>

      <BlogSidebar
        author={post.data.author}
        headings={headings}
        url={pageUrl}
      />
    </div>
  </article>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": post.data.title,
    "description": post.data.excerpt,
    "image": new URL(post.data.coverImage, Astro.site).toString(),
    "datePublished": post.data.publishedAt.toISOString(),
    "dateModified": (post.data.updatedAt ?? post.data.publishedAt).toISOString(),
    "author": {
      "@type": "Person",
      "name": post.data.author.name
    },
    "publisher": {
      "@type": "Organization",
      "name": "Morning Vietnam",
      "logo": {
        "@type": "ImageObject",
        "url": new URL('/logo/logo-dark.png', Astro.site).toString()
      }
    },
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": Astro.url.href
    }
  })} />
</BaseLayout>

<style>
  .blog-post__hero {
    padding: 120px 0 64px;
    background: white;
    border-bottom: 1px solid rgba(4, 51, 65, 0.08);
  }
  .blog-post__hero-inner { max-width: 760px; }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-nordic);
    opacity: 0.5;
    margin-bottom: 24px;
  }
  .breadcrumb a { color: inherit; text-decoration: none; }
  .breadcrumb a:hover { opacity: 1; color: var(--color-java); }

  .blog-post__meta {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-java);
    margin-bottom: 20px;
  }
  .blog-post__dot { opacity: 0.35; color: var(--color-nordic); }
  .blog-post__meta time,
  .blog-post__meta span:last-child { color: var(--color-nordic); opacity: 0.5; font-weight: 600; }

  .blog-post__title {
    font-family: var(--font-heading);
    font-size: clamp(36px, 5vw, 64px);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--color-nordic);
    margin-bottom: 20px;
  }
  .blog-post__excerpt {
    font-size: 18px;
    line-height: 1.7;
    color: var(--color-nordic);
    opacity: 0.65;
  }

  .blog-post__cover {
    width: 100%;
    max-height: 520px;
    overflow: hidden;
  }
  .blog-post__cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .blog-post__layout {
    display: grid;
    grid-template-columns: 1fr 280px;
    gap: 64px;
    padding-top: 64px;
    padding-bottom: 100px;
    align-items: start;
  }
  @media (max-width: 900px) {
    .blog-post__layout {
      grid-template-columns: 1fr;
    }
  }

  /* ── Prose styles ── */
  .prose :global(h2) {
    font-family: var(--font-heading);
    font-size: clamp(24px, 2.5vw, 32px);
    font-weight: 700;
    color: var(--color-nordic);
    margin: 48px 0 16px;
    line-height: 1.2;
    scroll-margin-top: calc(var(--site-header-h, 100px) + 24px);
  }
  .prose :global(h3) {
    font-family: var(--font-heading);
    font-size: clamp(18px, 2vw, 22px);
    font-weight: 700;
    color: var(--color-nordic);
    margin: 32px 0 12px;
  }
  .prose :global(p) {
    font-size: 17px;
    line-height: 1.8;
    color: var(--color-nordic);
    opacity: 0.85;
    margin-bottom: 20px;
  }
  .prose :global(ul), .prose :global(ol) {
    padding-left: 24px;
    margin-bottom: 20px;
  }
  .prose :global(li) {
    font-size: 16px;
    line-height: 1.7;
    color: var(--color-nordic);
    opacity: 0.85;
    margin-bottom: 8px;
  }
  .prose :global(strong) { color: var(--color-nordic); opacity: 1; }
  .prose :global(a) { color: var(--color-java); text-decoration: underline; }
  .prose :global(a:hover) { color: var(--color-nordic); }
  .prose :global(blockquote) {
    border-left: 3px solid var(--color-java);
    padding: 12px 20px;
    margin: 32px 0;
    background: var(--color-light-cyan);
    border-radius: 0 8px 8px 0;
  }
  .prose :global(blockquote p) { font-style: italic; opacity: 1; margin: 0; }
  .prose :global(hr) {
    border: none;
    border-top: 1px solid rgba(4, 51, 65, 0.1);
    margin: 40px 0;
  }

  /* ── Related tour card ── */
  .blog-post__related-tour {
    margin-top: 48px;
    padding-top: 40px;
    border-top: 1px solid rgba(4, 51, 65, 0.1);
  }
  .blog-post__related-label {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-java);
    margin-bottom: 16px;
  }
  .blog-post__tour-card {
    display: flex;
    gap: 16px;
    padding: 20px;
    background: var(--color-white-nectar);
    border-radius: 16px;
    text-decoration: none;
    color: inherit;
    transition: transform 0.3s ease;
  }
  .blog-post__tour-card:hover { transform: translateY(-3px); }
  .blog-post__tour-card img {
    width: 100px;
    height: 72px;
    object-fit: cover;
    border-radius: 10px;
    flex-shrink: 0;
  }
  .blog-post__tour-name {
    font-weight: 700;
    font-size: 16px;
    color: var(--color-nordic);
  }
  .blog-post__tour-tagline {
    font-size: 13px;
    color: var(--color-nordic);
    opacity: 0.6;
    margin-top: 4px;
    line-height: 1.5;
  }
</style>
