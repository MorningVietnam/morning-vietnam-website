---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogSidebar from '../../components/BlogSidebar.astro';
import BlogCard from '../../components/BlogCard.astro';
import { BLOG_CATEGORIES } from '../../data/blog-categories';
import { tours } from '../../data/tours';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map(post => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

const cat = BLOG_CATEGORIES[post.data.category];
const dateStr = post.data.publishedAt.toLocaleDateString('en-US', {
  day: 'numeric', month: 'long', year: 'numeric'
});

const relatedTour = post.data.relatedTourSlug
  ? tours.find(t => t.slug === post.data.relatedTourSlug)
  : null;

const pageUrl = `https://morningvietnam.co/blog/${post.id}`;

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const morePosts = allPosts
  .filter(p => p.id !== post.id)
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())
  .slice(0, 3);
---

<BaseLayout
  title={post.data.title}
  description={post.data.excerpt}
  navTheme="on-white"
  ogImage={post.data.coverImage}
  ogType="article"
  publishedAt={post.data.publishedAt}
  author={post.data.author.name}
>
  <div class="blog-progress"><div class="blog-progress__fill" id="blog-progress-fill"></div></div>

  <!-- ══ HERO — 2-col split ══ -->
  <section class="blog-detail__hero">
    <div class="container blog-detail__hero-inner">
      <div class="blog-detail__hero-left">
        <div class="blog-detail__meta">
          <span class="blog-detail__cat">{cat.label}</span>
          <span>•</span>
          <span>{dateStr}</span>
        </div>
        <h1 class="blog-detail__title">{post.data.title}</h1>

        <div class="blog-detail__hero-spacer"></div>

        <div class="blog-detail__spec-row">
          <div class="blog-detail__spec-item">
            <span class="blog-detail__spec-label">Date</span>
            <strong class="blog-detail__spec-value">{dateStr}</strong>
          </div>
          <div class="blog-detail__spec-item">
            <span class="blog-detail__spec-label">Tag</span>
            <strong class="blog-detail__spec-value">{post.data.tags[0] || '—'}</strong>
          </div>
          <div class="blog-detail__spec-item">
            <span class="blog-detail__spec-label">Length</span>
            <strong class="blog-detail__spec-value">{post.data.readTime} min read</strong>
          </div>
        </div>
      </div>

      <div class="blog-detail__hero-right">
        <img src={post.data.coverImage} alt={post.data.title} fetchpriority="high" />
      </div>
    </div>
  </section>

  <div class="blog-detail__divider"></div>

  <!-- ══ BODY — sidebar left, article right ══ -->
  <div class="container blog-detail__body-inner">
    <BlogSidebar
      author={post.data.author}
      headings={headings}
      url={pageUrl}
    />

    <article class="blog-detail__article">
      <Content />

      {relatedTour && (
        <aside class="blog-detail__related-tour">
          <p class="blog-detail__related-label">Mentioned in this post</p>
          <a href={`/tours/${relatedTour.slug}`} class="blog-detail__tour-card">
            <img src={relatedTour.image} alt={relatedTour.name} />
            <div>
              <p class="blog-detail__tour-name">{relatedTour.name}</p>
              <p class="blog-detail__tour-tagline">{relatedTour.tagline}</p>
            </div>
          </a>
        </aside>
      )}
    </article>
  </div>

  <!-- ══ MORE POSTS ══ -->
  {morePosts.length > 0 && (
    <section class="blog-detail__more">
      <div class="container">
        <p class="section-label blog-detail__more-eyebrow">✦ Latest stories</p>
        <h2 class="blog-detail__more-heading">More journeys</h2>
        <div class="blog-detail__more-grid">
          {morePosts.map(p => <BlogCard entry={p} />)}
        </div>
      </div>
    </section>
  )}

  <!-- ══ BRAND CTA ══ -->
  <section class="blog-detail__cta">
    <div class="blog-detail__cta-image">
      <img src="/nho-que.jpg" alt="" loading="lazy" />
    </div>
    <div class="blog-detail__cta-overlay"></div>
    <div class="container blog-detail__cta-content">
      <p class="section-label blog-detail__cta-eyebrow">✦ Where stories become trips</p>
      <h2 class="blog-detail__cta-heading">Read it, then live it.</h2>
      <p class="blog-detail__cta-sub">Our tours turn these stories into days you actually walk through — small groups, local hosts, no scripts.</p>
      <a href="/tours" class="btn btn-primary">See our tours →</a>
    </div>
  </section>

  <script>
    const fill = document.getElementById('blog-progress-fill');
    if (fill) {
      window.addEventListener('scroll', () => {
        const h = document.documentElement.scrollHeight - window.innerHeight;
        const pct = (window.scrollY / h) * 100;
        (fill as HTMLElement).style.width = Math.min(100, pct) + '%';
      }, { passive: true });
    }
  </script>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": post.data.title,
    "description": post.data.excerpt,
    "image": new URL(post.data.coverImage, Astro.site).toString(),
    "datePublished": post.data.publishedAt.toISOString(),
    "dateModified": (post.data.updatedAt ?? post.data.publishedAt).toISOString(),
    "author": {
      "@type": "Person",
      "name": post.data.author.name
    },
    "publisher": {
      "@type": "Organization",
      "name": "Morning Vietnam",
      "logo": {
        "@type": "ImageObject",
        "url": new URL('/logo/logo-dark.png', Astro.site).toString()
      }
    },
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": Astro.url.href
    }
  })} />
</BaseLayout>

<style>
  /* ══ HERO ══ */
  .blog-detail__hero {
    padding: calc(var(--site-header-h) + 56px) 0 72px;
    background: white;
  }
  .blog-detail__hero-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: stretch;
    min-height: 480px;
  }
  .blog-detail__hero-left {
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    padding: 0;
  }
  .blog-detail__meta {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-java);
    margin-bottom: 24px;
  }
  .blog-detail__meta > span:nth-child(2) {
    color: var(--color-sorbus);
    font-size: 14px;
  }
  .blog-detail__title {
    font-family: var(--font-heading);
    font-size: clamp(40px, 5.5vw, 72px);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.025em;
    color: var(--color-nordic);
  }
  .blog-detail__hero-spacer {
    flex: 1;
    min-height: 60px;
  }
  .blog-detail__spec-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
  }
  .blog-detail__spec-item {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .blog-detail__spec-label {
    font-size: 13px;
    color: var(--color-nordic);
    opacity: 0.55;
  }
  .blog-detail__spec-value {
    font-size: 15px;
    font-weight: 700;
    color: var(--color-nordic);
  }
  .blog-detail__hero-right {
    display: flex;
    align-items: stretch;
  }
  .blog-detail__hero-right img {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: 24px;
  }

  /* Divider */
  .blog-detail__divider {
    max-width: var(--max-width, 1280px);
    margin: 0 auto;
    padding: 0 48px;
  }
  .blog-detail__divider::after {
    content: '';
    display: block;
    height: 1px;
    background: rgba(4, 51, 65, 0.1);
  }

  /* ══ BODY ══ */
  .blog-detail__body-inner {
    display: grid;
    grid-template-columns: 320px 1fr;
    gap: 60px;
    align-items: start;
    padding-top: 64px;
    padding-bottom: 100px;
  }

  /* ══ PROGRESS BAR ══ */
  .blog-progress {
    position: fixed;
    top: var(--site-header-h, 100px);
    left: 0; right: 0;
    height: 2px;
    background: transparent;
    z-index: 100;
    pointer-events: none;
  }
  .blog-progress__fill {
    height: 100%;
    width: 0%;
    background: var(--color-java);
    transition: width 0.1s linear;
  }

  /* ══ ARTICLE PROSE ══ */
  .blog-detail__article {
    counter-reset: h2-counter;
  }
  .blog-detail__article :global(h2) {
    font-family: var(--font-heading);
    font-size: clamp(24px, 2.5vw, 32px);
    font-weight: 700;
    color: var(--color-nordic);
    margin: 56px 0 20px;
    line-height: 1.2;
    scroll-margin-top: calc(var(--site-header-h, 100px) + 24px);
    position: relative;
    counter-increment: h2-counter;
  }
  .blog-detail__article :global(h2)::before {
    content: counter(h2-counter, upper-roman) ".";
    display: block;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.2em;
    color: var(--color-sorbus);
    opacity: 0.6;
    margin-bottom: 8px;
  }
  .blog-detail__article :global(h3) {
    font-family: var(--font-heading);
    font-size: clamp(18px, 2vw, 22px);
    font-weight: 700;
    color: var(--color-nordic);
    margin: 32px 0 12px;
  }
  .blog-detail__article :global(p) {
    font-size: 17px;
    line-height: 1.8;
    color: var(--color-nordic);
    opacity: 0.85;
    margin-bottom: 20px;
  }
  .blog-detail__article :global(ul),
  .blog-detail__article :global(ol) {
    padding-left: 24px;
    margin-bottom: 20px;
  }
  .blog-detail__article :global(li) {
    font-size: 16px;
    line-height: 1.7;
    color: var(--color-nordic);
    opacity: 0.85;
    margin-bottom: 8px;
  }
  .blog-detail__article :global(strong) { color: var(--color-nordic); opacity: 1; }
  .blog-detail__article :global(a) { color: var(--color-java); text-decoration: underline; }
  .blog-detail__article :global(a:hover) { color: var(--color-nordic); }
  .blog-detail__article :global(blockquote) {
    border-left: 3px solid var(--color-java);
    padding: 12px 20px;
    margin: 32px 0;
    background: var(--color-light-cyan);
    border-radius: 0 8px 8px 0;
  }
  .blog-detail__article :global(blockquote p) { font-style: italic; opacity: 1; margin: 0; }
  .blog-detail__article :global(hr) {
    border: none;
    border-top: 1px solid rgba(4, 51, 65, 0.1);
    margin: 40px 0;
  }
  .blog-detail__article :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 24px;
    font-size: 14px;
  }
  .blog-detail__article :global(th),
  .blog-detail__article :global(td) {
    text-align: left;
    padding: 10px 14px;
    border-bottom: 1px solid rgba(4, 51, 65, 0.1);
    color: var(--color-nordic);
    opacity: 0.85;
  }
  .blog-detail__article :global(th) {
    font-weight: 700;
    opacity: 1;
    background: var(--color-white-nectar);
  }

  /* ══ RELATED TOUR ══ */
  .blog-detail__related-tour {
    margin-top: 48px;
    padding-top: 40px;
    border-top: 1px solid rgba(4, 51, 65, 0.1);
  }
  .blog-detail__related-label {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-java);
    margin-bottom: 16px;
  }
  .blog-detail__tour-card {
    display: flex;
    gap: 16px;
    padding: 20px;
    background: var(--color-white-nectar);
    border-radius: 16px;
    text-decoration: none;
    color: inherit;
    transition: transform 0.3s ease;
  }
  .blog-detail__tour-card:hover { transform: translateY(-3px); }
  .blog-detail__tour-card img {
    width: 100px;
    height: 72px;
    object-fit: cover;
    border-radius: 10px;
    flex-shrink: 0;
  }
  .blog-detail__tour-name {
    font-weight: 700;
    font-size: 16px;
    color: var(--color-nordic);
  }
  .blog-detail__tour-tagline {
    font-size: 13px;
    color: var(--color-nordic);
    opacity: 0.6;
    margin-top: 4px;
    line-height: 1.5;
  }

  /* ══ MORE POSTS ══ */
  .blog-detail__more {
    padding: 100px 0 120px;
    background: var(--color-white-nectar);
    text-align: center;
  }
  .blog-detail__more-eyebrow {
    display: inline-block;
    color: var(--color-java);
    margin-bottom: 16px;
  }
  .blog-detail__more-heading {
    font-family: var(--font-heading);
    font-size: clamp(48px, 7vw, 88px);
    font-weight: 700;
    color: var(--color-nordic);
    line-height: 1.0;
    letter-spacing: -0.025em;
    margin-bottom: 56px;
  }
  .blog-detail__more-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    text-align: left;
  }

  /* ══ CTA ══ */
  .blog-detail__cta {
    position: relative;
    min-height: 70vh;
    overflow: hidden;
    display: flex;
    align-items: center;
  }
  .blog-detail__cta-image {
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  .blog-detail__cta-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .blog-detail__cta-overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
    background: linear-gradient(to right, rgba(4,51,65,0.85) 0%, rgba(4,51,65,0.45) 70%, transparent 100%);
  }
  .blog-detail__cta-content {
    position: relative;
    z-index: 3;
    max-width: 640px;
    padding: 80px 0;
    color: white;
  }
  .blog-detail__cta-eyebrow { color: var(--color-riptide); margin-bottom: 16px; }
  .blog-detail__cta-heading {
    font-family: var(--font-heading);
    font-size: clamp(48px, 7vw, 88px);
    font-weight: 700;
    line-height: 0.95;
    letter-spacing: -0.025em;
    margin-bottom: 24px;
  }
  .blog-detail__cta-sub {
    font-size: 18px;
    line-height: 1.6;
    opacity: 0.85;
    margin-bottom: 36px;
  }

  /* ══ RESPONSIVE ══ */
  @media (max-width: 900px) {
    .blog-detail__hero-inner {
      grid-template-columns: 1fr;
      gap: 32px;
      min-height: auto;
    }
    .blog-detail__hero-right img { aspect-ratio: 4/3; }
    .blog-detail__spec-row { grid-template-columns: 1fr; gap: 20px; }
    .blog-detail__body-inner {
      grid-template-columns: 1fr;
    }
    .blog-detail__more-grid { grid-template-columns: 1fr; }
    .blog-detail__cta-overlay {
      background: rgba(4, 51, 65, 0.72);
    }
  }
  @media (max-width: 600px) {
    .blog-detail__divider { padding: 0 16px; }
  }
</style>
