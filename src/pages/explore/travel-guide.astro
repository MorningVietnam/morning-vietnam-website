  { name: 'The Vietage — Da Nang to Quy Nhơn', note: "Vietnam's first luxury train: 12-seat carriages, gourmet dining, bar and massage. A journey turned into an unforgettable experience." },
  { name: 'Da Lat – Trại Mát Heritage Railway', note: "7km remnant of the old Da Lat – Thap Cham cog railway. A short (well under 1 hour) but scenic ride through flower farms and pine forest to a hillside pagoda." },
