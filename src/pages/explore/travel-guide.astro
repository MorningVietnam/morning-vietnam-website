---
import BaseLayout from '../../layouts/BaseLayout.astro';

// ═══════════════════════════════════════════════════════════════════════════
// Nội dung Travel Guide — chuyển từ "MNV - Travel Guide Book" (Canva) sang
// trang web thật để Google/AI search đọc được và link bấm được trực tiếp.
//
// Bản cập nhật 2026-08 — theo bản Canva 30 trang mới (thay bản 28 trang cũ).
// Toàn bộ nội dung dưới đây transcribe trực tiếp từ ảnh export mới (OCR +
// đọc ảnh tay, không đoán mò). So với bản cũ:
//   - Money: thêm hẳn phần FAQ (thẻ tín dụng, tiền mặt, phí ATM, phí giao dịch).
//   - SIM: thêm đủ 6 kênh mua (bản cũ chỉ có 3).
//   - Getting Around: thêm "Arriving by air" + chi tiết bus sân bay Hà Nội.
//   - Transport: thêm Heritage & Experience Trains, Limousine/Sleeper/Local Bus.
//     Bỏ hẳn link Vexere (không còn trong bản Canva mới).
//   - Food & Drink: thêm mới hoàn toàn (North/Central/South, tên món ăn).
//   - Destinations: viết lại theo đúng 3 nhóm + mục Trekking riêng của Canva
//     (trước đây gộp lẫn 1 danh sách, thiếu Hoàng Su Phì/Côn Đảo do lỗi nguồn —
//     bản Canva mới đã sửa xong 2 lỗi đó). Bỏ "Đồng Văn Karst Plateau" —
//     không có trong bản Canva mới.
// ═══════════════════════════════════════════════════════════════════════════

// Link thật — đã xác nhận với Thế Anh 2026-08-09
