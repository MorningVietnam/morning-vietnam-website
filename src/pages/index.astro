<script>
  // ── Crew tooltip ───────────────────────────────────────────────
  document.querySelectorAll<HTMLElement>('.hp-crew__avatar').forEach(avatar => {
    avatar.addEventListener('click', () => {
      const tip = avatar.querySelector<HTMLElement>('.hp-crew__tooltip');
      if (!tip) return;
      tip.classList.add('is-visible');
      setTimeout(() => tip.classList.remove('is-visible'), 1500);
    });
  });

  // ── Hero brand parallax ────────────────────────────────────────
  const brandText = document.getElementById('hp-brand-text') as HTMLElement | null;
  if (brandText && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    window.addEventListener('scroll', () => {
      const y = window.scrollY * -0.4;
      brandText.style.transform = `translateY(${y}px)`;
    }, { passive: true });
  }

  // ── Showcase 2-col slider ──────────────────────────────────────
  const showcase = document.querySelector('.hp-showcase2') as HTMLElement | null;
  const showcaseDataEl = document.getElementById('showcase-data');
  if (showcase && showcaseDataEl) {
    const data = JSON.parse(showcaseDataEl.textContent ?? '[]');
    const dots = document.querySelectorAll<HTMLButtonElement>('.hp-showcase2__dot');
    const nextBtn = document.getElementById('showcase-next');

    const els = {
      heading:  document.getElementById('showcase-heading'),
      image:    document.getElementById('showcase-image') as HTMLImageElement | null,
      current:  document.getElementById('showcase-current'),
      desc:     document.getElementById('showcase-desc'),
      duration: document.getElementById('showcase-duration'),
      lang:     document.getElementById('showcase-lang'),
      link:     document.getElementById('showcase-link') as HTMLAnchorElement | null,
    };

    let idx = 0;
    let timer: ReturnType<typeof setInterval>;

    function update(newIdx: number) {
      if (newIdx === idx) return;
      showcase!.classList.add('fading');
      setTimeout(() => {
        idx = ((newIdx % data.length) + data.length) % data.length;
        const t = data[idx];
        if (els.heading)  els.heading.textContent  = t.name;
        if (els.image)  { els.image.src = t.image; els.image.alt = t.name; }
        if (els.current)  els.current.textContent  = String(idx + 1).padStart(2, '0');
        if (els.desc)     els.desc.textContent      = (t.description ?? t.tagline);
        if (els.duration) els.duration.textContent  = t.duration.join(' / ');
        if (els.lang)     els.lang.textContent      = t.languages.join(' · ');
        if (els.link)     els.link.href             = `/tours/${t.slug}`;
        dots.forEach((d, i) => d.classList.toggle('active', i === idx));
        showcase!.classList.remove('fading');
      }, 400);
    }

    dots.forEach(d => d.addEventListener('click', () => {
      clearInterval(timer);
      update(parseInt(d.dataset.idx ?? '0'));
      startTimer();
    }));

    nextBtn?.addEventListener('click', () => {
      clearInterval(timer);
      update(idx + 1);
      startTimer();
    });

    function startTimer() {
      clearInterval(timer);
      timer = setInterval(() => update(idx + 1), 5000);
    }

    showcase.addEventListener('mouseenter', () => clearInterval(timer));
    showcase.addEventListener('mouseleave', startTimer);
    startTimer();
  }

  // ── Testimonials sticky stack: rise+fade in on approach, then shrink the
  //    longer a card stays pinned — cloned from Tanigro's "How It Works"
  //    scroll interaction (tanigro.webflow.io), values measured live on
  //    the source site via getComputedStyle: each pinned card shrinks to
  //    scale(0.6) (not just a subtle nudge) over roughly 1.25x its own
  //    height of continued scroll, and — importantly — this happens to
  //    EVERY card including the last one, driven by how long that card
  //    itself has been pinned, not by whether a next card is covering it.
  //    Desktop-only + gated to while the section is near the viewport.
  const testiStackEl = document.querySelector<HTMLElement>('.testi-stack');
  const testiCards = document.querySelectorAll<HTMLElement>('.testi-card');
  if (testiStackEl && testiCards.length) {
    const desktopQuery = window.matchMedia('(min-width: 769px)');
    let testiRaf: number | null = null;
    let testiInView = false;
    const testiPinStartY: Array<number | null> = new Array(testiCards.length).fill(null);
    // The translateY WE applied last frame — getBoundingClientRect() reports
    // the post-transform box, so without subtracting this back out, our own
    // downward drift would read as "no longer pinned" the next frame (a
    // feedback loop that froze shrinkProgress near 0). Track it so every
    // position read below uses the untransformed "true" layout position.
    const testiLastTranslateY: number[] = new Array(testiCards.length).fill(0);

    function resetTesti() {
      testiCards.forEach((card) => { card.style.transform = ''; card.style.opacity = ''; });
      testiPinStartY.fill(null);
      testiLastTranslateY.fill(0);
    }

    function tickTesti() {
      const stickyTop = parseFloat(getComputedStyle(testiCards[0]).top) || 0;
      const vh = window.innerHeight;
      const scrollY = window.scrollY;

      testiCards.forEach((card, i) => {
        const rect = card.getBoundingClientRect();
        const trueTop = rect.top - testiLastTranslateY[i];

        // Rise + fade in as the card approaches from below the fold.
        let enter = (vh - trueTop) / (vh * 0.35);
        enter = Math.min(1, Math.max(0, enter));

        // Shrink based on how long THIS card has been pinned (own scroll
        // distance since it first stuck) — not on a next-sibling covering
        // it, so the last card shrinks the same way once you scroll past it.
        const isPinned = trueTop <= stickyTop + 1;
        if (isPinned) {
          if (testiPinStartY[i] === null) testiPinStartY[i] = scrollY;
        } else {
          testiPinStartY[i] = null;
        }
        let shrinkProgress = 0;
        const pinStart = testiPinStartY[i];
        if (pinStart !== null) {
          const naturalHeight = card.offsetHeight; // unaffected by our own transform
          const shrinkDistance = naturalHeight * 1.25;
          shrinkProgress = (scrollY - pinStart) / shrinkDistance;
          shrinkProgress = Math.min(1, Math.max(0, shrinkProgress));
        }

        const scale = (0.96 + enter * 0.04) * (1 - shrinkProgress * 0.4);
        // Once a card starts being covered, ease it down toward the
        // 1/3-viewport mark as it shrinks — the incoming/active card still
        // pins flush under the header (that's the `top` in the CSS).
        const restY = Math.max(0, vh / 3 - stickyTop);
        const translateY = (1 - enter) * 40 + shrinkProgress * restY;
        card.style.transform = `translateY(${translateY}px) scale(${scale})`;
        card.style.opacity = String(enter);
        testiLastTranslateY[i] = translateY;
      });

      testiRaf = (testiInView && desktopQuery.matches) ? requestAnimationFrame(tickTesti) : null;
    }

    function maybeStartTesti() {
      if (testiRaf === null && testiInView && desktopQuery.matches) {
        testiRaf = requestAnimationFrame(tickTesti);
      } else if (!(testiInView && desktopQuery.matches)) {
        if (testiRaf !== null) { cancelAnimationFrame(testiRaf); testiRaf = null; }
        resetTesti();
      }
    }

    const testiSectionObserver = new IntersectionObserver(
      ([entry]) => { testiInView = entry.isIntersecting; maybeStartTesti(); },
      { rootMargin: '200px 0px 200px 0px' }
    );
    testiSectionObserver.observe(testiStackEl);
    desktopQuery.addEventListener('change', maybeStartTesti);
  }

  // ── The country: sticky photo + horizontally-scrolling card track,
  //    cloned from Tanigro's real GSAP mechanism — confirmed by reading
  //    their own ScrollTrigger.getAll() output on the live site rather
  //    than guessing from a screenshot: x: 0% → -100%, ease: "none",
  //    scrub tied straight to scroll, pinned via a runway taller than
  //    the sticky content. Reimplemented in plain JS/rAF (no GSAP — this
  //    project is Astro + TS only), reusing the same
  //    IntersectionObserver-gated + matchMedia-gated rAF loop pattern as
  //    the testimonial stack above, just driving translateX on the
  //    track instead of translateY/scale on each card. Desktop-only: on
  //    mobile the runway/window/track collapse to a normal stacked
  //    column (see .hp-explore media query) and this script no-ops.
  const exploreRunwayEl = document.getElementById('explore-runway');
  const exploreWindowEl = document.getElementById('explore-window');
  const exploreTrackEl  = document.getElementById('explore-track');
  const exploreStickyEl = exploreRunwayEl?.querySelector<HTMLElement>('.hp-explore__sticky') ?? null;

  if (exploreRunwayEl && exploreWindowEl && exploreTrackEl && exploreStickyEl) {
    const exploreDesktopQuery = window.matchMedia('(min-width: 769px)');
    let exploreRaf: number | null = null;
    let exploreInView = false;

    // Matches the `gap: 16px` set on .hp-explore__track in CSS — kept in
    // sync here because JS needs the number in px to size the "2 cards
    // per window" card width, not just referenced as a CSS token.
    const EXPLORE_GAP = 16;

    // Window width → card width, sized so 2 cards fill the window at
    // once (with the 3rd starting to peek in as the 1st scrolls out) —
    // written onto --explore-card-w, which .hp-explore__card reads via
    // var(--explore-card-w, 420px) and inherits down from the track.
    function measureExploreCards() {
      const windowWidth = exploreWindowEl!.clientWidth;
      if (windowWidth <= 0) return;
      const cardW = Math.max(240, (windowWidth - EXPLORE_GAP) / 2);
      exploreTrackEl!.style.setProperty('--explore-card-w', `${cardW}px`);
    }

    function tickExplore() {
      if (!exploreDesktopQuery.matches) {
        exploreTrackEl!.style.transform = '';
        exploreRaf = null;
        return;
      }

      // Standard sticky-runway progress: the sticky block pins once the
      // runway's top scrolls up to meet `top: <stickyTop>`, and stays
      // pinned until the runway runs out of extra height below it —
      // i.e. over exactly (runway height − sticky height) of scrolling.
      const runwayRect = exploreRunwayEl!.getBoundingClientRect();
      const stickyTop = parseFloat(getComputedStyle(exploreStickyEl!).top) || 0;
      const scrollDistance = exploreRunwayEl!.offsetHeight - exploreStickyEl!.offsetHeight;

      let progress = 0;
      if (scrollDistance > 0) {
        progress = (stickyTop - runwayRect.top) / scrollDistance;
      }
      progress = Math.min(1, Math.max(0, progress));

      // scrollWidth/clientWidth are layout metrics, unaffected by the
      // transform we apply below — no feedback loop reading these back.
      const maxScroll = Math.max(0, exploreTrackEl!.scrollWidth - exploreWindowEl!.clientWidth);
      exploreTrackEl!.style.transform = `translateX(${-progress * maxScroll}px)`;

      exploreRaf = (exploreInView && exploreDesktopQuery.matches) ? requestAnimationFrame(tickExplore) : null;
    }

    function maybeStartExplore() {
      if (exploreRaf === null && exploreInView && exploreDesktopQuery.matches) {
        exploreRaf = requestAnimationFrame(tickExplore);
      } else if (!(exploreInView && exploreDesktopQuery.matches)) {
        if (exploreRaf !== null) { cancelAnimationFrame(exploreRaf); exploreRaf = null; }
        exploreTrackEl!.style.transform = '';
      }
    }

    measureExploreCards();
    window.addEventListener('resize', measureExploreCards);
    exploreDesktopQuery.addEventListener('change', () => { measureExploreCards(); maybeStartExplore(); });

    const exploreSectionObserver = new IntersectionObserver(
      ([entry]) => { exploreInView = entry.isIntersecting; maybeStartExplore(); },
      { rootMargin: '200px 0px 200px 0px' }
    );
    exploreSectionObserver.observe(exploreRunwayEl);
  }</script>
