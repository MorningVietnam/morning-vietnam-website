  /* Persistent caption explaining the compass control — it looks like a
     plain button but actually needs a press-and-drag, which people don't
     discover on their own. Only shown while the 3D view is active (toggled
     in JS alongside #td-gpx-map-3d's own visibility). */
  .td-routemap__rotatehint {
    display: none;
    position: absolute;
    top: 118px;
    right: 10px;
