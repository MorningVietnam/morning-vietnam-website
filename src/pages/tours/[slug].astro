  }

  .td-unlock__note p {
    font-size: 14px;
    line-height: 1.65;
    color: rgba(217,247,245,0.7);
    font-style: italic;
  }

  .td-unlock__teaser {
    font-family: var(--font-heading);
    font-size: 16px;
    font-weight: 600;
    color: rgba(217,247,245,0.45);
    letter-spacing: 0.02em;
  }

  @media (max-width: 900px) {
    .td-unlock__cards { grid-template-columns: 1fr; }
  }

  @media (max-width: 768px) {
    .td-unlock        { padding: 40px 0; }
    .td-unlock__inner { padding: 0 24px; }
  }

  /* ── S9 td-season ───────────────────────────────── */
  .td-season {
    background: var(--color-light-cyan);
    padding: 60px 0;
  }

  .td-season__inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 48px;
  }

  .td-season__heading {
    font-family: var(--font-heading);
    font-size: clamp(36px, 5vw, 64px);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--color-nordic);
    margin: 12px 0 16px;
  }

  .td-season__intro {
    font-size: 16px;
    line-height: 1.7;
    color: var(--color-nordic);
    opacity: 0.75;
    margin-bottom: 40px;
  }

  .td-season__bar {
