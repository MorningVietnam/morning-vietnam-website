              {day.stats && (
                <div class="td-timeline__act-stats">
                  <span><i class="ti ti-clock" aria-hidden="true"></i>{day.stats.hours}</span>
                  <span><i class="ti ti-route" aria-hidden="true"></i>{day.stats.distanceKm}km</span>
                  {day.stats.up != null && <span><i class="ti ti-trending-up" aria-hidden="true"></i>{day.stats.up}m up</span>}
                  {day.stats.down != null && <span><i class="ti ti-trending-down" aria-hidden="true"></i>{day.stats.down}m down</span>}
                </div>
              )}
              {day.narrative && <p class="td-timeline__act-desc">{day.narrative}</p>}
            </div>
          ))}
        </div>
      ) : activityCards && activityCards.length > 0 && (
        <div class="td-timeline__cards">
          {activityCards.map((c: any) => (
            <div
              class={`td-timeline__act-card${c.highlight ? ' is-highlight' : ''}${c.durationOnly === '1day' ? ' is-1day-only' : ''}${c.durationOnly === '2d1n' ? ' is-2d1n-only' : ''}${c.durationOnly === '3d2n' ? ' is-3d2n-only' : ''}`}
              data-duration={c.durationOnly || 'all'}
            >
              <div class="td-timeline__act-badges">
                {c.day != null && <span class="td-timeline__act-badge td-timeline__act-badge--day">Day {c.day}</span>}
                {(c.badges || (c.badgeLabel ? [c.badgeLabel] : [])).map((b: string) => (
                  <span class={`td-timeline__act-badge td-timeline__act-badge--${b.toLowerCase()}`}>{b}</span>
                ))}
              </div>
              <div class={`td-timeline__act-time${c.highlight ? ' is-highlight' : ''}`}>{c.time}</div>
              <div class="td-timeline__act-title">{c.title}</div>
              <p class="td-timeline__act-desc">{c.desc}</p>
            </div>
          ))}
        </div>
      )}
    </div>
  </section>

  <!-- ═══ S-pan · panoramic image break ══════════════════════════ -->
  <div class="td-panoramic">
