  .td-product__cta        { display: flex; flex-direction: column; gap: 8px; margin-top: 4px; }

  .td-product__book       { align-self: flex-start; padding: 16px 32px; font-size: 15px; }

  .td-product__cta-note   { font-size: 12px; opacity: 0.55; color: var(--color-nordic); line-height: 1.5; }

  /* ── Duration show/hide ─────────────────────────── */
  /* Dùng :global() để bypass Astro scoped CSS */

  /* Mặc định ẩn 2D1N elements, hiện 1day elements */
  :global(.is-2d1n-only) {
    display: none !important;
  }
  :global(g.is-2d1n-only) {
    display: unset !important;
    visibility: hidden;
    pointer-events: none;
  }

  /* is-1day-only: visible by default, hidden in 2d1n and 3d2n modes */
  :global(g.is-1day-only) {
    display: unset !important;
    visibility: visible;
    pointer-events: auto;
  }
  :global(body.dur-2d1n .is-1day-only) { display: none !important; }
  :global(body.dur-2d1n g.is-1day-only) { visibility: hidden; pointer-events: none; }
  :global(body.dur-3d2n .is-1day-only) { display: none !important; }
  :global(body.dur-3d2n g.is-1day-only) { visibility: hidden; pointer-events: none; }

  /* is-3d2n-only: hidden by default, shown in 3d2n mode */
  :global(.is-3d2n-only) { display: none !important; }
  :global(g.is-3d2n-only) { display: unset !important; visibility: hidden; pointer-events: none; }
  :global(body.dur-3d2n .is-3d2n-only) { display: block !important; }
  :global(body.dur-3d2n g.is-3d2n-only) { display: unset !important; visibility: visible; pointer-events: auto; }
  :global(body.dur-3d2n .is-2d1n-only) { display: none !important; }
  :global(body.dur-3d2n g.is-2d1n-only) { visibility: hidden; pointer-events: none; }

  /* SVG paths: 1day visible by default, 2d1n + 3d2n hidden */
  :global(.svg-path-2d1n) { display: none; }
  :global(.svg-path-3d2n) { display: none; }
  :global(.svg-path-1day) { display: unset; }
  :global(body.dur-2d1n .svg-path-1day) { display: none; }
  :global(body.dur-2d1n .svg-path-2d1n) { display: unset; }
  :global(body.dur-3d2n .svg-path-1day) { display: none; }
  :global(body.dur-3d2n .svg-path-2d1n) { display: none; }
  :global(body.dur-3d2n .svg-path-3d2n) { display: unset; }

  /* Khi body.dur-2d1n → hiện 2D1N, ẩn 1day */
  :global(body.dur-2d1n .is-2d1n-only) {
    display: block !important;
  }
  :global(body.dur-2d1n g.is-2d1n-only) {
    display: unset !important;
    visibility: visible;
    pointer-events: auto;
  }

  /* ── Pickup + vehicle selector ──────────────────── */
  /*
   * Both selects must be the same width = the wider of the two.
   * Strategy: constrain .td-selector to fit-content so it shrinks
   * to its content, then stretch each child .td-selector__q to 100%
   * of that container. The browser automatically uses the widest
   * <select> as the reference, so both rows are equal width.
   */
  .td-selector {
    display: inline-flex;      /* shrink-wraps to widest child */
    flex-direction: column;
    gap: 14px;
    width: fit-content;        /* don't stretch across full panel */
    max-width: 100%;           /* never overflow the panel on small screens */
  }

  .td-selector__q {
    display: flex;
    flex-direction: column;
    gap: 6px;
    width: 100%;               /* fills .td-selector's shrunk width */
  }

  .td-selector__label {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-nordic);
    opacity: 0.55;
  }

  .td-selector__wrap {
    position: relative;
    width: 100%;
  }

  .td-selector__select {
    appearance: none;
    -webkit-appearance: none;
    background: var(--color-white, #fff);
    border: 1.5px solid rgba(4, 51, 65, 0.18);
    border-radius: 10px;
    padding: 11px 44px 11px 16px;  /* extra right room for arrow */
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 600;
    color: var(--color-nordic);
    cursor: pointer;
    transition: border-color 0.18s ease, box-shadow 0.18s ease;
    width: 100%;               /* fill the .td-selector__wrap = same for both */
    min-width: 0;
  }

  .td-selector__select:focus {
    outline: none;
    border-color: var(--color-java);
    box-shadow: 0 0 0 3px rgba(29, 160, 160, 0.15);
  }

  .td-selector__arrow {
    position: absolute;
    right: 14px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--color-java);
    pointer-events: none;
  }

  /* ── Duration tabs (1 Day / 2D1N / 3D2N) ─────────── */
  .td-dur-tabs {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .td-dur-tab {
    padding: 9px 18px;
    border-radius: 999px;
    border: 1.5px solid rgba(4, 51, 65, 0.18);
    background: transparent;
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 600;
    color: var(--color-nordic);
    cursor: pointer;
    transition: border-color 0.18s ease, background 0.18s ease, color 0.18s ease;
    white-space: nowrap;
  }

  .td-dur-tab:hover {
    border-color: var(--color-java);
    color: var(--color-java);
  }

  .td-dur-tab.is-active {
    background: var(--color-java);
    border-color: var(--color-java);
    color: #fff;
  }

  /* ── Trip Info cards ─────────────────────────────── */
  .td-tripinfo {
    margin-top: 4px;
    border-top: 1px solid rgba(4, 51, 65, 0.12);
    padding-top: 20px;
  }

  .td-tripinfo__section-label {
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted, #aaa);
    margin: 0 0 16px 0;
  }

  .td-tripinfo__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }

  /* :global because these are rebuilt via innerHTML on tab switch */
  :global(.td-tripinfo__card) {
    display: flex;
    align-items: flex-start;
    gap: 12px;
  }

  :global(.td-tripinfo__icon-wrap) {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: #ffffff;
    border: 1px solid #d8d8d8;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  :global(.td-tripinfo__icon-wrap i) {
    font-size: 20px;
    color: var(--color-nordic, #043341);
  }

  :global(.td-tripinfo__label) {
    font-size: 13px;
    font-weight: 700;
    color: var(--color-nordic, #043341);
    margin: 0 0 2px 0;
    line-height: 1.3;
  }

  :global(.td-tripinfo__value) {
    font-size: 13px;
    font-weight: 400;
    color: #888780;
    margin: 0;
    line-height: 1.4;
    white-space: pre-line;
  }

  /* ── td-upcoming (compact dates strip in hero) ──── */
  .td-upcoming {
    margin-bottom: 20px;
    padding: 14px 16px;
    background: rgba(4, 51, 65, 0.05);
    border-radius: 12px;
    border-left: 3px solid var(--color-sorbus);
  }

  .td-upcoming__label {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-nordic);
