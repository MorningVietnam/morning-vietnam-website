  .td-season__legend {
    display: flex;
    gap: 28px;
    font-size: 13px;
    color: var(--color-nordic);
    margin-bottom: 40px;
    flex-wrap: wrap;
  }

  .td-season__dot {
    width: 12px;
    height: 12px;
    border-radius: 3px;
    display: inline-block;
    margin-right: 8px;
    vertical-align: middle;
  }

  .td-season__dot--best { background: var(--color-java); }
  .td-season__dot--good { background: var(--color-riptide); }
  .td-season__dot--wet  { background: rgba(4,51,65,0.25); }

  .td-season__notes {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }

  .td-season__note {
    background: white;
    border-radius: 12px;
    padding: 20px 24px;
    border-left: 4px solid var(--color-java);
  }

  .td-season__note--wet { border-left-color: #4a90d9; }

  .td-season__note h4 {
    font-family: var(--font-heading);
    font-size: 15px;
    font-weight: 700;
    color: var(--color-nordic);
    margin-bottom: 8px;
  }

  .td-season__note p {
    font-size: 13px;
    line-height: 1.65;
    color: var(--color-nordic);
    opacity: 0.75;
  }

  @media (max-width: 960px) {
    .td-season__inner { padding: 0 24px; }
    .td-season__bar   { grid-template-columns: repeat(6, 1fr); }
    .td-season__notes { grid-template-columns: 1fr; }
    .td-season        { padding: 40px 0; }
  }

  /* ── S7 td-reviews ──────────────────────────────── */
  .td-reviews { display: none; }

  .td-reviews__inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 48px;
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    gap: 64px;
  }

  .td-reviews__rating {
    font-family: var(--font-heading);
    font-size: clamp(72px, 9vw, 128px);
    font-weight: 700;
    color: var(--color-nordic);
    line-height: 1;
    margin: 16px 0 8px;
  }

  .td-reviews__rating-unit { font-size: 0.4em; opacity: 0.4; font-weight: 400; }
  .td-reviews__based { font-size: 14px; color: var(--color-nordic); opacity: 0.6; margin-bottom: 32px; }

  .td-reviews__breakdown { display: flex; flex-direction: column; gap: 8px; }

  .td-reviews__row {
    display: grid;
    grid-template-columns: 32px 1fr 32px;
    gap: 12px;
    align-items: center;
    font-size: 13px;
    color: var(--color-nordic);
  }

  .td-reviews__bar { height: 6px; background: var(--color-light-cyan); border-radius: 3px; overflow: hidden; }
  .td-reviews__bar-fill { height: 100%; background: var(--color-java); }

  .td-reviews__placeholder-note {
    margin-top: 24px;
    font-size: 12px;
    color: var(--color-sorbus);
    opacity: 0.7;
    font-style: italic;
  }

  .td-reviews__right { display: flex; flex-direction: column; gap: 32px; }

  .td-review {
    border-bottom: 1px solid rgba(4,51,65,0.1);
    padding-bottom: 32px;
  }

  .td-review:last-child { border-bottom: none; }
  .td-review__rating { font-size: 14px; letter-spacing: 0.16em; color: var(--color-sorbus); margin-bottom: 12px; }
  .td-review__quote { font-size: 17px; line-height: 1.65; color: var(--color-nordic); margin-bottom: 14px; }
  .td-review__author { font-size: 13px; color: var(--color-nordic); opacity: 0.7; }
  .td-review__author em { opacity: 0.5; }

  /* ── S8 td-cta ──────────────────────────────────── */
  .td-cta {
    position: relative;
    min-height: 70vh;
    overflow: hidden;
    display: flex;
    align-items: center;
  }

  .td-cta__image { position: absolute; inset: 0; z-index: 1; }
  .td-cta__image img { width: 100%; height: 100%; object-fit: cover; }

  .td-cta__overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
    background: linear-gradient(to right, rgba(4,51,65,0.85) 0%, rgba(4,51,65,0.45) 70%, transparent 100%);
  }

  .td-cta__content {
    position: relative;
    z-index: 3;
    max-width: 640px;
    margin-left: max(48px, calc((100vw - var(--max-width)) / 2 + 48px));
    padding: 80px 24px;
    color: white;
  }

  .td-cta__quote {
    font-family: var(--font-heading);
    font-size: clamp(48px, 7vw, 96px);
    font-weight: 700;
    line-height: 0.95;
    letter-spacing: -0.025em;
    margin-bottom: 24px;
  }

  .td-cta__sub {
    font-size: 18px;
    line-height: 1.6;
    opacity: 0.85;
    margin-bottom: 36px;
    max-width: 460px;
  }

  @media (max-width: 960px) {
    .td-unlock__content { padding: 64px 24px; margin: 0; }
    .td-reviews__inner  { grid-template-columns: 1fr; gap: 48px; padding: 0 24px; }
    .td-cta__content    { margin-left: 0; padding: 64px 24px; }
  }

  /* ── S9 td-faq ──────────────────────────────────── */
  .td-faq { background: var(--color-white, #fff); padding: 60px 0; }

  .td-faq__inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 48px;
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    gap: 80px;
    align-items: start;
  }

  .td-faq__heading {
    font-family: var(--font-heading);
    font-size: clamp(36px, 5vw, 64px);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--color-nordic);
    margin: 12px 0 16px;
  }

  .td-faq__sub { font-size: 15px; color: var(--color-nordic); opacity: 0.7; }
  .td-faq__sub a { color: var(--color-java); font-weight: 600; text-decoration: underline; }

  .td-faq__item {
    border-bottom: 1px solid rgba(4,51,65,0.15);
    padding: 24px 0;
  }

  .td-faq__item:first-child { border-top: 1px solid rgba(4,51,65,0.15); }

  .td-faq__item summary {
    font-family: var(--font-heading);
    font-size: 18px;
    font-weight: 600;
    color: var(--color-nordic);
    cursor: pointer;
    list-style: none;
    position: relative;
    padding-right: 32px;
  }

  .td-faq__item summary::-webkit-details-marker { display: none; }

  .td-faq__item summary::after {
    content: '+';
    position: absolute;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    font-size: 24px;
    color: var(--color-java);
    transition: transform 0.2s ease;
  }

  .td-faq__item[open] summary::after { content: '−'; }

  .td-faq__answer {
    margin-top: 12px;
    font-size: 15px;
    line-height: 1.75;
    color: var(--color-nordic);
    opacity: 0.8;
  }

  /* ── S10 td-departures ──────────────────────────── */
  .td-departures {
    background: var(--color-nordic);
    padding: 48px 0;
  }
  .td-departures__inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 48px;
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: 80px;
    align-items: start;
  }
  .td-departures__heading {
    font-family: var(--font-heading);
    font-size: clamp(24px, 3vw, 38px);
    font-weight: 700;
    color: var(--color-light-cyan);
    line-height: 1.15;
    margin: 8px 0 16px;
  }
  .td-departures__sub {
    font-size: 14px;
    line-height: 1.7;
    color: rgba(217,247,245,0.65);
    margin-bottom: 28px;
    max-width: 340px;
  }
  .td-departures__cta {
    display: inline-block;
    background: var(--color-sorbus);
    color: #fff;
    font-family: var(--font-heading);
    font-size: 14px;
    font-weight: 700;
    padding: 12px 24px;
    border-radius: 100px;
    text-decoration: none;
    letter-spacing: 0.02em;
    transition: opacity 0.2s;
  }
  .td-departures__cta:hover { opacity: 0.88; }
  .td-departures__list {
    display: flex;
    flex-direction: column;
    gap: 0;
    border: 1px solid rgba(217,247,245,0.15);
    border-radius: 16px;
    overflow: hidden;
  }
  .td-departures__item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px 28px;
    border-bottom: 1px solid rgba(217,247,245,0.1);
    transition: background 0.2s;
  }
  .td-departures__item:last-child { border-bottom: none; }
  .td-departures__item:hover { background: rgba(217,247,245,0.06); }
  .td-departures__date {
    font-family: var(--font-heading);
    font-size: 18px;
    font-weight: 600;
    color: var(--color-light-cyan);
  }
  .td-departures__book {
    font-size: 13px;
    font-weight: 600;
    color: var(--color-sorbus);
    text-decoration: none;
    letter-spacing: 0.02em;
    transition: opacity 0.2s;
  }
  .td-departures__book:hover { opacity: 0.75; }

  /* ── S11 td-related ─────────────────────────────── */
  .td-related { background: var(--color-light-cyan); padding: 60px 0; }

  .td-related__inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 48px;
  }

  .td-related__heading {
    font-family: var(--font-heading);
    font-size: clamp(36px, 5vw, 64px);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--color-nordic);
    margin: 12px 0 56px;
  }

  .td-related__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .td-related__card {
    display: flex;
    flex-direction: column;
    gap: 20px;
    text-decoration: none;
    color: inherit;
    transition: transform 0.4s var(--ease-smooth, ease);
  }

  .td-related__card:hover { transform: translateY(-6px); }

  .td-related__card-image {
    aspect-ratio: 4/3;
    border-radius: 16px;
    overflow: hidden;
  }

  .td-related__card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease-smooth, ease);
  }

  .td-related__card:hover .td-related__card-image img { transform: scale(1.06); }

  .td-related__card-body { display: flex; flex-direction: column; gap: 8px; }

  .td-related__card-region {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-java);
  }

  .td-related__card-name {
    font-family: var(--font-heading);
    font-size: 22px;
    font-weight: 700;
    color: var(--color-nordic);
    line-height: 1.2;
  }

  .td-related__card-tagline {
    font-size: 14px;
    color: var(--color-nordic);
    opacity: 0.65;
    line-height: 1.55;
  }

  .td-related__card-link {
    font-size: 13px;
    font-weight: 600;
    color: var(--color-sorbus);
    margin-top: 8px;
  }

  @media (max-width: 960px) {
    .td-departures__inner { grid-template-columns: 1fr; gap: 48px; padding: 0 24px; }
    .td-departures        { padding: 36px 0; }
    .td-faq__inner     { grid-template-columns: 1fr; gap: 48px; padding: 0 24px; }
    .td-related__inner { padding: 0 24px; }
    .td-related__grid  { grid-template-columns: 1fr; gap: 32px; }
    .td-faq            { padding: 40px 0; }
    .td-related        { padding: 40px 0; }
  }

  /* ── Cabin upgrade toggle ───────────────────────────── */
  .td-cabin {
    border-top: 1px solid rgba(4,51,65,0.12);
    padding-top: 14px;
    margin-top: 4px;
    width: 100%;
  }

  /* When inside .td-selector, no border needed — it flows between Q1 and Q2 */
  .td-cabin--inline {
    border-top: none;
    padding-top: 0;
    margin-top: 0;
    background: rgba(29,160,160,0.06);
    border-radius: 10px;
    padding: 12px 14px;
  }

  .td-cabin__toggle {
    display: flex;
    align-items: center;
    gap: 12px;
    cursor: pointer;
    margin-bottom: 8px;
  }

  .td-cabin__toggle input { display: none; }

  .td-cabin__slider {
    position: relative;
    width: 44px;
    height: 24px;
    background: rgba(4,51,65,0.18);
    border-radius: 12px;
    flex-shrink: 0;
    transition: background 0.25s ease;
  }

  .td-cabin__slider::after {
    content: '';
    position: absolute;
    width: 18px;
    height: 18px;
    background: white;
    border-radius: 50%;
    top: 3px;
    left: 3px;
    transition: transform 0.25s ease;
    box-shadow: 0 1px 4px rgba(0,0,0,0.2);
  }

  .td-cabin__toggle input:checked ~ .td-cabin__slider {
    background: var(--color-java);
  }

  .td-cabin__toggle input:checked ~ .td-cabin__slider::after {
    transform: translateX(20px);
  }

  .td-cabin__label {
    font-size: 14px;
    font-weight: 600;
    color: var(--color-nordic);
  }

  .td-cabin__note {
    font-size: 12px;
    color: var(--color-text-muted);
    line-height: 1.5;
    margin: 0;
  }

  /* ── Discount policy ────────────────────────────────── */
  .td-discount {
    border-top: 1px solid rgba(4,51,65,0.12);
    padding-top: 18px;
    margin-top: 4px;
  }

  .td-discount__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .td-discount__list li {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 13px;
    gap: 12px;
  }

  .td-discount__label {
    color: var(--color-nordic);
    opacity: 0.75;
  }

  .td-discount__value {
    font-weight: 700;
    color: var(--color-java);
    white-space: nowrap;
  }

  /* ── Panoramic image break ─────────────────────────────────── */
  .td-panoramic {
    width: 100%;
    aspect-ratio: 3 / 1;
    overflow: hidden;
  }

  .td-panoramic img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  .td-panoramic__placeholder {
    width: 100%;
    height: 100%;
    background: var(--color-light-cyan);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    color: var(--color-nordic);
    opacity: 0.5;
    text-align: center;
    padding: 24px;
  }

  .td-panoramic__placeholder strong {
    font-family: var(--font-heading);
    font-size: 18px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .td-panoramic__placeholder p {
    font-size: 13px;
  }

  /* ── CTA bottom section ────────────────────────────────────── */
  .td-cta-bottom {
    background: var(--color-nordic);
    padding: 32px 24px;
  }

  .td-cta-bottom__inner {
    max-width: var(--max-width);
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 40px;
  }

  .td-cta-bottom__eyebrow {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-riptide);
    margin-bottom: 8px;
  }

  .td-cta-bottom__heading {
    font-family: var(--font-heading);
    font-size: clamp(24px, 3vw, 36px);
    font-weight: 700;
    color: white;
    line-height: 1.15;
    margin-bottom: 12px;
  }

  .td-cta-bottom__price {
    font-size: 20px;
    font-weight: 700;
    color: white;
    margin-bottom: 12px;
  }

  .td-cta-bottom__vnd {
    font-size: 15px;
    font-weight: 400;
    opacity: 0.55;
  }

  .td-cta-bottom__unit {
    font-size: 13px;
    font-weight: 400;
    opacity: 0.45;
  }

  .td-cta-bottom__note {
    font-size: 13px;
    color: rgba(255,255,255,0.5);
    max-width: 380px;
  }

  .td-cta-bottom__actions {
    display: flex;
    flex-direction: column;
    gap: 12px;
    flex-shrink: 0;
  }

  .c-button--ghost {
    display: inline-block;
    padding: 13px 28px;
    border-radius: 100px;
    border: 2px solid rgba(255,255,255,0.25);
    color: rgba(255,255,255,0.75);
    font-family: var(--font-heading);
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
    text-align: center;
    transition: border-color 0.2s, color 0.2s;
  }

  .c-button--ghost:hover {
    border-color: rgba(255,255,255,0.6);
    color: white;
  }

  @media (max-width: 768px) {
    .td-cta-bottom__inner {
      flex-direction: column;
      align-items: flex-start;
    }

    .td-cta-bottom__actions {
      width: 100%;
    }

    .td-cta-bottom__actions .c-button--primary,
    .td-cta-bottom__actions .c-button--ghost {
      width: 100%;
      text-align: center;
    }
  }

  /* ── Sticky bottom bar ─────────────────────────────────────── */
  .td-sticky-bar {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 200;
    background: white;
    border-top: 1px solid var(--color-light-cyan);
    box-shadow: 0 -4px 24px rgba(4, 51, 65, 0.10);
    padding: 12px 24px;
    transform: translateY(100%);
    transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .td-sticky-bar.is-visible {
    transform: translateY(0);
  }

  .td-sticky-bar__inner {
    max-width: var(--max-width);
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .td-sticky-bar__info {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .td-sticky-bar__name {
    font-family: var(--font-heading);
    font-size: 15px;
    font-weight: 700;
    color: var(--color-nordic);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 280px;
  }

  .td-sticky-bar__price {
    font-size: 14px;
    font-weight: 600;
    color: var(--color-nordic);
  }

  .td-sticky-bar__vnd {
    font-size: 12px;
    font-weight: 400;
    opacity: 0.5;
  }

  .td-sticky-bar__unit {
    font-size: 12px;
    font-weight: 400;
    opacity: 0.4;
  }

  .td-sticky-bar__btn {
    display: inline-block;
    position: relative;
    overflow: hidden;
    padding: 11px 24px;
    background: var(--color-sorbus);
    color: white;
    border-radius: 100px;
    font-family: var(--font-heading);
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
    flex-shrink: 0;
    transition: opacity 0.2s;
  }

  .td-sticky-bar__btn::after {
    content: '';
    position: absolute;
    top: 0;
    left: -75%;
    width: 50%;
    height: 100%;
    background: linear-gradient(
      120deg,
      transparent 0%,
      rgba(255, 255, 255, 0.35) 50%,
      transparent 100%
    );
    animation: btn-shimmer 3s ease-in-out infinite;
  }

  @keyframes btn-shimmer {
    0%   { left: -75%; }
    40%  { left: 125%; }
    100% { left: 125%; }
  }

  .td-sticky-bar__btn:hover { opacity: 0.88; }

  @media (max-width: 480px) {
    .td-sticky-bar__name { max-width: 160px; }
    .td-sticky-bar__vnd  { display: none; }
  }

  /* ══════════════════════════════════════════════════════════════
     Trekking-specific modules — only rendered when tour data
     includes tripGrading / safetyInfo / packingList / itinerary
     with per-day stats. Reuses existing design tokens only.
  ═══════════════════════════════════════════════════════════════ */

  /* ── S-grading · trip difficulty ─────────────────────────────── */
  .td-grading { background: var(--color-surface); padding: 60px 0; }
  .td-grading__inner { max-width: var(--max-width); margin: 0 auto; padding: 0 48px; }

  .td-grading__head {
    display: flex;
    align-items: center;
    gap: 24px;
    margin-bottom: 20px;
  }

  .td-grading__badge {
    flex-shrink: 0;
    width: 84px;
    height: 84px;
    border-radius: 50%;
    background: var(--color-light-cyan);
    border: 2px solid var(--color-java);
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 2px;
  }

  .td-grading__badge-level {
    font-family: var(--font-heading);
    font-size: 32px;
    font-weight: 700;
    color: var(--color-java);
  }

  .td-grading__badge-max {
    font-size: 14px;
    font-weight: 600;
    color: rgba(4,51,65,0.5);
  }

  .td-grading__label {
    font-family: var(--font-heading);
    font-size: clamp(24px, 3vw, 32px);
    font-weight: 700;
    color: var(--color-nordic);
    margin-bottom: 6px;
  }

  .td-grading__summary {
    font-size: 15px;
    line-height: 1.6;
    color: rgba(4,51,65,0.7);
    max-width: 640px;
  }

  .td-grading__gauge {
    display: flex;
    gap: 6px;
    margin-bottom: 40px;
  }

  .td-grading__gauge-seg {
    flex: 1;
    max-width: 90px;
    height: 8px;
    border-radius: var(--radius-full);
    background: rgba(4,51,65,0.10);
  }

  .td-grading__gauge-seg.is-filled { background: var(--color-java); }

  .td-grading__criteria {
    display: grid;
