---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NotifyPopup from '../../components/NotifyPopup.astro';
import { tours } from '../../data/tours.ts';

export function getStaticPaths() {
  return tours.map(tour => ({ params: { slug: tour.slug }, props: { tour } }));
}

const { tour } = Astro.props;

if (tour.comingSoon) {
  return Astro.redirect('/tours');
}

const galleryItems = tour.gallery && tour.gallery.length > 0
  ? tour.gallery
  : [{ src: tour.image, alt: tour.name }];

const hasDurationOptions = tour.durationOptions && tour.durationOptions.length >= 1;
const selectorMode: string = (tour as any).selectorMode ?? 'pickup-vehicle';

const pitch = tour.pitch;
const hasDurationPitch = pitch && typeof pitch === 'object' && !('headline' in (pitch as any)) && !Array.isArray(pitch);
const firstDurKey: string = (tour.durationOptions as any)?.[0]?.id || '1day';
const pitchDefault: any = hasDurationPitch
  ? ((pitch as any)[firstDurKey] ?? Object.values(pitch as any)[0])
  : pitch;

const hasDurationValue = tour.valueAnchor && typeof tour.valueAnchor === 'object' && !('headline' in (tour.valueAnchor as any));
const valueAnchorObj: any = hasDurationValue
  ? ((tour.valueAnchor as any)[firstDurKey] ?? Object.values(tour.valueAnchor as any)[0])
  : tour.valueAnchor;
const valueAnchor: any = valueAnchorObj?.headline ? valueAnchorObj : null;

const compareRows: any[] = valueAnchor?.compareTable || [];
const allTypicalSame = compareRows.length > 1 && compareRows.every((r: any) => r.typical === compareRows[0].typical);
const mergedTypical: string = allTypicalSame ? compareRows[0].typical : '';

const overview     = tour.storytelling;
const elevation    = tour.elevationProfile;
const elevMax: number = (tour as any).elevationMax ?? 1500;
const activityCards = tour.activityCards;
const welcomePack  = tour.welcomePack;
const unlock       = tour.unlockChallenge;
const season       = tour.seasonality;
const faqs         = tour.faqs;
const upcomingDates = (tour as any).upcomingDates as string[] | undefined;

const tripInfoData   = (tour.tripInfo as any) || null;
const hasTripInfo    = !!tripInfoData;
const defaultTripKey = (tour.durationOptions as any)?.[0]?.id || 'default';
const defaultTripItems: any[] = hasTripInfo
  ? (tripInfoData[defaultTripKey] || tripInfoData['default'] || [])
  : [];

const cabinUpgrade    = (tour as any).cabinUpgrade || null;
const discountPolicy  = (tour as any).discountPolicy || null;
const panoramicImage  = (tour as any).panoramicImage || null;

// Sticky CTA data
const ctaPrice     = tour.durationOptions ? tour.durationOptions[0].price : (tour as any).priceUSD;
const ctaPriceVND  = tour.durationOptions ? (tour.durationOptions[0] as any).priceVND ?? null : (tour as any).priceVND ?? null;
const ctaWaText    = tour.durationOptions ? tour.durationOptions[0].waText : '';
const firstOptionId  = tour.durationOptions?.[0]?.id ?? '';
const ctaContactLink = `/contact?tour=${encodeURIComponent(tour.name)}${firstOptionId ? `&option=${firstOptionId}` : ''}`;
---

<BaseLayout title={tour.name} description={tour.tagline}>

  <!-- ═══ S1 · b-product (split hero) ════════════════════════════ -->
  <section class="td-product page-offset">
    <div class="td-product__inner">

      <!-- Left: Image gallery -->
      <div class="td-product__gallery">
        {tour.gallery && tour.gallery.length > 0 ? (
          <>
            <div class="td-product__main-image">
              <img id="td-main-img" class="td-main-img is-active" src={galleryItems[0].src} alt={galleryItems[0].alt} fetchpriority="high" />
              <img id="td-main-img-b" class="td-main-img" src={galleryItems[0].src} alt="" aria-hidden="true" />
              {galleryItems.length > 1 && (
                <div class="td-gallery__nav">
                  <button id="td-prev" class="td-gallery__arrow" aria-label="Previous image">
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                      <path d="M10 3L5 8L10 13" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </button>
                  <button id="td-next" class="td-gallery__arrow" aria-label="Next image">
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                      <path d="M6 3L11 8L6 13" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </button>
                </div>
              )}
            </div>
            <div class="td-product__thumbs">
              {galleryItems.map((g, i) => (
                <button
                  class={`td-product__thumb${i === 0 ? ' active' : ''}`}
                  data-src={g.src}
                  data-alt={g.alt}
                  aria-label={`Image ${i + 1}`}
                >
                  <img src={g.src} alt={g.alt} loading="lazy" />
                </button>
              ))}
            </div>
          </>
        ) : (
          <div class="td-product__photo-pending">
            <div class="td-product__photo-pending-icon">📷</div>
            <strong>PHOTO PENDING</strong>
            <p>Hero gallery for {tour.name}. Brief: 4–6 wide shots showing the route, activities, and people. Candid moments preferred over posed.</p>
          </div>
        )}
      </div>

      <!-- Right: Purchase panel -->
      <div class="td-product__panel" id="td-product-panel" data-duration-options={hasDurationOptions ? JSON.stringify(tour.durationOptions) : ''} data-tour-name={tour.name}>
        <p class="td-product__eyebrow">
          {tour.region === 'north' ? 'NORTH VIETNAM' : tour.region === 'soon' ? 'Coming soon' : tour.region}
          &nbsp;·&nbsp;{tour.duration.join(' / ')}
        </p>
        <h1 class="td-product__heading">{tour.name}</h1>

        {hasDurationOptions ? (
          <>
            <!-- Selector: duration-tabs OR vehicle-only (1 dropdown) OR pickup-vehicle (2 dropdowns) -->
            <div class="td-selector" id="td-selector"
              data-selector-mode={selectorMode}
              data-duration-options={JSON.stringify(tour.durationOptions)}>

              {selectorMode === 'duration-tabs' ? (
                /* ── Duration tabs: 1 Day / 2D1N / 3D2N ── */
                <div class="td-dur-tabs" id="td-dur-tabs">
                  {tour.durationOptions.map((opt: {id: string; label: string}, i: number) => (
                    <button
                      class={`td-dur-tab${i === 0 ? ' is-active' : ''}`}
                      data-dur-id={opt.id}
                      type="button"
                    >
                      {opt.label}
                    </button>
                  ))}
                </div>
              ) : selectorMode === 'vehicle-only' ? (
                /* ── Single dropdown: choose vehicle (hidden if only 1 option) ── */
                <div class="td-selector__q" style={tour.durationOptions.length <= 1 ? 'display:none' : ''}>
                  <label class="td-selector__label" for="td-sel-vehicle-only">
                    How do you want to explore?
                  </label>
                  <div class="td-selector__wrap">
                    <select id="td-sel-vehicle-only" class="td-selector__select">
                      {tour.durationOptions.map((opt: {id: string; label: string}) => (
                        <option value={opt.id}>{opt.label}</option>
                      ))}
                    </select>
                    <svg class="td-selector__arrow" width="16" height="16" viewBox="0 0 16 16" fill="none">
                      <path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </div>
                </div>
              ) : (
                /* ── Two dropdowns: pickup × vehicle ── */
                <>
                  <div class="td-selector__q">
                    <label class="td-selector__label" for="td-sel-pickup">
                      Where are you joining us from?
                    </label>
                    <div class="td-selector__wrap">
                      <select id="td-sel-pickup" class="td-selector__select">
                        <option value="hanoi">Hanoi — Economy overnight bus included</option>
                        <option value="sapa">Sa Pa — already there</option>
                      </select>
                      <svg class="td-selector__arrow" width="16" height="16" viewBox="0 0 16 16" fill="none">
                        <path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </div>
                  </div>

                  <!-- Cabin upgrade toggle — shown inline after Q1, only for Hanoi -->
                  {cabinUpgrade && (
                    <div class="td-cabin td-cabin--inline" id="td-cabin-section" style="display:none"
                      data-surcharge-vnd={cabinUpgrade.surchargeVND}
                      data-surcharge-usd={cabinUpgrade.surchargeUSD ?? 8}>
                      <p class="td-tripinfo__section-label">Sleeper bus upgrade</p>
                      <label class="td-cabin__toggle">
                        <input type="checkbox" id="td-cabin-check" />
                        <span class="td-cabin__slider"></span>
                        <span class="td-cabin__label" id="td-cabin-label">{cabinUpgrade.labelOff}</span>
                      </label>
                      <p class="td-cabin__note" id="td-cabin-note">{cabinUpgrade.surchargeNote}</p>
                    </div>
                  )}

                  <div class="td-selector__q">
                    <label class="td-selector__label" for="td-sel-vehicle">
                      How do you want to take the pass?
                    </label>
                    <div class="td-selector__wrap">
                      <select id="td-sel-vehicle" class="td-selector__select">
                        <option value="car">By car — sit back, watch it unfold</option>
                        <option value="motor">By motorbike — earn the view</option>
                      </select>
                      <svg class="td-selector__arrow" width="16" height="16" viewBox="0 0 16 16" fill="none">
                        <path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </div>
                  </div>
                </>
              )}
            </div>

            <!-- Dynamic price -->
            {tour.durationOptions[0].price != null && (
              <div class="td-product__price" id="td-price-display">
                <span class="td-product__price-row">
                  <span id="td-price-amount">${tour.durationOptions[0].price}</span>
                  {(tour as any).priceVND && (
                    <>
                      <span class="td-product__price-sep"> / </span>
                      <span class="td-product__price-vnd" id="td-price-vnd">{((tour as any).priceVND as number).toLocaleString('vi-VN')} VND</span>
                    </>
                  )}
                </span>
                <span class="td-product__price-unit">/person</span>
              </div>
            )}

            <!-- Cabin upgrade — vehicle-only mode (always visible, no pickup condition) -->
            {cabinUpgrade && selectorMode === 'vehicle-only' && (
              <div class="td-cabin td-cabin--inline" id="td-cabin-section"
                data-surcharge-vnd={cabinUpgrade.surchargeVND}
                data-surcharge-usd={cabinUpgrade.surchargeUSD ?? 8}>
                <p class="td-tripinfo__section-label">Sleeper bus upgrade</p>
                <label class="td-cabin__toggle">
                  <input type="checkbox" id="td-cabin-check" />
                  <span class="td-cabin__slider"></span>
                  <span class="td-cabin__label" id="td-cabin-label">{cabinUpgrade.labelOff}</span>
                </label>
                <p class="td-cabin__note" id="td-cabin-note">{cabinUpgrade.surchargeNote}</p>
              </div>
            )}

            <!-- Dynamic tagline -->
            <p class="td-product__tagline" id="td-tagline-display">{tour.durationOptions[0].tagline}</p>

            {!tour.comingSoon ? (
              <div class="td-product__cta" id="td-cta-display">
                <a
                  href={`/contact?tour=${encodeURIComponent(tour.name)}`}
                  class="c-button c-button--primary td-product__book"
                  id="td-cta-btn"
                >
                  {tour.durationOptions[0].ctaLabel}
                </a>
                <p class="td-product__cta-note" id="td-cta-note">{tour.durationOptions[0].ctaNote}</p>
              </div>
            ) : (
              <div class="td-product__cta">
                <button class="c-button c-button--outline" data-popup-trigger="#notify-popup">
                  Notify me when live
                </button>
                <p class="td-product__cta-note">{tour.price}</p>
              </div>
            )}

            <!-- Upcoming dates (compact strip) -->
            {upcomingDates && upcomingDates.length > 0 && (
              <div class="td-upcoming">
                <p class="td-upcoming__label">Next departures</p>
                <div class="td-upcoming__pills">
                  {upcomingDates.map((d: string) => (
                    <a href={`/contact?tour=${encodeURIComponent(tour.name)}&date=${encodeURIComponent(d)}`} class="td-upcoming__pill">{d}</a>
                  ))}
                </div>
              </div>
            )}

            <!-- Trip Info cards -->
            {hasTripInfo && (
              <div class="td-tripinfo" id="td-tripinfo-section"
                data-trip-info={JSON.stringify(tripInfoData)}>
                <p class="td-tripinfo__section-label">Trip info</p>
                <div class="td-tripinfo__grid" id="td-tripinfo-grid">
                  {defaultTripItems.map((item: any) => (
                    <div class="td-tripinfo__card">
                      <div class="td-tripinfo__icon-wrap">
                        <i class={`ti ti-${item.icon}`} aria-hidden="true"></i>
                      </div>
                      <div>
                        <p class="td-tripinfo__label">{item.label}</p>
                        <p class="td-tripinfo__value">{item.value}</p>
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            )}

            <!-- Cabin upgrade is now rendered inside .td-selector above -->

            <!-- Discount policy -->
            {discountPolicy && (
              <div class="td-discount">
                <p class="td-tripinfo__section-label">Discounts</p>
                <ul class="td-discount__list">
                  {discountPolicy.rules.map((r: {label: string; value: string}) => (
                    <li>
                      <span class="td-discount__label">{r.label}</span>
                      <span class="td-discount__value">{r.value}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </>
        ) : (
          <>
            <div class="td-product__price">
              <span class="td-product__price-row">
                <span>{tour.priceUSD ? `$${tour.priceUSD}` : 'TBA'}</span>
                {(tour as any).priceVND && (
                  <>
                    <span class="td-product__price-sep"> / </span>
                    <span class="td-product__price-vnd">{((tour as any).priceVND as number).toLocaleString('vi-VN')} VND</span>
                  </>
                )}
              </span>
              <span class="td-product__price-unit">/person</span>
            </div>
            <p class="td-product__tagline">{tour.tagline}</p>

            {!tour.comingSoon ? (
              <div class="td-product__cta">
                <a
                  href={`/contact?tour=${encodeURIComponent(tour.name)}`}
                  class="c-button c-button--primary td-product__book"
                >
                  I'm in →
                </a>
                <p class="td-product__cta-note">No payment now. We hold your spot, you pay 14 days before. Free cancellation.</p>
              </div>
            ) : (
              <div class="td-product__cta">
                <button class="c-button c-button--outline" data-popup-trigger="#notify-popup">
                  Notify me when live
                </button>
                <p class="td-product__cta-note">{tour.price}</p>
              </div>
            )}

            <!-- Upcoming dates (compact strip) -->
            {upcomingDates && upcomingDates.length > 0 && (
              <div class="td-upcoming">
                <p class="td-upcoming__label">Next departures</p>
                <div class="td-upcoming__pills">
                  {upcomingDates.map((d: string) => (
                    <a href={`/contact?tour=${encodeURIComponent(tour.name)}&date=${encodeURIComponent(d)}`} class="td-upcoming__pill">{d}</a>
                  ))}
                </div>
              </div>
            )}

            <!-- Trip Info cards (single-duration tours) -->
            {hasTripInfo && (
              <div class="td-tripinfo" id="td-tripinfo-section">
                <p class="td-tripinfo__section-label">Trip info</p>
                <div class="td-tripinfo__grid" id="td-tripinfo-grid">
                  {defaultTripItems.map((item: any) => (
                    <div class="td-tripinfo__card">
                      <div class="td-tripinfo__icon-wrap">
                        <i class={`ti ti-${item.icon}`} aria-hidden="true"></i>
                      </div>
                      <div>
                        <p class="td-tripinfo__label">{item.label}</p>
                        <p class="td-tripinfo__value">{item.value}</p>
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            )}
          </>
        )}
      </div>
    </div>
  </section>

  <!-- ═══ S2 · b-marquee ═════════════════════════════════════════ -->
  <div class="b-marquee td-marquee" aria-hidden="true">
    <div class="b-marquee__track">
      {[...Array(2)].map(() => (
        <>
          <span class="b-marquee__item">All meals included<span class="b-marquee__sep">✦</span></span>
          <span class="b-marquee__item">Licensed int'l operator<span class="b-marquee__sep">✦</span></span>
          <span class="b-marquee__item">No payment upfront<span class="b-marquee__sep">✦</span></span>
          <span class="b-marquee__item">Free cancellation<span class="b-marquee__sep">✦</span></span>
          <span class="b-marquee__item">Unlock Challenge included<span class="b-marquee__sep">✦</span></span>
        </>
      ))}
    </div>
  </div>

  <!-- ═══ S3 · b-pitch (Hook storytelling) ═══════════════════════ -->
  <section class="td-pitch" id="td-pitch-section" data-pitch={hasDurationPitch ? JSON.stringify(tour.pitch) : ''}>
    <div class="td-pitch__inner">
      <p class="section-label">The pitch</p>
      <blockquote class="td-pitch__headline" id="td-pitch-headline">
        {pitchDefault?.headline || "By tonight, you'll have done things most weekenders never get to."}
      </blockquote>
      <div class="td-pitch__body">
        {(pitchDefault?.paragraphs || []).map((p: string) => <p>{p}</p>)}
        <p class="td-pitch__closing" id="td-pitch-closing">{pitchDefault?.closingLine || ''}</p>
      </div>
      <ul class="td-pitch__bullets" id="td-pitch-bullets">
        {(pitchDefault?.bullets || []).map((b: string) => <li>{b}</li>)}
      </ul>
    </div>
  </section>

  <!-- ═══ S4 · b-value (Justify the price) ═══════════════════════ -->
  {valueAnchor && (
    <section class="td-value" id="td-value-section" data-value-anchor={hasDurationValue ? JSON.stringify(tour.valueAnchor) : ''}>
      <div class="td-value__inner">
        <div class="td-value__left">
          <p class="section-label">Worth it?</p>
          <h2 class="td-value__heading" id="td-value-headline">{valueAnchor.headline}</h2>
          <div class="td-value__body" id="td-value-paragraphs">
            {(valueAnchor.paragraphs || []).map((p: string) => <p>{p}</p>)}
          </div>
        </div>
        <div class="td-value__right">
          <table class="td-value__table">
            <thead>
              <tr>
                <th></th>
                <th class="td-value__th-typical">Typical tour</th>
                <th class="td-value__th-us">Morning Vietnam</th>
              </tr>
            </thead>
            <tbody id="td-value-table-body">
              {compareRows.map((row: {metric: string; typical: string; us: string}, i: number) => (
                <tr>
                  <td class="td-value__metric">{row.metric}</td>
                  {allTypicalSame
                    ? (i === 0 ? <td class="td-value__bad td-value__bad--merged" rowspan={compareRows.length}>{mergedTypical}</td> : null)
                    : <td class="td-value__bad">{row.typical}</td>
                  }
                  <td class="td-value__good">{row.us}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>
  )}

  <!-- ═══ S4 · b-timeline (SVG elevation chart) ═════════════════ -->
  <section class="td-timeline">
    <div class="td-timeline__inner">
      <p class="section-label">The journey</p>
      <h2 class="td-timeline__heading">A day, mapped.</h2>
      <p class="td-timeline__sub">Time across, elevation up. Every spike is a moment worth remembering.</p>

      {elevation && elevation.length > 0 ? (
        <div class="td-timeline__chart-wrap">
          <svg
            class="td-timeline__svg"
            viewBox="0 0 1200 500"
            preserveAspectRatio="xMidYMid meet"
            role="img"
            aria-label={`Elevation timeline for ${tour.name}`}
          >
            <defs>
              <linearGradient id="elevGradTeal" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stop-color="var(--color-java)" stop-opacity="0.45" />
                <stop offset="100%" stop-color="var(--color-java)" stop-opacity="0.04" />
              </linearGradient>
              <linearGradient id="elevGradOrange" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stop-color="var(--color-sorbus)" stop-opacity="0.55" />
                <stop offset="100%" stop-color="var(--color-sorbus)" stop-opacity="0.06" />
              </linearGradient>
            </defs>

            {/* Y-axis gridlines + labels */}
            {Array.from({ length: Math.floor(elevMax / 300) + 1 }, (_, i) => i * 300).map((elev) => {
              const yPos = 320 - (elev / elevMax) * 270;
              return (
                <>
                  <line x1="60" y1={yPos} x2="1160" y2={yPos} stroke="rgba(4,51,65,0.07)" stroke-width="1" />
                  <text x="52" y={yPos + 4} text-anchor="end" font-size="11" fill="rgba(4,51,65,0.4)" font-family="Commissioner, sans-serif">{elev}m</text>
                </>
              );
            })}

            {/* Main chart rendering — supports day-coloring and duration splits */}
            {(() => {
              const allPts = elevation!;
              const hasDays = allPts.some((p: any) => p.day != null);
              const hasDurationSplit = allPts.some((p: any) => p.durationOnly);

              // --- helper: x/y from index within a flat array ---
              function ptX(i: number, total: number) { return 60 + i * (1100 / Math.max(1, total - 1)); }
              function ptY(elev: number) { return 320 - (elev / elevMax) * 270; }

              // --- build label lines ---
              function labelLines(label: string): [string, string] {
                if (label.includes(' · ')) {
                  const idx = label.indexOf(' · ');
                  return [label.substring(0, idx), label.substring(idx + 3)];
                }
                if (label.includes(' — ')) {
                  const idx = label.indexOf(' — ');
                  return [label.substring(0, idx), label.substring(idx + 3)];
                }
                if (label.length > 14) {
                  const mid = Math.floor(label.length / 2);
                  const spaceIdx = label.lastIndexOf(' ', mid + 4);
                  if (spaceIdx > 0) return [label.substring(0, spaceIdx), label.substring(spaceIdx + 1)];
                }
                return [label, ''];
              }

              // ── CASE A: day-colored segments (lai-chau-motortour style) ──
              // Also handles CASE A+B: hasDays + hasDurationSplit (e.g. sapa-nam-cang)
              // In that case we render one day-coloured chart per duration, toggle via CSS
              if (hasDays) {
                type DivInfo = { x: number; y: number };
                type Seg = { day: number; pathPts: DivInfo[] };

                function buildDayChart(pts: any[]) {
                  const total = pts.length;
                  const coords = pts.map((p: any, i: number) => ({
                    x: ptX(i, total), y: ptY(p.elevation), ...p,
                  }));

                  const dividers: DivInfo[] = [];
                  for (let i = 1; i < coords.length; i++) {
                    if ((coords[i].day ?? 1) !== (coords[i-1].day ?? 1)) {
                      const t = 0.5;
                      const x = coords[i-1].x + t * (coords[i].x - coords[i-1].x);
                      const y = coords[i-1].y + t * (coords[i].y - coords[i-1].y);
                      dividers.push({ x, y });
                    }
                  }

                  const segments: Seg[] = [];
                  {
                    let segDay = coords[0].day ?? 1;
                    let segPts: DivInfo[] = [{ x: coords[0].x, y: coords[0].y }];
                    let divIdx = 0;
                    for (let i = 1; i < coords.length; i++) {
                      const d = coords[i].day ?? 1;
                      if (d !== segDay) {
                        segPts.push({ x: dividers[divIdx].x, y: dividers[divIdx].y });
                        segments.push({ day: segDay, pathPts: segPts });
                        segDay = d;
                        segPts = [{ x: dividers[divIdx].x, y: dividers[divIdx].y }, { x: coords[i].x, y: coords[i].y }];
                        divIdx++;
                      } else {
                        segPts.push({ x: coords[i].x, y: coords[i].y });
                      }
                    }
                    segments.push({ day: segDay, pathPts: segPts });
                  }

                  function segPath(pts: DivInfo[], close: boolean) {
                    let d = pts.map((p, i) => `${i === 0 ? 'M' : 'L'} ${p.x} ${p.y}`).join(' ');
                    if (close) d += ` L ${pts[pts.length-1].x} 320 L ${pts[0].x} 320 Z`;
                    return d;
                  }

                  const dayColor = (day: number) => day === 2 ? 'var(--color-sorbus)' : 'var(--color-java)';
                  const dayGrad  = (day: number) => day === 2 ? 'url(#elevGradOrange)' : 'url(#elevGradTeal)';
                  const dayLabel = (day: number) => day === 0 ? 'NIGHT' : `DAY ${day}`;

                  return (
                    <>
                      {segments.map((seg: Seg) => {
                        const x0 = seg.pathPts[0].x;
                        const x1 = seg.pathPts[seg.pathPts.length - 1].x;
                        const bgColor = seg.day === 2 ? 'rgba(234,103,57,0.07)' : seg.day === 0 ? 'rgba(29,160,160,0.05)' : 'rgba(29,160,160,0.08)';
                        return <rect x={x0} y={30} width={x1 - x0} height={290} fill={bgColor} rx="0" />;
                      })}
                      {dividers.map((div: DivInfo) => (
                        <line x1={div.x} y1={30} x2={div.x} y2={370} stroke="rgba(4,51,65,0.25)" stroke-width="1.5" stroke-dasharray="6 4" />
                      ))}
                      {segments.map((seg: Seg) => (
                        <path d={segPath(seg.pathPts, true)} fill={dayGrad(seg.day)} />
                      ))}
                      {segments.map((seg: Seg) => (
                        <path d={segPath(seg.pathPts, false)} fill="none" stroke={dayColor(seg.day)} stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
                      ))}
                      {segments.map((seg: Seg) => {
                        const midX = (seg.pathPts[0].x + seg.pathPts[seg.pathPts.length-1].x) / 2;
                        const col = seg.day === 2 ? 'var(--color-sorbus)' : 'var(--color-java)';
                        return (
                          <text x={midX} y={395} text-anchor="middle" font-size="11" font-weight="700" letter-spacing="0.08em" fill={col} font-family="Commissioner, sans-serif" opacity="0.7">
                            {dayLabel(seg.day)}
                          </text>
                        );
                      })}
                      {coords.map((p: any) => {
                        const isDay2 = (p.day ?? 1) === 2;
                        const dotColor = isDay2 ? 'var(--color-sorbus)' : 'var(--color-java)';
                        const dotR = p.highlight ? 10 : 7;
                        const [line1, line2] = labelLines(p.label);
                        const fw = p.highlight ? '700' : '500';
                        const baseY = 340;
                        return (
                          <g class={`td-timeline__point${p.highlight ? ' is-highlight' : ''}`}>
                            <circle cx={p.x} cy={p.y} r={dotR} fill={dotColor} stroke="white" stroke-width="2.5" />
                            <text x={p.x} y={p.y - 18} text-anchor="middle" font-size="10" font-weight="700" fill="var(--color-nordic)" font-family="Commissioner, sans-serif">{p.time}</text>
                            <text x={p.x} y={baseY} text-anchor="middle" font-size="10" fill="var(--color-nordic)" font-family="Commissioner, sans-serif" font-weight={fw}>{line1}</text>
                            {line2 && <text x={p.x} y={baseY + 13} text-anchor="middle" font-size="10" fill="var(--color-nordic)" font-family="Commissioner, sans-serif" font-weight={fw}>{line2}</text>}
                            <text x={p.x} y={baseY + (line2 ? 26 : 13)} text-anchor="middle" font-size="9" fill="rgba(4,51,65,0.45)" font-family="Commissioner, sans-serif">{p.elevation}m</text>
                          </g>
                        );
                      })}
                    </>
                  );
                }

                // CASE A+B: has both day-coloring AND duration split — render per-duration charts
                if (hasDurationSplit) {
                  const sharedPts = allPts.filter((p: any) => !p.durationOnly);
                  const pts1day = [...sharedPts, ...allPts.filter((p: any) => p.durationOnly === '1day')];
                  const pts2d1n = [...sharedPts, ...allPts.filter((p: any) => p.durationOnly === '2d1n')];
                  const pts3d2n = [...sharedPts, ...allPts.filter((p: any) => p.durationOnly === '3d2n')];
                  return (
                    <>
                      {pts1day.length > 0 && (
                        <g class="svg-path-1day">{buildDayChart(pts1day)}</g>
                      )}
                      {pts2d1n.length > 0 && (
                        <g class="svg-path-2d1n">{buildDayChart(pts2d1n)}</g>
                      )}
                      {pts3d2n.length > 0 && (
                        <g class="svg-path-3d2n">{buildDayChart(pts3d2n)}</g>
                      )}
                    </>
                  );
                }

                // CASE A pure: no durationOnly, just day-coloring
                return buildDayChart(allPts);
              }

              // ── CASE B: duration-split (1day / 2d1n / 3d2n) — original logic ──
              const sharedPts = allPts.filter((p: any) => !p.durationOnly);
              const pts1day = [...sharedPts, ...allPts.filter((p: any) => p.durationOnly === '1day')];
              const pts2d1n = [...sharedPts, ...allPts.filter((p: any) => p.durationOnly === '2d1n')];
              const pts3d2n = [...sharedPts, ...allPts.filter((p: any) => p.durationOnly === '3d2n')];

              function makePath(pts: any[], close: boolean) {
                const step = 1100 / Math.max(1, pts.length - 1);
                let d = pts.map((p: any, i: number) => {
                  const x = ptX(i, pts.length);
                  const y = ptY(p.elevation);
                  return `${i === 0 ? 'M' : 'L'} ${x} ${y}`;
                }).join(' ');
                if (close) {
                  const lastX = ptX(pts.length - 1, pts.length);
                  d += ` L ${lastX} 320 L 60 320 Z`;
                }
                return d;
              }

              function renderDots(pts: any[], durClass: string) {
                return pts.map((p: any, i: number) => {
                  const x = ptX(i, pts.length);
                  const y = ptY(p.elevation);
                  const [line1, line2] = labelLines(p.label);
                  const fw = p.highlight ? '700' : '500';
                  const baseY = 340;
                  return (
                    <g class={`td-timeline__point ${durClass}${p.highlight ? ' is-highlight' : ''}`} data-duration={p.durationOnly || 'all'}>
                      <circle cx={x} cy={y} r={p.highlight ? 10 : 7} fill={p.highlight ? 'var(--color-sorbus)' : 'var(--color-java)'} stroke="white" stroke-width="2.5" />
                      <text x={x} y={y - 18} text-anchor="middle" font-size="10" font-weight="700" fill="var(--color-nordic)" font-family="Commissioner, sans-serif">{p.time}</text>
                      <text x={x} y={baseY} text-anchor="middle" font-size="10" fill="var(--color-nordic)" font-family="Commissioner, sans-serif" font-weight={fw}>{line1}</text>
                      {line2 && <text x={x} y={baseY + 13} text-anchor="middle" font-size="10" fill="var(--color-nordic)" font-family="Commissioner, sans-serif" font-weight={fw}>{line2}</text>}
                      <text x={x} y={baseY + (line2 ? 26 : 13)} text-anchor="middle" font-size="9" fill="rgba(4,51,65,0.45)" font-family="Commissioner, sans-serif">{p.elevation}m</text>
                    </g>
                  );
                });
              }

              return (
                <>
                  <path class="svg-path-1day" d={makePath(pts1day, true)} fill="url(#elevGradTeal)" />
                  {pts2d1n.length > 0 && <path class="svg-path-2d1n" d={makePath(pts2d1n, true)} fill="url(#elevGradTeal)" />}
                  {pts3d2n.length > 0 && <path class="svg-path-3d2n" d={makePath(pts3d2n, true)} fill="url(#elevGradTeal)" />}
                  <path class="svg-path-1day" d={makePath(pts1day, false)} fill="none" stroke="var(--color-java)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
                  {pts2d1n.length > 0 && <path class="svg-path-2d1n" d={makePath(pts2d1n, false)} fill="none" stroke="var(--color-java)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />}
                  {pts3d2n.length > 0 && <path class="svg-path-3d2n" d={makePath(pts3d2n, false)} fill="none" stroke="var(--color-java)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />}
                  {renderDots(pts1day, 'svg-path-1day')}
                  {pts2d1n.length > 0 && renderDots(pts2d1n, 'svg-path-2d1n')}
                  {pts3d2n.length > 0 && renderDots(pts3d2n, 'svg-path-3d2n')}
                </>
              );
            })()}

            {/* X-axis baseline */}
            <line x1="60" y1="320" x2="1160" y2="320" stroke="var(--color-nordic)" stroke-width="1" opacity="0.2" />
          </svg>
        </div>
      ) : (
        <div class="td-timeline__placeholder">
          <strong>Timeline data pending.</strong>
          <p>Elevation profile for {tour.name} will be added once the route is finalized.</p>
        </div>
      )}
      {activityCards && activityCards.length > 0 && (
        <div class="td-timeline__cards">
          {activityCards.map((c: {badges?: string[]; badge?: string; badgeLabel?: string; time: string; title: string; desc: string; highlight: boolean; durationOnly?: string}) => (
