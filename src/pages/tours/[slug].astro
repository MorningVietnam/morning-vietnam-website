</style>

<script>
  (() => {
    const imgA   = document.getElementById('td-main-img')   as HTMLImageElement | null;
    const imgB   = document.getElementById('td-main-img-b') as HTMLImageElement | null;
    const thumbs = document.querySelectorAll<HTMLButtonElement>('.td-product__thumb');
    const prevBtn = document.getElementById('td-prev') as HTMLButtonElement | null;
    const nextBtn = document.getElementById('td-next') as HTMLButtonElement | null;
    const gallery = document.querySelector('.td-product__gallery') as HTMLElement | null;

    if (!imgA || !imgB || thumbs.length === 0) return;

    const sources = Array.from(thumbs).map(t => ({
      src: t.dataset.src ?? '',
      alt: t.dataset.alt ?? '',
    }));

    let current = 0;
    let activeLayer: HTMLImageElement = imgA;
    let nextLayer:   HTMLImageElement = imgB;
    let timer: ReturnType<typeof setInterval> | null = null;
    let isTransitioning = false;

    // Preload toàn bộ gallery (chạy sau khi page idle) để swap không trắng ảnh
    function preloadAll() {
      sources.forEach(s => { const i = new Image(); i.src = s.src; });
    }
    if ('requestIdleCallback' in window) {
      (window as any).requestIdleCallback(preloadAll, { timeout: 2000 });
    } else {
      setTimeout(preloadAll, 800);
    }

    function showSlide(idx: number) {
      if (isTransitioning) return;
      const next = ((idx % sources.length) + sources.length) % sources.length;
      if (next === current) return;

      const target = sources[next];
      isTransitioning = true;

      // Load ảnh mới vào layer ẩn TRƯỚC khi fade
      const onReady = () => {
        nextLayer.classList.add('is-active');
        activeLayer.classList.remove('is-active');
        // Sau khi fade xong, hoán đổi vai trò 2 layer
        window.setTimeout(() => {
          const tmp = activeLayer;
          activeLayer = nextLayer;
          nextLayer = tmp;
          current = next;
          isTransitioning = false;
        }, 600); // khớp transition 0.6s
      };

      nextLayer.alt = target.alt;
      if (nextLayer.src === target.src && nextLayer.complete && nextLayer.naturalWidth > 0) {
        onReady();
      } else {
        nextLayer.onload = onReady;
        nextLayer.onerror = () => { isTransitioning = false; };
        nextLayer.src = target.src;
        // Nếu đã có trong cache, onload có thể không fire kịp — chốt bằng complete
        if (nextLayer.complete && nextLayer.naturalWidth > 0) onReady();
      }

      // Cập nhật trạng thái thumb ngay (không đợi fade)
      thumbs.forEach(x => x.classList.remove('active'));
      thumbs[next].classList.add('active');
    }

    function startTimer() {
      if (timer) return;
      timer = setInterval(() => showSlide(current + 1), 5000);
    }
    function stopTimer() {
      if (timer) { clearInterval(timer); timer = null; }
    }
    function resetTimer() { stopTimer(); startTimer(); }

    thumbs.forEach((t, i) => {
      t.addEventListener('click', () => { showSlide(i); resetTimer(); });
    });
    prevBtn?.addEventListener('click', () => { showSlide(current - 1); resetTimer(); });
    nextBtn?.addEventListener('click', () => { showSlide(current + 1); resetTimer(); });

    gallery?.addEventListener('mouseenter', stopTimer);
    gallery?.addEventListener('mouseleave', startTimer);

    if (sources.length > 1) startTimer();
  })();

  /* ── Duration switcher ─────────────────────────────── */
  (() => {
    const panel = document.getElementById('td-product-panel');
    if (!panel) return;

    // Tag elements using data-duration attribute from template
    document.querySelectorAll<HTMLElement>('.td-timeline__act-card[data-duration], .td-timeline__point[data-duration]').forEach(el => {
      const dur = el.dataset.duration;
      if (dur && dur !== 'all') el.classList.add(`is-${dur}-only`);
    });

    const rawOptions = panel.dataset.durationOptions;
    if (!rawOptions) return;

    const tourName = panel.dataset.tourName || '';
    const durationOptions = JSON.parse(rawOptions);

    const selectorEl   = document.getElementById('td-selector');
    const selectorMode = selectorEl?.dataset.selectorMode ?? 'pickup-vehicle';
    const selPickup    = document.getElementById('td-sel-pickup')       as HTMLSelectElement | null;
    const selVehicle   = document.getElementById('td-sel-vehicle')      as HTMLSelectElement | null;
    const selVehicleOnly = document.getElementById('td-sel-vehicle-only') as HTMLSelectElement | null;
    const selPax         = document.getElementById('td-sel-pax')           as HTMLSelectElement | null;
    const paxNoteEl      = document.getElementById('td-pax-note')          as HTMLElement | null;
    const priceAmountEl = document.getElementById('td-price-amount');
    const taglineEl = document.getElementById('td-tagline-display');
    const ctaBtn = document.getElementById('td-cta-btn') as HTMLAnchorElement | null;
    const ctaNote = document.getElementById('td-cta-note');

    function resolveId(): string {
      if (selectorMode === 'duration-tabs') {
        // Tab buttons — read active tab's data-dur-id
        const activeTab = document.querySelector('.td-dur-tab.is-active') as HTMLElement | null;
        return activeTab?.dataset.durId || durationOptions[0]?.id || '1day';
      }
      if (selectorMode === 'vehicle-only') {
        // Single dropdown — value IS the option id (e.g. "car" or "motor")
        return selVehicleOnly?.value || durationOptions[0]?.id || 'car';
      }
      // Two dropdowns — combine pickup + vehicle
      const pickup  = selPickup?.value  || 'hanoi';
      const vehicle = selVehicle?.value || 'car';
      return `${pickup}-${vehicle}`;
    }

    function switchDuration(id: string) {
      const opt = durationOptions.find((o: any) => o.id === id);
      if (!opt) return;

      // 1. (no tabs to toggle)

      // 2. Price
      const priceDisplay = document.getElementById('td-price-display');
      if (opt.price != null) {
        if (priceAmountEl) priceAmountEl.textContent = `$${opt.price}`;
        if (priceDisplay) priceDisplay.style.display = '';
      } else {
        if (priceDisplay) priceDisplay.style.display = 'none';
      }
      // 2b. VND price — only update if this option explicitly carries priceVND;
      //     if not, leave the static tour-level VND visible as-is.
      const priceVndEl = document.getElementById('td-price-vnd');
      if (priceVndEl && opt.priceVND != null) {
        priceVndEl.textContent = `${opt.priceVND.toLocaleString('vi-VN')} VND`;
        priceVndEl.style.display = '';
        const sep = priceVndEl.previousElementSibling as HTMLElement | null;
        if (sep) sep.style.display = '';
      }

      // 3. Tagline
      if (taglineEl) taglineEl.textContent = opt.tagline;

      // 4. CTA
      if (ctaBtn) {
        ctaBtn.href = `/contact?tour=${encodeURIComponent(tourName)}&option=${encodeURIComponent(opt.id)}`;
        ctaBtn.textContent = opt.ctaLabel;
      }
      if (ctaNote) ctaNote.textContent = opt.ctaNote;

      // 5. Trip Info cards
      const tripSection = document.getElementById('td-tripinfo-section');
      if (tripSection && tripSection.dataset.tripInfo) {
        const tripData = JSON.parse(tripSection.dataset.tripInfo);
        const items = tripData[id] || tripData['default'] || [];
        const grid = document.getElementById('td-tripinfo-grid');
        if (grid && items.length) {
          grid.innerHTML = items.map((item: any) => `
            <div class="td-tripinfo__card">
              <div class="td-tripinfo__icon-wrap">
                <i class="ti ti-${item.icon}" aria-hidden="true"></i>
              </div>
              <div>
                <p class="td-tripinfo__label">${item.label}</p>
                <p class="td-tripinfo__value">${item.value}</p>
              </div>
            </div>
          `).join('');
        }
      }

      // 6. Pitch swap
      const pitchSection = document.getElementById('td-pitch-section');
      if (pitchSection && pitchSection.dataset.pitch) {
        const pitchData = JSON.parse(pitchSection.dataset.pitch);
        if (pitchData[id]) {
          const headlineEl = document.getElementById('td-pitch-headline');
          const bulletList = document.getElementById('td-pitch-bullets');
          const closingEl  = document.getElementById('td-pitch-closing');
          if (headlineEl) headlineEl.textContent = pitchData[id].headline || '';
          if (bulletList) bulletList.innerHTML = (pitchData[id].bullets || []).map((b: string) => `<li>${b}</li>`).join('');
          if (closingEl)  closingEl.textContent  = pitchData[id].closingLine || '';
        }
      }

      // 7. ValueAnchor swap
      const valueSection = document.getElementById('td-value-section');
      if (valueSection && valueSection.dataset.valueAnchor) {
        const valueData = JSON.parse(valueSection.dataset.valueAnchor);
        if (valueData[id]) {
          const headlineEl  = document.getElementById('td-value-headline');
          const bodyEl      = document.getElementById('td-value-paragraphs');
          const tableBody   = document.getElementById('td-value-table-body');
          if (headlineEl) headlineEl.textContent = valueData[id].headline || '';
          if (bodyEl)     bodyEl.innerHTML = (valueData[id].paragraphs || []).map((p: string) => `<p>${p}</p>`).join('');
          if (tableBody) {
            const rows: any[] = valueData[id].compareTable || [];
            const allSame = rows.length > 1 && rows.every((r: any) => r.typical === rows[0].typical);
            const merged = allSame ? rows[0].typical : '';
            tableBody.innerHTML = rows.map((row: any, i: number) => `
              <tr>
                <td class="td-value__metric">${row.metric}</td>
                ${allSame
                  ? (i === 0 ? `<td class="td-value__bad td-value__bad--merged" rowspan="${rows.length}">${merged}</td>` : '')
                  : `<td class="td-value__bad">${row.typical}</td>`
                }
                <td class="td-value__good">${row.us}</td>
              </tr>
            `).join('');
          }
        }
      }

      // 8. Toggle body class — CSS handles show/hide of duration-specific elements
      document.body.classList.remove('dur-2d1n', 'dur-3d2n');
      if (id === '2d1n') document.body.classList.add('dur-2d1n');
      if (id === '3d2n') document.body.classList.add('dur-3d2n');

      // 9. Cabin upgrade — only show for Hanoi options (pickup-vehicle mode)
      //    vehicle-only mode always shows cabin block (never hide/show here)
      const cabinSection = document.getElementById('td-cabin-section');
      if (cabinSection && selectorMode !== 'vehicle-only') {
        const isHanoiOption = (id === 'hanoi-car' || id === 'hanoi-motor');
        cabinSection.style.display = isHanoiOption ? '' : 'none';
        if (!isHanoiOption) {
          // Switching away from Hanoi — uncheck cabin, show base price
          const check = document.getElementById('td-cabin-check') as HTMLInputElement | null;
          if (check) check.checked = false;
          updatePriceDisplay(opt.price, opt.priceVND ?? null, false, 0, 0);
        } else {
          // Switching between hanoi-car ↔ hanoi-motor while cabin may be checked
          const check = document.getElementById('td-cabin-check') as HTMLInputElement | null;
          const surchargeUSD = Number(cabinSection.dataset.surchargeUsd || 8);
          const surchargeVND = Number(cabinSection.dataset.surchargeVnd || 0);
          updatePriceDisplay(opt.price, opt.priceVND ?? null, check?.checked ?? false, surchargeUSD, surchargeVND);
        }
      }
    }

    // ── Price display helper ────────────────────────────
    function updatePriceDisplay(baseUSD: number | null, baseVND: number | null, cabinOn: boolean, surchargeUSD: number, surchargeVND: number) {
      const priceEl      = document.getElementById('td-price-amount');
      const priceVndEl   = document.getElementById('td-price-vnd');
      const priceDisplay = document.getElementById('td-price-display');
      if (baseUSD == null) { if (priceDisplay) priceDisplay.style.display = 'none'; return; }
      if (priceDisplay) priceDisplay.style.display = '';
      const totalUSD = baseUSD + (cabinOn ? surchargeUSD : 0);
      if (priceEl) priceEl.textContent = `$${totalUSD}`;
      if (priceVndEl && baseVND != null) {
        const totalVND = baseVND + (cabinOn ? surchargeVND : 0);
        priceVndEl.textContent = `${totalVND.toLocaleString('vi-VN')} VND`;
      }
    }

    // ── Cabin checkbox listener ─────────────────────────
    (() => {
      const cabinCheck   = document.getElementById('td-cabin-check') as HTMLInputElement | null;
      const cabinLabel   = document.getElementById('td-cabin-label');
      const cabinSection = document.getElementById('td-cabin-section');
      if (!cabinCheck || !cabinSection) return;

      const surchargeUSD = Number(cabinSection.dataset.surchargeUsd || 8);
      const surchargeVND = Number(cabinSection.dataset.surchargeVnd || 0);

      cabinCheck.addEventListener('change', () => {
        const isOn = cabinCheck.checked;
        if (cabinLabel) cabinLabel.textContent = isOn ? 'Private cabin (upgraded)' : 'Standard sleeper bus';

        const activeId   = resolveId();
        const rawOptions = document.getElementById('td-product-panel')?.dataset.durationOptions;
        if (!rawOptions) return;
        const opts = JSON.parse(rawOptions);
        const opt  = opts.find((o: any) => o.id === activeId);
        if (opt) updatePriceDisplay(opt.price, opt.priceVND ?? null, isOn, surchargeUSD, surchargeVND);
      });
    })();

    // Duration tab listeners
    if (selectorMode === 'duration-tabs') {
      document.querySelectorAll('.td-dur-tab').forEach((btn) => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.td-dur-tab').forEach(b => b.classList.remove('is-active'));
          btn.classList.add('is-active');
          switchDuration(resolveId());
        });
      });
    }

    // ── Pax-tier: individual-number options, price mapped from min/max ranges ──
    function findTierForPax(tiers: any[], pax: number) {
      return tiers.find((t: any) => pax >= t.min && pax <= t.max) ?? null;
    }

    function rebuildPaxOptions(opt: any) {
      if (!selPax || !opt.paxTiers) return;
      const maxPax   = Math.max(...opt.paxTiers.map((t: any) => t.max));
      const prevVal  = parseInt(selPax.value, 10) || 3;
      const newVal   = Math.min(Math.max(prevVal, 1), maxPax);
      selPax.innerHTML = Array.from({ length: maxPax }, (_, i) => i + 1)
        .map(n => `<option value="${n}"${n === newVal ? ' selected' : ''}>${n} ${n === 1 ? 'person' : 'people'}</option>`)
        .join('');
    }

    function applyPaxTier(opt: any) {
      if (!selPax || !opt.paxTiers) {
        if (paxNoteEl) paxNoteEl.hidden = true;
        return;
      }
      const pax  = parseInt(selPax.value, 10) || 3;
      const tier = findTierForPax(opt.paxTiers, pax);
      if (!tier) return;
      updatePriceDisplay(tier.price, tier.priceVND ?? null, false, 0, 0);
      if (paxNoteEl) {
        if (tier.note) {
          paxNoteEl.textContent = tier.note;
          paxNoteEl.hidden = false;
        } else {
          paxNoteEl.hidden = true;
        }
      }
    }

    // Dropdown listeners — re-selectable at any time
    selVehicleOnly?.addEventListener('change', () => {
      const id = resolveId();
      switchDuration(id);
      const opt = durationOptions.find((o: any) => o.id === id);
      if (opt) { rebuildPaxOptions(opt); applyPaxTier(opt); }
    });
    selPax?.addEventListener('change', () => {
      const id  = resolveId();
      const opt = durationOptions.find((o: any) => o.id === id);
      if (opt) applyPaxTier(opt);
    });
    selPickup?.addEventListener('change',  () => switchDuration(resolveId()));
    selVehicle?.addEventListener('change', () => switchDuration(resolveId()));

    // Init on page load — sync UI state to default dropdown values
    {
      const initId  = resolveId();
      switchDuration(initId);
      const initOpt = durationOptions.find((o: any) => o.id === initId);
      if (initOpt) {
        rebuildPaxOptions(initOpt);   // populate numbers first
        if (selPax && !selPax.value) selPax.value = '3'; // default to 3 people
        applyPaxTier(initOpt);
      }
    }
  })();

  // ── Sticky bar: show after hero CTA scrolls out of view ──────────
  (() => {
    const stickyBar = document.getElementById('td-sticky-bar');
    const heroCta   = document.getElementById('td-cta-btn') || document.querySelector('.td-product__cta');
    if (!stickyBar || !heroCta) return;

    let footerVisible  = false;
    let heroCtaHidden  = false;

    const observer = new IntersectionObserver(
      ([entry]) => {
        heroCtaHidden = !entry.isIntersecting;
        if (entry.isIntersecting) {
          stickyBar.classList.remove('is-visible');
          stickyBar.setAttribute('aria-hidden', 'true');
        } else {
          if (!footerVisible) {
            stickyBar.classList.add('is-visible');
            stickyBar.setAttribute('aria-hidden', 'false');
          }
        }
      },
      { threshold: 0, rootMargin: '0px 0px -20px 0px' }
    );

    observer.observe(heroCta);

    const footer = document.querySelector('.site-footer2') as Element | null;
    if (footer) {
      const footerObserver = new IntersectionObserver(
        ([entry]) => {
          footerVisible = entry.isIntersecting;
          if (footerVisible) {
            stickyBar.classList.remove('is-visible');
            stickyBar.setAttribute('aria-hidden', 'true');
          } else if (heroCtaHidden) {
            stickyBar.classList.add('is-visible');
            stickyBar.setAttribute('aria-hidden', 'false');
          }
        },
        { threshold: 0 }
      );
      footerObserver.observe(footer);
    }
  })();
</script>

<script>
  document.querySelectorAll<HTMLElement>('[data-dslider]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('.td-dslider__track');
    const dots = Array.from(root.querySelectorAll<HTMLElement>('.td-dslider__dot'));
    if (!track) return;
    const go = (dir: number) => track.scrollBy({ left: dir * track.clientWidth, behavior: 'smooth' });
    root.querySelector('.td-dslider__btn--prev')?.addEventListener('click', () => go(-1));
    root.querySelector('.td-dslider__btn--next')?.addEventListener('click', () => go(1));
    track.addEventListener('scroll', () => {
      const i = Math.round(track.scrollLeft / Math.max(1, track.clientWidth));
      dots.forEach((d, n) => d.classList.toggle('is-active', n === i));
    }, { passive: true });
  });
</script>
