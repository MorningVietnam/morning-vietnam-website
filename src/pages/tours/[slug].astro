    box-shadow: var(--shadow-sm);
    pointer-events: none;
  }

  .td-routemap__rotatehint.is-visible {
    display: flex;
  }

  /* Give MapLibre's own rotate/compass control (created by its JS, not our
     template — hence :global()) a visible highlight ring + a slow pulse so
     it reads as "drag me" rather than blending in with the plain +/- zoom
     buttons right above it. */
  @keyframes td-compass-pulse {
    0%, 100%  { box-shadow: 0 0 0 2px var(--color-java); }
    50%       { box-shadow: 0 0 0 5px rgba(29, 160, 160, 0.35); }
  }

  :global(.maplibregl-ctrl-compass) {
    border-radius: 4px;
    animation: td-compass-pulse 2.2s ease-in-out infinite;
  }

  /* These marker elements are created client-side via document.createElement
     (by Leaflet's L.divIcon and by MapLibre's Marker) — Astro's scoped CSS
     tags every rule below with a [data-astro-cid-*] attribute that only
     elements present in this file's own template actually carry, so a plain
     scoped rule NEVER matches a marker built in plain JS at runtime (the
     marker exists and is positioned correctly, just invisible — no size, no
     colour, nothing). :global() opts these specific rules out of that
     scoping so they apply to the real DOM regardless of how it was built. */

  /* Leaflet's default .leaflet-div-icon ships a white box + grey border —
     strip that so only our own circle shows. */
  :global(.td-routemap__marker.leaflet-div-icon) {
    background: transparent;
    border: none;
  }

  /* MapLibre gives marker elements no size of their own — as a block-level
     <div> it stretches to the map's full width, which throws off MapLibre's
     -50%/-50% centering transform and pushes the dot off-screen entirely.
     inline-block shrinks it back to the size of the dot it wraps. */
  :global(.td-routemap__marker) {
    display: inline-block;
  }

  :global(.td-routemap__marker-dot) {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--color-java);
    color: white;
    box-shadow: 0 2px 8px rgba(4,51,65,0.35), 0 0 0 3px white;
    font-size: 15px;
  }

  /* One colour per marker kind, on top of one icon per kind (set in JS) —
     the two together make all 4 markers easy to tell apart at a glance. */
  :global(.td-routemap__marker--start)   :global(.td-routemap__marker-dot) { background: var(--color-java); }
  :global(.td-routemap__marker--summit)  :global(.td-routemap__marker-dot) { background: var(--color-sorbus); }
