    opacity: 0.6;
    font-size: 15px;
    line-height: 1.6;
  }

  /* ── td-timeline activity cards ─────────────────── */
  .td-timeline__cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 16px;
    margin-top: 40px;
  }

  .td-timeline__act-card {
    background: white;
    border-radius: 12px;
    padding: 22px 20px;
    border-left: 4px solid var(--color-java);
    box-shadow: 0 2px 12px rgba(4,51,65,0.06);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .td-timeline__act-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 24px rgba(4,51,65,0.10);
  }

  .td-timeline__act-card.is-highlight { border-left-color: var(--color-sorbus); }

  .td-timeline__act-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 10px;
  }

  .td-timeline__act-badge {
    display: inline-block;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 3px 10px;
    border-radius: 12px;
  }

  /* Badge color per type */
  .td-timeline__act-badge--history       { background: rgba(4,51,65,0.08); color: var(--color-nordic); }
  .td-timeline__act-badge--meal          { background: #fde8d8; color: #8b3a10; }
  .td-timeline__act-badge--challenge     { background: #e8f5e9; color: #2e7d32; }
  .td-timeline__act-badge--hiking        { background: var(--color-light-cyan); color: var(--color-nordic); }
  .td-timeline__act-badge--accommodation { background: #ede7f6; color: #4527a0; }
  /* Fallbacks for old data */
  .td-timeline__act-badge--trek    { background: var(--color-light-cyan); color: var(--color-nordic); }
  .td-timeline__act-badge--food    { background: #fde8d8; color: #8b3a10; }
  .td-timeline__act-badge--culture { background: rgba(4,51,65,0.08); color: var(--color-nordic); }
  .td-timeline__act-badge--free    { background: #e8f5e9; color: #2e7d32; }

  .td-timeline__act-time {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-java);
    margin-bottom: 6px;
  }

  .td-timeline__act-time.is-highlight { color: var(--color-sorbus); }

  .td-timeline__act-title {
    font-family: var(--font-heading);
    font-size: 16px;
    font-weight: 700;
    color: var(--color-nordic);
    line-height: 1.3;
    margin-bottom: 8px;
  }

  .td-timeline__act-desc {
    font-size: 13px;
    line-height: 1.6;
    color: var(--color-nordic);
    opacity: 0.7;
  }

  /* ── S5 td-audience ──────────────────────────────── */
  .td-audience {
    background: var(--color-light-cyan);
    padding: 60px 0;
  }

  .td-audience__inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 48px;
  }

  .td-audience__label {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-java);
    margin-bottom: 16px;
  }

  .td-audience__heading {
    font-family: var(--font-heading);
    font-size: clamp(32px, 4.5vw, 56px);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--color-nordic);
    margin-bottom: 56px;
  }

  .td-audience__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }

  .td-audience__card {
    background: white;
    border-radius: 20px;
    padding: 36px 28px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .td-audience__card:hover {
    transform: translateY(-6px);
    box-shadow: 0 16px 40px rgba(4, 51, 65, 0.12);
  }

  .td-audience__icon {
    font-size: 36px;
    line-height: 1;
    margin-bottom: 4px;
  }

  .td-audience__card-title {
    font-family: var(--font-heading);
    font-size: 18px;
    font-weight: 700;
    color: var(--color-nordic);
    line-height: 1.2;
  }

  .td-audience__card-desc {
    font-size: 14px;
    line-height: 1.65;
    color: var(--color-nordic);
    opacity: 0.75;
  }

  /* ── Responsive ─────────────────────────────────── */
  @media (max-width: 960px) {
    .td-product__inner         { grid-template-columns: 1fr; }
    .td-product__gallery       { min-height: unset; padding: 20px 0 0; }
    .td-product__main-image    { flex: none; aspect-ratio: 1660/1480; margin: 0 auto; width: calc(100% - 40px); border-radius: 20px; }
    .td-product__thumbs        { display: grid; grid-template-columns: repeat(5, 1fr); gap: 8px; padding: 20px 0 16px; width: calc(100% - 40px); margin: 0 auto; flex-wrap: unset; }
    .td-product__thumb         { width: 100%; height: auto; aspect-ratio: 1/1; }
    .td-gallery__arrow         { width: 30px; height: 30px; }
    .td-product__panel         { padding: 40px 24px; }
    .td-overview__inner        { grid-template-columns: 1fr; gap: 48px; padding: 0 24px; }
    .td-overview               { padding: 40px 0 30px; }
    .td-timeline__inner        { padding: 0 24px; }
    .td-timeline               { padding: 40px 0; }
    .td-audience__inner        { padding: 0 24px; }
    .td-audience               { padding: 40px 0; }
    .td-audience__grid         { grid-template-columns: 1fr 1fr; }
  }

  @media (max-width: 768px) {
    .td-product__thumbs { display: none; }
  }

  @media (max-width: 480px) {
    .td-product__heading { font-size: 36px; }
    .td-product__price   { font-size: 28px; }
    .td-audience__grid { grid-template-columns: 1fr; }
    .td-tripinfo__grid { grid-template-columns: 1fr; }
    :global(.td-tripinfo__icon-wrap) { width: 36px; height: 36px; }
    :global(.td-tripinfo__icon-wrap i) { font-size: 17px; }
    .td-selector__select { font-size: 14px; padding: 11px 38px 11px 14px; }
  }

  /* ── S7 td-welcome ─────────────────────────────── */
  .td-welcome {
    background: #ffffff;
    padding: 60px 0;
  }

  .td-welcome__inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 48px;
  }

  .td-welcome__heading {
    font-family: var(--font-heading);
    font-size: clamp(36px, 5vw, 64px);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--color-nordic);
    margin: 12px 0 20px;
  }

  .td-welcome__intro {
    font-size: 17px;
    line-height: 1.7;
    color: var(--color-nordic);
    opacity: 0.75;
    max-width: 640px;
    margin-bottom: 56px;
  }

  .td-welcome__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 20px;
  }

  .td-welcome__card {
    background: var(--color-light-cyan);
    border-radius: 16px;
    padding: 24px 20px;
    text-align: center;
    border-top: 4px solid #a08f1d;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .td-welcome__card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 32px rgba(4,51,65,0.10);
  }

  .td-welcome__icon { font-size: 36px; margin-bottom: 12px; }

  .td-welcome__name {
    font-family: var(--font-heading);
    font-size: 14px;
    font-weight: 700;
    color: #413d04;
    margin-bottom: 8px;
  }

  .td-welcome__why {
    font-size: 12px;
    line-height: 1.55;
    color: rgba(65,61,4,0.7);
  }

  .td-welcome__card-img {
    border-radius: 16px;
    overflow: hidden;
    aspect-ratio: 3 / 4;
  }

  .td-welcome__card-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  @media (max-width: 768px) {
    .td-welcome__inner { padding: 0 24px; }
    .td-welcome__grid  { grid-template-columns: repeat(2, 1fr); }
    .td-welcome        { padding: 40px 0; }
  }

  /* ── S6 td-unlock ──────────────────────────────── */
  .td-unlock {
    background: var(--color-nordic);
    padding: 60px 0;
  }

  .td-unlock__inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 48px;
  }

  .td-unlock .section-label { color: var(--color-sorbus); }

  .td-unlock__heading {
    font-family: var(--font-heading);
    font-size: clamp(40px, 5.5vw, 72px);
    font-weight: 700;
    line-height: 1.0;
    letter-spacing: -0.025em;
    color: var(--color-riptide);
    margin: 12px 0 20px;
  }

  .td-unlock__intro {
    font-size: 17px;
    line-height: 1.7;
    color: rgba(217,247,245,0.78);
    max-width: 640px;
    margin-bottom: 56px;
  }

  .td-unlock__cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin-bottom: 32px;
  }

  .td-unlock__card {
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(217,247,245,0.14);
    border-radius: 16px;
    padding: 32px 28px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .td-unlock__num {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--color-sorbus);
    color: white;
    font-family: var(--font-heading);
    font-size: 18px;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .td-unlock__card-title {
    font-family: var(--font-heading);
    font-size: 19px;
    font-weight: 700;
    color: var(--color-riptide);
    line-height: 1.2;
  }

  .td-unlock__card-desc {
    font-size: 14px;
    line-height: 1.65;
    color: rgba(217,247,245,0.72);
  }

  .td-unlock__note {
    background: rgba(255,255,255,0.05);
    border-left: 3px solid var(--color-sorbus);
    border-radius: 0 12px 12px 0;
    padding: 20px 24px;
    margin-bottom: 28px;
  }

  .td-unlock__note p {
    font-size: 14px;
    line-height: 1.65;
    color: rgba(217,247,245,0.7);
    font-style: italic;
  }

  .td-unlock__teaser {
    font-family: var(--font-heading);
    font-size: 16px;
    font-weight: 600;
    color: rgba(217,247,245,0.45);
    letter-spacing: 0.02em;
  }

  @media (max-width: 900px) {
    .td-unlock__cards { grid-template-columns: 1fr; }
  }

  @media (max-width: 768px) {
    .td-unlock        { padding: 40px 0; }
    .td-unlock__inner { padding: 0 24px; }
  }

  /* ── S9 td-season ───────────────────────────────── */
  .td-season {
    background: var(--color-light-cyan);
    padding: 60px 0;
  }

  .td-season__inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 48px;
  }

  .td-season__heading {
    font-family: var(--font-heading);
    font-size: clamp(36px, 5vw, 64px);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--color-nordic);
    margin: 12px 0 16px;
  }

  .td-season__intro {
    font-size: 16px;
    line-height: 1.7;
    color: var(--color-nordic);
    opacity: 0.75;
    margin-bottom: 40px;
  }

  .td-season__bar {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 6px;
    margin-bottom: 24px;
  }

  .td-season__month {
    padding: 16px 4px;
    border-radius: 8px;
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 18px;
  }

  .td-season__month-label {
    font-family: var(--font-heading);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.06em;
  }

  .td-season__month--best { background: var(--color-java);    color: white; }
  .td-season__month--good { background: var(--color-riptide); color: var(--color-nordic); }
  .td-season__month--wet  { background: rgba(4,51,65,0.12);   color: rgba(4,51,65,0.55); }

  .td-season__legend {
    display: flex;
    gap: 28px;
    font-size: 13px;
    color: var(--color-nordic);
    margin-bottom: 40px;
    flex-wrap: wrap;
  }

  .td-season__dot {
    width: 12px;
    height: 12px;
    border-radius: 3px;
    display: inline-block;
    margin-right: 8px;
    vertical-align: middle;
  }

  .td-season__dot--best { background: var(--color-java); }
  .td-season__dot--good { background: var(--color-riptide); }
  .td-season__dot--wet  { background: rgba(4,51,65,0.25); }

  .td-season__notes {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }

  .td-season__note {
    background: white;
    border-radius: 12px;
    padding: 20px 24px;
    border-left: 4px solid var(--color-java);
  }

  .td-season__note--wet { border-left-color: #4a90d9; }

  .td-season__note h4 {
    font-family: var(--font-heading);
    font-size: 15px;
    font-weight: 700;
    color: var(--color-nordic);
    margin-bottom: 8px;
  }

  .td-season__note p {
    font-size: 13px;
    line-height: 1.65;
    color: var(--color-nordic);
    opacity: 0.75;
  }

  @media (max-width: 960px) {
    .td-season__inner { padding: 0 24px; }
    .td-season__bar   { grid-template-columns: repeat(6, 1fr); }
    .td-season__notes { grid-template-columns: 1fr; }
    .td-season        { padding: 40px 0; }
  }

  /* ── S7 td-reviews ──────────────────────────────── */
  .td-reviews { display: none; }

  .td-reviews__inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 48px;
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    gap: 64px;
  }

  .td-reviews__rating {
    font-family: var(--font-heading);
    font-size: clamp(72px, 9vw, 128px);
    font-weight: 700;
    color: var(--color-nordic);
    line-height: 1;
    margin: 16px 0 8px;
  }

  .td-reviews__rating-unit { font-size: 0.4em; opacity: 0.4; font-weight: 400; }
  .td-reviews__based { font-size: 14px; color: var(--color-nordic); opacity: 0.6; margin-bottom: 32px; }

  .td-reviews__breakdown { display: flex; flex-direction: column; gap: 8px; }

  .td-reviews__row {
    display: grid;
    grid-template-columns: 32px 1fr 32px;
    gap: 12px;
    align-items: center;
    font-size: 13px;
    color: var(--color-nordic);
  }

  .td-reviews__bar { height: 6px; background: var(--color-light-cyan); border-radius: 3px; overflow: hidden; }
  .td-reviews__bar-fill { height: 100%; background: var(--color-java); }

  .td-reviews__placeholder-note {
    margin-top: 24px;
    font-size: 12px;
    color: var(--color-sorbus);
    opacity: 0.7;
    font-style: italic;
  }

  .td-reviews__right { display: flex; flex-direction: column; gap: 32px; }

  .td-review {
    border-bottom: 1px solid rgba(4,51,65,0.1);
    padding-bottom: 32px;
  }

  .td-review:last-child { border-bottom: none; }
  .td-review__rating { font-size: 14px; letter-spacing: 0.16em; color: var(--color-sorbus); margin-bottom: 12px; }
  .td-review__quote { font-size: 17px; line-height: 1.65; color: var(--color-nordic); margin-bottom: 14px; }
  .td-review__author { font-size: 13px; color: var(--color-nordic); opacity: 0.7; }
  .td-review__author em { opacity: 0.5; }

  /* ── S8 td-cta ──────────────────────────────────── */
  .td-cta {
    position: relative;
    min-height: 70vh;
    overflow: hidden;
    display: flex;
    align-items: center;
  }

  .td-cta__image { position: absolute; inset: 0; z-index: 1; }
  .td-cta__image img { width: 100%; height: 100%; object-fit: cover; }

  .td-cta__overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
    background: linear-gradient(to right, rgba(4,51,65,0.85) 0%, rgba(4,51,65,0.45) 70%, transparent 100%);
  }

  .td-cta__content {
    position: relative;
    z-index: 3;
    max-width: 640px;
    margin-left: max(48px, calc((100vw - var(--max-width)) / 2 + 48px));
    padding: 80px 24px;
    color: white;
  }

  .td-cta__quote {
    font-family: var(--font-heading);
    font-size: clamp(48px, 7vw, 96px);
    font-weight: 700;
    line-height: 0.95;
    letter-spacing: -0.025em;
    margin-bottom: 24px;
  }

  .td-cta__sub {
    font-size: 18px;
    line-height: 1.6;
    opacity: 0.85;
    margin-bottom: 36px;
    max-width: 460px;
  }

  @media (max-width: 960px) {
    .td-unlock__content { padding: 64px 24px; margin: 0; }
    .td-reviews__inner  { grid-template-columns: 1fr; gap: 48px; padding: 0 24px; }
    .td-cta__content    { margin-left: 0; padding: 64px 24px; }
  }

  /* ── S9 td-faq ──────────────────────────────────── */
  .td-faq { background: var(--color-white, #fff); padding: 60px 0; }

  .td-faq__inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 48px;
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    gap: 80px;
    align-items: start;
  }

  .td-faq__heading {
    font-family: var(--font-heading);
    font-size: clamp(36px, 5vw, 64px);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--color-nordic);
    margin: 12px 0 16px;
  }

  .td-faq__sub { font-size: 15px; color: var(--color-nordic); opacity: 0.7; }
  .td-faq__sub a { color: var(--color-java); font-weight: 600; text-decoration: underline; }

  .td-faq__item {
    border-bottom: 1px solid rgba(4,51,65,0.15);
    padding: 24px 0;
  }

  .td-faq__item:first-child { border-top: 1px solid rgba(4,51,65,0.15); }

  .td-faq__item summary {
    font-family: var(--font-heading);
    font-size: 18px;
    font-weight: 600;
    color: var(--color-nordic);
    cursor: pointer;
    list-style: none;
    position: relative;
    padding-right: 32px;
  }

  .td-faq__item summary::-webkit-details-marker { display: none; }

  .td-faq__item summary::after {
    content: '+';
    position: absolute;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    font-size: 24px;
    color: var(--color-java);
    transition: transform 0.2s ease;
  }

  .td-faq__item[open] summary::after { content: '−'; }

  .td-faq__answer {
    margin-top: 12px;
    font-size: 15px;
    line-height: 1.75;
    color: var(--color-nordic);
    opacity: 0.8;
  }

  /* ── S10 td-departures ──────────────────────────── */
  .td-departures {
    background: var(--color-nordic);
    padding: 48px 0;
  }
  .td-departures__inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 48px;
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: 80px;
    align-items: start;
  }
  .td-departures__heading {
    font-family: var(--font-heading);
    font-size: clamp(24px, 3vw, 38px);
    font-weight: 700;
    color: var(--color-light-cyan);
    line-height: 1.15;
    margin: 8px 0 16px;
  }
  .td-departures__sub {
    font-size: 14px;
    line-height: 1.7;
    color: rgba(217,247,245,0.65);
    margin-bottom: 28px;
    max-width: 340px;
  }
  .td-departures__cta {
    display: inline-block;
    background: var(--color-sorbus);
    color: #fff;
    font-family: var(--font-heading);
    font-size: 14px;
    font-weight: 700;
    padding: 12px 24px;
    border-radius: 100px;
    text-decoration: none;
    letter-spacing: 0.02em;
    transition: opacity 0.2s;
  }
  .td-departures__cta:hover { opacity: 0.88; }
  .td-departures__list {
    display: flex;
    flex-direction: column;
    gap: 0;
    border: 1px solid rgba(217,247,245,0.15);
    border-radius: 16px;
    overflow: hidden;
  }
  .td-departures__item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px 28px;
    border-bottom: 1px solid rgba(217,247,245,0.1);
    transition: background 0.2s;
  }
  .td-departures__item:last-child { border-bottom: none; }
  .td-departures__item:hover { background: rgba(217,247,245,0.06); }
  .td-departures__date {
    font-family: var(--font-heading);
    font-size: 18px;
    font-weight: 600;
    color: var(--color-light-cyan);
  }
  .td-departures__book {
    font-size: 13px;
    font-weight: 600;
    color: var(--color-sorbus);
    text-decoration: none;
    letter-spacing: 0.02em;
    transition: opacity 0.2s;
