  .td-product__thumb.active { border-color: var(--color-nordic); }
  .td-product__thumb:hover  { transform: translateY(-2px); }
  .td-product__thumb img    { width: 100%; height: 100%; object-fit: cover; }

  .td-product__photo-pending {
