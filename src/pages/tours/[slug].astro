---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NotifyPopup from '../../components/NotifyPopup.astro';
import { tours } from '../../data/tours.ts';

export function getStaticPaths() {
  return tours.map(tour => ({ params: { slug: tour.slug }, props: { tour } }));
}

const { tour } = Astro.props;

if (tour.comingSoon) {
  return Astro.redirect('/tours');
}

const galleryItems = tour.gallery && tour.gallery.length > 0
  ? tour.gallery
  : [{ src: tour.image, alt: tour.name }];

const hasDurationOptions = tour.durationOptions && tour.durationOptions.length >= 1;
const selectorMode: string = (tour as any).selectorMode ?? 'pickup-vehicle';

const pitch = tour.pitch;
const hasDurationPitch = pitch && typeof pitch === 'object' && !('headline' in (pitch as any)) && !Array.isArray(pitch);
const firstDurKey: string = (tour.durationOptions as any)?.[0]?.id || '1day';
const pitchDefault: any = hasDurationPitch
  ? ((pitch as any)[firstDurKey] ?? Object.values(pitch as any)[0])
  : pitch;

const hasDurationValue = tour.valueAnchor && typeof tour.valueAnchor === 'object' && !('headline' in (tour.valueAnchor as any));
const valueAnchorObj: any = hasDurationValue
  ? ((tour.valueAnchor as any)[firstDurKey] ?? Object.values(tour.valueAnchor as any)[0])
  : tour.valueAnchor;
const valueAnchor: any = valueAnchorObj?.headline ? valueAnchorObj : null;

const compareRows: any[] = valueAnchor?.compareTable || [];
const allTypicalSame = compareRows.length > 1 && compareRows.every((r: any) => r.typical === compareRows[0].typical);
const mergedTypical: string = allTypicalSame ? compareRows[0].typical : '';

const overview     = tour.storytelling;
const elevation    = tour.elevationProfile;
const elevMax: number = (tour as any).elevationMax ?? 1500;
const isMultiDay: boolean = !!(elevation && elevation.some((p: any) => (p.day ?? 0) > 1));
const activityCards = tour.activityCards;
const welcomePack  = tour.welcomePack;
const unlock       = tour.unlockChallenge;
const season       = tour.seasonality;
const faqs         = tour.faqs;
const upcomingDates = (tour as any).upcomingDates as string[] | undefined;

function fmtDate(iso: string) {
  return new Date(iso + 'T12:00:00').toLocaleDateString('en-GB', { weekday: 'short', day: 'numeric', month: 'short' });
}

// Helper cho journey card images — tách ra khỏi template vì
// Astro compiler bị bug khi arrow function trong JSX có block body
// chứa `const` + `return` (Unexpected "const" tại esbuild transform).
function dayImgs(d: any) {
  return (d.images && d.images.length > 0)
    ? d.images
    : [1, 2, 3].map((n) => ({ src: '/tours/multi-activity/placeholder.webp', alt: `Day ${d.day} photo ${n} — coming soon` }));
}

// Trekking-specific modules (only present on hiking/trekking tours)
const tripGrading  = (tour as any).tripGrading || null;
const safetyInfo   = (tour as any).safetyInfo || null;
const packingList  = (tour as any).packingList || null;
const itineraryDays = tour.itinerary || null;
const useDayCards  = !!(itineraryDays && itineraryDays.some((d: any) => d.narrative));
const gpxFile      = (tour as any).gpxFile || null;
// Waypoints for the GPX route map — 4 distinct markers (start/summit/shelter/end),
// one map icon each. This used to be hardcoded here for Putaleng only; now it's
// per-tour data from tours.ts (`routeMarkers`) so each trekking tour's map shows
// its own real coordinates instead of accidentally reusing Putaleng's.
const routeMarkers = gpxFile ? ((tour as any).routeMarkers || null) : null;
// Optional per-day line colours: one entry per <trk> in the GPX, in order. When absent
// (every tour before Ky Quan San) the whole track is drawn as one orange line, as before.
const routeDays    = gpxFile ? ((tour as any).routeDays || null) : null;
// Gated on tripGrading (not just the "hiking" tag) so the new trekking layout
// only appears on tours that have opted in with the new data — keeps
// Fansipan etc. untouched until they're upgraded too.
const isTrekkingTour = !!tripGrading;
// privateRoute: deliberately don't publish the exact route → hide the route-map
// section and the elevation chart (and their "pending" placeholders).
const privateRoute   = !!(tour as any).privateRoute;
const journeyParts: any = (tour as any).journeyParts || null;
const showChart      = !!(elevation && elevation.length > 0 && !journeyParts);

const tripInfoData   = (tour.tripInfo as any) || null;
const hasTripInfo    = !!tripInfoData;
const defaultTripKey = (tour.durationOptions as any)?.[0]?.id || 'default';
const defaultTripItems: any[] = hasTripInfo
  ? (tripInfoData[defaultTripKey] || tripInfoData['default'] || [])
  : [];

const cabinUpgrade    = (tour as any).cabinUpgrade || null;
const discountPolicy  = (tour as any).discountPolicy || null;
const panoramicImage  = (tour as any).panoramicImage || null;

// Sticky CTA data
const ctaPrice     = tour.durationOptions ? tour.durationOptions[0].price : (tour as any).priceUSD;
const ctaPriceVND  = tour.durationOptions ? (tour.durationOptions[0] as any).priceVND ?? null : (tour as any).priceVND ?? null;
const ctaWaText    = tour.durationOptions ? tour.durationOptions[0].waText : '';
const firstOptionId  = tour.durationOptions?.[0]?.id ?? '';
const ctaContactLink = `/contact?tour=${encodeURIComponent(tour.name)}${firstOptionId ? `&option=${firstOptionId}` : ''}`;
---

<BaseLayout title={tour.name} description={tour.tagline} navTheme="on-cyan">

  <!-- ═══ S1 · b-product (split hero) ════════════════════════════ -->
  <section class="td-product page-offset">
    <div class="td-product__inner">

      <!-- Left: Image gallery -->
      <div class="td-product__gallery">
        {tour.gallery && tour.gallery.length > 0 ? (
          <>
            <div class="td-product__main-image">
              <img id="td-main-img" class="td-main-img is-active" src={galleryItems[0].src} alt={galleryItems[0].alt} fetchpriority="high" />
              <img id="td-main-img-b" class="td-main-img" src={galleryItems[0].src} alt="" aria-hidden="true" />
              {galleryItems.length > 1 && (
                <div class="td-gallery__nav">
                  <button id="td-prev" class="td-gallery__arrow" aria-label="Previous image">
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                      <path d="M10 3L5 8L10 13" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </button>
                  <button id="td-next" class="td-gallery__arrow" aria-label="Next image">
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                      <path d="M6 3L11 8L6 13" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </button>
                </div>
              )}
            </div>
            <div class="td-product__thumbs">
              {galleryItems.map((g, i) => (
                <button
                  class={`td-product__thumb${i === 0 ? ' active' : ''}`}
                  data-src={g.src}
                  data-alt={g.alt}
                  aria-label={`Image ${i + 1}`}
                >
                  <img src={g.src} alt={g.alt} loading="lazy" />
                </button>
              ))}
            </div>
          </>
        ) : (
          <div class="td-product__photo-pending">
            <div class="td-product__photo-pending-icon">📷</div>
            <strong>PHOTO PENDING</strong>
            <p>Hero gallery for {tour.name}. Brief: 4–6 wide shots showing the route, activities, and people. Candid moments preferred over posed.</p>
          </div>
        )}
      </div>

      <!-- Right: Purchase panel -->
      <div class="td-product__panel" id="td-product-panel" data-duration-options={hasDurationOptions ? JSON.stringify(tour.durationOptions) : ''} data-tour-name={tour.name}>
        <p class="td-product__eyebrow">
          {tour.region === 'north' ? 'NORTH VIETNAM' : tour.region === 'central' ? 'CENTRAL VIETNAM' : tour.region === 'soon' ? 'Coming soon' : tour.region.toUpperCase()}
          &nbsp;·&nbsp;{tour.duration.join(' / ')}
        </p>
        <h1 class="td-product__heading">{tour.name}</h1>
        {(tour as any).subtitle && (
          <p class="td-product__subtitle">{(tour as any).subtitle}</p>
        )}

        {hasDurationOptions ? (
          <>
            <!-- Selector: duration-tabs OR vehicle-only (1 dropdown) OR pickup-vehicle (2 dropdowns) -->
            <div class="td-selector" id="td-selector"
              data-selector-mode={selectorMode}
              data-duration-options={JSON.stringify(tour.durationOptions)}>

              {selectorMode === 'duration-tabs' ? (
                /* ── Duration tabs: 1 Day / 2D1N / 3D2N ── */
                <div class="td-dur-tabs" id="td-dur-tabs">
                  {tour.durationOptions.map((opt: any, i: number) => (
                    <button
                      class={`td-dur-tab${i === 0 ? ' is-active' : ''}`}
                      data-dur-id={opt.id}
                      type="button"
                    >
                      {opt.label}
                    </button>
                  ))}
                </div>
              ) : selectorMode === 'vehicle-only' ? (
                /* ── Single dropdown: choose vehicle (hidden if only 1 option) ── */
                <>
                  <div class="td-selector__q" style={tour.durationOptions.length <= 1 ? 'display:none' : ''}>
                    <label class="td-selector__label" for="td-sel-vehicle-only">
                      How do you want to explore?
                    </label>
                    <div class="td-selector__wrap">
                      <select id="td-sel-vehicle-only" class="td-selector__select">
                        {tour.durationOptions.map((opt: any) => (
                          <option value={opt.id}>{opt.label}</option>
                        ))}
                      </select>
                      <svg class="td-selector__arrow" width="16" height="16" viewBox="0 0 16 16" fill="none">
                        <path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </div>
                  </div>

                  {/* Pax-tier selector — only rendered when first option carries paxTiers */}
                  {(tour.durationOptions as any)[0]?.paxTiers && (
                    <div class="td-selector__q" id="td-sel-pax-wrap">
                      <label class="td-selector__label" for="td-sel-pax">
                        How many people in your group?
                      </label>
                      <div class="td-selector__wrap">
                        <select id="td-sel-pax" class="td-selector__select">
                          {/* JS generates individual-number options on page load */}
                        </select>
                        <svg class="td-selector__arrow" width="16" height="16" viewBox="0 0 16 16" fill="none">
                          <path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                      </div>
                    </div>
                  )}
                </>
              ) : (
                /* ── Two dropdowns: pickup × vehicle ── */
                <>
                  <div class="td-selector__q">
                    <label class="td-selector__label" for="td-sel-pickup">
                      Where are you joining us from?
                    </label>
                    <div class="td-selector__wrap">
                      <select id="td-sel-pickup" class="td-selector__select">
                        <option value="hanoi">Hanoi — Economy overnight bus included</option>
                        <option value="sapa">Sa Pa — already there</option>
                      </select>
                      <svg class="td-selector__arrow" width="16" height="16" viewBox="0 0 16 16" fill="none">
                        <path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </div>
                  </div>

                  <!-- Cabin upgrade toggle — shown inline after Q1, only for Hanoi -->
                  {cabinUpgrade && (
                    <div class="td-cabin td-cabin--inline" id="td-cabin-section" style="display:none"
                      data-surcharge-vnd={cabinUpgrade.surchargeVND}
                      data-surcharge-usd={cabinUpgrade.surchargeUSD ?? 8}>
                      <p class="td-tripinfo__section-label">Sleeper bus upgrade</p>
                      <label class="td-cabin__toggle">
                        <input type="checkbox" id="td-cabin-check" />
                        <span class="td-cabin__slider"></span>
                        <span class="td-cabin__label" id="td-cabin-label">{cabinUpgrade.labelOff}</span>
                      </label>
                      <p class="td-cabin__note" id="td-cabin-note">{cabinUpgrade.surchargeNote}</p>
                    </div>
                  )}

                  <div class="td-selector__q">
                    <label class="td-selector__label" for="td-sel-vehicle">
                      How do you want to take the pass?
                    </label>
                    <div class="td-selector__wrap">
                      <select id="td-sel-vehicle" class="td-selector__select">
                        <option value="car">By car — sit back, watch it unfold</option>
                        <option value="motor">By motorbike — earn the view</option>
                      </select>
                      <svg class="td-selector__arrow" width="16" height="16" viewBox="0 0 16 16" fill="none">
                        <path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </div>
                  </div>
                </>
              )}
            </div>

            <!-- Dynamic price -->
            {tour.durationOptions[0].price != null && (
              <div class="td-product__price" id="td-price-display">
                <span class="td-product__price-row">
                  <span id="td-price-amount">${tour.durationOptions[0].price}</span>
                  {(tour as any).priceVND && (
                    <>
                      <span class="td-product__price-sep"> / </span>
                      <span class="td-product__price-vnd" id="td-price-vnd">{((tour as any).priceVND as number).toLocaleString('vi-VN')} VND</span>
                    </>
                  )}
                </span>
                <span class="td-product__price-unit">/person</span>
              </div>
            )}
            {(tour as any).priceNote && (
              <p class="td-product__price-note">{(tour as any).priceNote}</p>
            )}

            {/* Joined-group note — shown by JS when pax tier "1-2" is selected */}
            <p class="td-product__pax-note" id="td-pax-note" hidden></p>

            <!-- Cabin upgrade — vehicle-only mode (always visible, no pickup condition) -->
            {cabinUpgrade && selectorMode === 'vehicle-only' && (
              <div class="td-cabin td-cabin--inline" id="td-cabin-section"
                data-surcharge-vnd={cabinUpgrade.surchargeVND}
                data-surcharge-usd={cabinUpgrade.surchargeUSD ?? 8}>
                <p class="td-tripinfo__section-label">Sleeper bus upgrade</p>
                <label class="td-cabin__toggle">
                  <input type="checkbox" id="td-cabin-check" />
                  <span class="td-cabin__slider"></span>
                  <span class="td-cabin__label" id="td-cabin-label">{cabinUpgrade.labelOff}</span>
                </label>
                <p class="td-cabin__note" id="td-cabin-note">{cabinUpgrade.surchargeNote}</p>
              </div>
            )}

            <!-- Next departures or tagline -->
            {upcomingDates && upcomingDates.length > 0 ? (
              <div class="td-upcoming" data-dates-wrap>
                <p class="td-upcoming__label">Next departures</p>
                <div class="td-upcoming__pills">
                  {upcomingDates.map((d: string) => (
                    <a href={`/contact?tour=${encodeURIComponent(tour.name)}&date=${encodeURIComponent(fmtDate(d))}`}
                       class="td-upcoming__pill" data-date={d}>{fmtDate(d)}</a>
                  ))}
                </div>
              </div>
            ) : (
              <p class="td-product__tagline" id="td-tagline-display">{tour.durationOptions[0].tagline}</p>
            )}

            {!tour.comingSoon ? (
              <div class="td-product__cta" id="td-cta-display">
                <a
                  href={`/contact?tour=${encodeURIComponent(tour.name)}`}
                  class="c-button c-button--primary td-product__book"
                  id="td-cta-btn"
                >
                  {tour.durationOptions[0].ctaLabel}
                </a>
                <p class="td-product__cta-note" id="td-cta-note">{tour.durationOptions[0].ctaNote}</p>
              </div>
            ) : (
              <div class="td-product__cta">
                <button class="c-button c-button--outline" data-popup-trigger="#notify-popup">
                  Notify me when live
                </button>
                <p class="td-product__cta-note">{tour.price}</p>
              </div>
            )}

            <!-- Trip Info cards -->
            {hasTripInfo && (
              <div class="td-tripinfo" id="td-tripinfo-section"
                data-trip-info={JSON.stringify(tripInfoData)}>
                <p class="td-tripinfo__section-label">Trip info</p>
                <div class="td-tripinfo__grid" id="td-tripinfo-grid">
                  {defaultTripItems.map((item: any) => (
                    <div class="td-tripinfo__card">
                      <div class="td-tripinfo__icon-wrap">
                        <i class={`ti ti-${item.icon}`} aria-hidden="true"></i>
                      </div>
                      <div>
                        <p class="td-tripinfo__label">{item.label}</p>
                        <p class="td-tripinfo__value">{item.value}</p>
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            )}

            <!-- Cabin upgrade is now rendered inside .td-selector above -->

            <!-- Discount policy -->
            {discountPolicy && (
              <div class="td-discount">
                <p class="td-tripinfo__section-label">Discounts</p>
                <ul class="td-discount__list">
                  {discountPolicy.rules.map((r: any) => (
                    <li>
                      <span class="td-discount__label">{r.label}</span>
                      <span class="td-discount__value">{r.value}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </>
        ) : (
          <>
            <div class="td-product__price">
              <span class="td-product__price-row">
                <span>{tour.priceUSD ? `$${tour.priceUSD}` : 'TBA'}</span>
                {(tour as any).priceVND && (
                  <>
                    <span class="td-product__price-sep"> / </span>
                    <span class="td-product__price-vnd">{((tour as any).priceVND as number).toLocaleString('vi-VN')} VND</span>
                  </>
                )}
              </span>
              <span class="td-product__price-unit">/person</span>
            </div>
            {upcomingDates && upcomingDates.length > 0 ? (
              <div class="td-upcoming" data-dates-wrap>
                <p class="td-upcoming__label">Next departures</p>
                <div class="td-upcoming__pills">
                  {upcomingDates.map((d: string) => (
                    <a href={`/contact?tour=${encodeURIComponent(tour.name)}&date=${encodeURIComponent(fmtDate(d))}`}
                       class="td-upcoming__pill" data-date={d}>{fmtDate(d)}</a>
                  ))}
                </div>
              </div>
            ) : (
              <p class="td-product__tagline">{tour.tagline}</p>
            )}

            {!tour.comingSoon ? (
              <div class="td-product__cta">
                <a
                  href={`/contact?tour=${encodeURIComponent(tour.name)}`}
                  class="c-button c-button--primary td-product__book"
                >
                  I'm in →
                </a>
                <p class="td-product__cta-note">No payment now. We hold your spot, you pay 14 days before. Free cancellation.</p>
              </div>
            ) : (
              <div class="td-product__cta">
                <button class="c-button c-button--outline" data-popup-trigger="#notify-popup">
                  Notify me when live
                </button>
                <p class="td-product__cta-note">{tour.price}</p>
              </div>
            )}

            <!-- Trip Info cards (single-duration tours) -->
            {hasTripInfo && (
              <div class="td-tripinfo" id="td-tripinfo-section">
                <p class="td-tripinfo__section-label">Trip info</p>
                <div class="td-tripinfo__grid" id="td-tripinfo-grid">
                  {defaultTripItems.map((item: any) => (
                    <div class="td-tripinfo__card">
                      <div class="td-tripinfo__icon-wrap">
                        <i class={`ti ti-${item.icon}`} aria-hidden="true"></i>
                      </div>
                      <div>
                        <p class="td-tripinfo__label">{item.label}</p>
                        <p class="td-tripinfo__value">{item.value}</p>
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            )}
          </>
        )}
      </div>
    </div>
  </section>

  <!-- ═══ S2 · b-marquee ═════════════════════════════════════════ -->
  <div class="b-marquee td-marquee" aria-hidden="true">
    <div class="b-marquee__track">
      {[...Array(2)].map(() => (
        <>
          <span class="b-marquee__item">All meals included<span class="b-marquee__sep">✦</span></span>
          <span class="b-marquee__item">Licensed int'l operator<span class="b-marquee__sep">✦</span></span>
          <span class="b-marquee__item">No payment upfront<span class="b-marquee__sep">✦</span></span>
          <span class="b-marquee__item">Free cancellation<span class="b-marquee__sep">✦</span></span>
          <span class="b-marquee__item">Unlock Challenge included<span class="b-marquee__sep">✦</span></span>
        </>
      ))}
    </div>
  </div>

  <!-- ═══ S3 · b-pitch (Hook storytelling) ═══════════════════════ -->
  <section class="td-pitch" id="td-pitch-section" data-pitch={hasDurationPitch ? JSON.stringify(tour.pitch) : ''}>
    <div class="td-pitch__inner">
      <p class="section-label">The pitch</p>
      <blockquote class="td-pitch__headline" id="td-pitch-headline">
        {pitchDefault?.headline || "By tonight, you'll have done things most weekenders never get to."}
      </blockquote>
      <div class="td-pitch__body">
        {(pitchDefault?.paragraphs || []).map((p: string) => <p>{p}</p>)}
        <p class="td-pitch__closing" id="td-pitch-closing">{pitchDefault?.closingLine || ''}</p>
      </div>
      <ul class="td-pitch__bullets" id="td-pitch-bullets">
        {(pitchDefault?.bullets || []).map((b: string) => <li>{b}</li>)}
      </ul>
    </div>
  </section>

  <!-- ═══ S4 · b-value (Justify the price) ═══════════════════════ -->
  {valueAnchor && (
    <section class="td-value" id="td-value-section" data-value-anchor={hasDurationValue ? JSON.stringify(tour.valueAnchor) : ''}>
      <div class="td-value__inner">
        <div class="td-value__left">
          <p class="section-label">Worth it?</p>
          <h2 class="td-value__heading" id="td-value-headline">{valueAnchor.headline}</h2>
          <div class="td-value__body" id="td-value-paragraphs">
            {(valueAnchor.paragraphs || []).map((p: string) => <p>{p}</p>)}
          </div>
        </div>
        <div class="td-value__right">
          <table class="td-value__table">
            <thead>
              <tr>
                <th></th>
                <th class="td-value__th-typical">Typical tour</th>
                <th class="td-value__th-us">Morning Vietnam</th>
              </tr>
            </thead>
            <tbody id="td-value-table-body">
              {compareRows.map((row: any, i: number) => (
                <tr>
                  <td class="td-value__metric">{row.metric}</td>
                  {allTypicalSame
                    ? (i === 0 ? <td class="td-value__bad td-value__bad--merged" rowspan={compareRows.length}>{mergedTypical}</td> : null)
                    : <td class="td-value__bad">{row.typical}</td>
                  }
                  <td class="td-value__good">{row.us}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>
  )}

  <!-- ═══ S-grading · trip difficulty grading (trekking tours only) ═══ -->
  {tripGrading && (
    <section class="td-grading">
      <div class="td-grading__inner">
        <p class="section-label">How tough is it?</p>
        <div class="td-grading__head">
          <div class="td-grading__badge">
            <span class="td-grading__badge-level">{tripGrading.level}</span>
            <span class="td-grading__badge-max">/5</span>
          </div>
          <div class="td-grading__head-text">
            <h2 class="td-grading__label">{tripGrading.label}</h2>
            <p class="td-grading__summary">{tripGrading.summary}</p>
          </div>
        </div>
        <div class="td-grading__gauge" role="img" aria-label={`Difficulty ${tripGrading.level} of 5`}>
          {Array.from({ length: 5 }, (_, i) => (
            <span class={`td-grading__gauge-seg${i < tripGrading.level ? ' is-filled' : ''}`}></span>
          ))}
        </div>
        <div class="td-grading__criteria">
          {tripGrading.criteria.map((c: any) => (
            <div class="td-grading__crit-card">
              <div class="td-grading__crit-top">
                <p class="td-grading__crit-label">{c.label}</p>
                <div class="td-grading__crit-gauge">
                  {Array.from({ length: 5 }, (_, i) => (
                    <span class={`td-grading__crit-seg${i < c.score ? ' is-filled' : ''}`}></span>
                  ))}
                </div>
              </div>
              <p class="td-grading__crit-summary">{c.summary}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ═══ S-routemap · interactive GPX route map (trekking tours) ═══ -->
  {isTrekkingTour && !privateRoute && (
    <section class="td-routemap">
      <div class="td-routemap__inner">
        <p class="section-label">Route map</p>
        <h2 class="td-routemap__heading">Where the trail actually goes.</h2>
        {gpxFile ? (
          <>
            <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css" />
            {/* Do not remove: this stylesheet is what gives every MapLibre marker
                `position: absolute` in the first place. Without it the 4 summit/
                shelter/start/end marker <div>s fall into normal document flow
                instead of being pinned to their projected map coordinate — they
                silently stack up and push the 3D map's internal container taller
                than its visible box, landing every marker off-screen below the
                fold. (Found this the hard way while debugging "markers invisible
                in 3D".) */}
            <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/maplibre-gl@4.7.1/dist/maplibre-gl.css" />

            <div class="td-routemap__toolbar">
              <div class="td-routemap__viewtoggle" role="group" aria-label="Map view">
                <button type="button" class="td-routemap__viewbtn is-active" data-view="2d">2D map</button>
                <button type="button" class="td-routemap__viewbtn" data-view="3d">3D terrain</button>
              </div>
              <p class="td-routemap__hint"><i class="ti ti-command" aria-hidden="true"></i> + scroll to zoom</p>
            </div>

            <div class="td-routemap__mapwrap">
              <div id="td-gpx-map" class="td-routemap__map" data-gpx={gpxFile} data-markers={JSON.stringify(routeMarkers)} data-days={routeDays ? JSON.stringify(routeDays) : undefined}></div>
              <div id="td-gpx-map-3d" class="td-routemap__map td-routemap__map--3d" data-gpx={gpxFile} data-markers={JSON.stringify(routeMarkers)} data-days={routeDays ? JSON.stringify(routeDays) : undefined}></div>
              <p class="td-routemap__rotatehint" id="td-rotate-hint">↻ Drag compass to rotate</p>
            </div>

            {routeDays && (
              <ul class="td-routemap__legend" aria-label="Route legend">
                {routeDays.map((d: any) => (
                  <li><span class="td-routemap__legend-swatch" style={`background:${d.color}`}></span>{d.label}</li>
                ))}
              </ul>
            )}

            <p class="td-routemap__note">Satellite imagery via Esri · actual GPS track recorded on this route</p>

            <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js"></script>
            <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/leaflet-gpx/2.2.0/gpx.min.js"></script>
            <script is:inline src="https://cdn.jsdelivr.net/npm/maplibre-gl@4.7.1/dist/maplibre-gl.js"></script>
            <script is:inline>
              (function () {
                var mapEl = document.getElementById('td-gpx-map');
                var mapEl3d = document.getElementById('td-gpx-map-3d');
                var rotateHint = document.getElementById('td-rotate-hint');
                if (!mapEl || typeof L === 'undefined' || !mapEl.dataset.gpx) return;

                var markers = {};
                try { markers = JSON.parse(mapEl.dataset.markers || '{}') || {}; } catch (e) { markers = {}; }

                /* One icon per marker kind so all 4 are easy to tell apart at a glance. */
                var MARKER_ICONS = {
                  start:   'ti-player-play-filled',
                  summit:  'ti-mountain',
                  shelter: 'ti-home',
                  end:     'ti-flag-2-filled'
                };

                function markerDotHtml(kind) {
                  return '<span class="td-routemap__marker-dot"><i class="ti ' + (MARKER_ICONS[kind] || 'ti-map-pin') + '" aria-hidden="true"></i></span>';
                }

                function markerIcon(kind) {
                  return L.divIcon({
                    className: 'td-routemap__marker td-routemap__marker--' + kind,
                    html: markerDotHtml(kind),
                    iconSize: [32, 32],
                    iconAnchor: [16, 16],
                    popupAnchor: [0, -16]
                  });
                }

                /* ── 2D map (Leaflet) ──────────────────────────────────── */
                /* Give the map a real view from frame one (roughly centred on the
                   route) — markers added before a view exists can fail to
                   position correctly on some browsers. fitBounds() below
                   re-centers precisely once the GPX has actually loaded. */
                var map = L.map(mapEl, { scrollWheelZoom: false }).setView([22.415, 103.603], 13);

                L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}', {
                  maxZoom: 18,
                  attribution: 'Tiles &copy; Esri'
                }).addTo(map);

                /* Place-name labels overlay (roads, villages, peaks) — its own pane,
                   stacked ABOVE the satellite tiles (200) but BELOW the orange GPX
                   track (overlayPane, 400) so boundary/label lines never cover it. */
                map.createPane('labelsPane');
                map.getPane('labelsPane').style.zIndex = 350;
                map.getPane('labelsPane').style.pointerEvents = 'none';
                L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/Reference/World_Boundaries_and_Places/MapServer/tile/{z}/{y}/{x}', {
                  maxZoom: 18,
                  pane: 'labelsPane'
                }).addTo(map);

                /* Optional per-day colours (tour.routeDays → data-days). One entry per
                   <trk> in the GPX file, in order. Without it we use leaflet-gpx and
                   draw the whole track as a single orange line (all older tours). */
                var dayStyles = [];
                try { dayStyles = JSON.parse(mapEl.dataset.days || '[]') || []; } catch (e) { dayStyles = []; }

                /* Read the GPX as one list of [lat, lon] points per <trk>. */
                function readTracks(xml) {
                  var doc = new DOMParser().parseFromString(xml, 'text/xml');
                  return Array.prototype.slice.call(doc.getElementsByTagName('trk')).map(function (trk) {
                    return Array.prototype.slice.call(trk.getElementsByTagName('trkpt')).map(function (pt) {
                      return [parseFloat(pt.getAttribute('lat')), parseFloat(pt.getAttribute('lon'))];
                    });
                  }).filter(function (t) { return t.length; });
                }

                if (dayStyles.length) {
                  fetch(mapEl.dataset.gpx)
                    .then(function (r) { return r.text(); })
                    .then(function (xml) {
                      var all = [];
                      readTracks(xml).forEach(function (pts, i) {
                        var style = dayStyles[i] || dayStyles[dayStyles.length - 1];
                        L.polyline(pts, { color: style.color, weight: 4, opacity: 0.95 }).addTo(map);
                        all = all.concat(pts);
                      });
                      if (all.length) map.fitBounds(L.latLngBounds(all));
                    });
                } else {
                  new L.GPX(mapEl.dataset.gpx, {
                    async: true,
                    /* We draw our own start/end/summit/shelter markers below —
                       turn off leaflet-gpx's built-in blue pins (its "markers"
                       option, not "marker_options", is what actually controls
                       whether they get created). */
                    markers: { startIcon: false, endIcon: false },
                    polyline_options: { color: '#ea6739', weight: 4, opacity: 0.9 }
                  }).on('loaded', function (e) {
                    map.fitBounds(e.target.getBounds());
                  }).addTo(map);
                }

                Object.keys(markers).forEach(function (key) {
                  var m = markers[key];
                  if (!m) return;
                  L.marker([m.lat, m.lon], { icon: markerIcon(key) })
                    .bindPopup('<strong>' + m.label + '</strong><br>' + m.desc)
                    .addTo(map);
                });

                /* Cmd/Ctrl + scroll to zoom — plain scroll moves the page, like Strava's route maps */
                mapEl.addEventListener('wheel', function (e) {
                  if (e.ctrlKey || e.metaKey) {
                    e.preventDefault();
                    var delta = e.deltaY < 0 ? 1 : -1;
                    map.setZoomAround(map.mouseEventToContainerPoint(e), map.getZoom() + delta, { animate: true });
                  }
                }, { passive: false });

                /* ── 3D map (MapLibre GL) — built lazily on first switch ── */
                var map3d = null;
                function init3d() {
                  if (map3d || typeof maplibregl === 'undefined' || !mapEl3d) return;

                  map3d = new maplibregl.Map({
                    container: mapEl3d,
                    cooperativeGestures: true,
                    style: {
                      version: 8,
                      sources: {
                        'esri-imagery': {
                          type: 'raster',
                          tiles: ['https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}'],
                          tileSize: 256,
                          attribution: 'Tiles &copy; Esri'
                        },
                        'esri-labels': {
                          type: 'raster',
                          tiles: ['https://server.arcgisonline.com/ArcGIS/rest/services/Reference/World_Boundaries_and_Places/MapServer/tile/{z}/{y}/{x}'],
                          tileSize: 256
                        },
                        'dem': {
                          type: 'raster-dem',
                          tiles: ['https://elevation-tiles-prod.s3.amazonaws.com/terrarium/{z}/{x}/{y}.png'],
                          tileSize: 256,
                          encoding: 'terrarium'
                        }
                      },
                      layers: [
                        { id: 'satellite', type: 'raster', source: 'esri-imagery' },
                        { id: 'labels', type: 'raster', source: 'esri-labels' }
                      ],
                      terrain: { source: 'dem', exaggeration: 1.4 }
                    },
                    center: [103.603916, 22.422901],
                    zoom: 12,
                    pitch: 65,
                    bearing: -20
                  });

                  map3d.addControl(new maplibregl.NavigationControl({ visualizePitch: true }), 'top-right');

                  map3d.on('load', function () {
                    /* The container was display:none an instant ago, so the very
                       first size MapLibre read at construction time can be stale.
                       Force a resize and let that reflow settle for one frame
                       before placing markers — otherwise their projected screen
                       position is computed against the wrong container size and
                       they land far outside the visible map. */
                    map3d.resize();

                    fetch(mapEl3d.dataset.gpx)
                      .then(function (r) { return r.text(); })
                      .then(function (xml) {
                        var doc = new DOMParser().parseFromString(xml, 'text/xml');
                        var pts = Array.prototype.slice.call(doc.getElementsByTagName('trkpt')).map(function (pt) {
                          return [parseFloat(pt.getAttribute('lon')), parseFloat(pt.getAttribute('lat'))];
                        });
                        if (!pts.length) return;

                        var lineLayout = { 'line-join': 'round', 'line-cap': 'round' };
                        if (dayStyles.length) {
                          /* one coloured line per <trk> (lon/lat order for MapLibre) */
                          readTracks(xml).forEach(function (latlon, i) {
                            var style = dayStyles[i] || dayStyles[dayStyles.length - 1];
                            map3d.addSource('track-' + i, {
                              type: 'geojson',
                              data: { type: 'Feature', geometry: { type: 'LineString', coordinates: latlon.map(function (p) { return [p[1], p[0]]; }) } }
                            });
                            map3d.addLayer({
                              id: 'track-line-' + i,
                              type: 'line',
                              source: 'track-' + i,
                              layout: lineLayout,
                              paint: { 'line-color': style.color, 'line-width': 4 }
                            });
                          });
                        } else {
                          map3d.addSource('track', {
                            type: 'geojson',
                            data: { type: 'Feature', geometry: { type: 'LineString', coordinates: pts } }
                          });
                          map3d.addLayer({
                            id: 'track-line',
                            type: 'line',
                            source: 'track',
                            layout: lineLayout,
                            paint: { 'line-color': '#ea6739', 'line-width': 4 }
                          });
                        }

                        var bounds = pts.reduce(function (b, c) { return b.extend(c); }, new maplibregl.LngLatBounds(pts[0], pts[0]));
                        map3d.fitBounds(bounds, { padding: 40, pitch: 65, bearing: -20, duration: 0 });
                      });

                    requestAnimationFrame(function () {
                      Object.keys(markers).forEach(function (key) {
                        var m = markers[key];
                        if (!m) return;
                        var el = document.createElement('div');
                        /* --lg = bigger dot for the 3D view, where markers sit against
                           a huge photoreal terrain and a 32px dot reads as tiny. */
                        el.className = 'td-routemap__marker td-routemap__marker--' + key + ' td-routemap__marker--lg';
                        el.innerHTML = markerDotHtml(key);
                        new maplibregl.Marker({ element: el })
                          .setLngLat([m.lon, m.lat])
                          .setPopup(new maplibregl.Popup({ offset: 26 }).setHTML('<strong>' + m.label + '</strong><br>' + m.desc))
                          .addTo(map3d);
                      });
                    });
                  });
                }

                /* ── 2D / 3D toggle ─────────────────────────────────────── */
                var buttons = document.querySelectorAll('.td-routemap__viewbtn');
                buttons.forEach(function (btn) {
                  btn.addEventListener('click', function () {
                    buttons.forEach(function (b) { b.classList.remove('is-active'); });
                    btn.classList.add('is-active');
                    var view = btn.dataset.view;
                    if (view === '3d') {
                      mapEl.style.display = 'none';
                      mapEl3d.style.display = 'block';
                      if (rotateHint) rotateHint.classList.add('is-visible');
                      /* Wait a frame so the browser has actually laid out the
                         now-visible container before MapLibre reads its size —
                         see the matching note by map3d.resize() above. */
                      requestAnimationFrame(function () {
                        if (map3d) { map3d.resize(); } else { init3d(); }
                      });
                    } else {
                      mapEl3d.style.display = 'none';
                      mapEl.style.display = 'block';
                      if (rotateHint) rotateHint.classList.remove('is-visible');
                      setTimeout(function () { map.invalidateSize(); }, 50);
                    }
                  });
                });
              })();
            </script>
          </>
        ) : (
          <div class="td-routemap__placeholder">
            <strong>Route map pending.</strong>
            <p>GPX track for {tour.name} will be added once the file is available.</p>
          </div>
        )}
      </div>
    </section>
  )}

  <!-- ═══ S4 · b-timeline (SVG elevation chart) ═════════════════ -->
  <section class="td-timeline">
    <div class="td-timeline__inner">
      <p class="section-label">The journey</p>
      <h2 class="td-timeline__heading">{journeyParts ? 'The journey, day by day.' : (privateRoute && !showChart) ? 'The day, step by step.' : (isMultiDay ? 'The journey, mapped.' : 'A day, mapped.')}</h2>
      {journeyParts && <p class="td-timeline__sub">How you move, and where you sleep.</p>}
      {!journeyParts && (!privateRoute || showChart) && <p class="td-timeline__sub">Time across, elevation up. Every spike is a moment worth remembering.</p>}

      {journeyParts && itineraryDays && (
        <div class="td-journey">
          <div class="td-journey__legend" aria-hidden="true">
            <span class="td-mode td-mode--bike"><i class="ti ti-bike"></i>E-bike</span>
            <span class="td-mode td-mode--trek"><i class="ti ti-walk"></i>Trek</span>
            <span class="td-mode td-mode--drive"><i class="ti ti-car"></i>Drive</span>
            <span class="td-mode td-mode--boat"><i class="ti ti-ship"></i>Boat</span>
          </div>
          {journeyParts.map((part) => (
            <div class="td-journey__part">
              <p class="td-journey__band">{part.label} · days {part.from}–{part.to}</p>
              <ol class="td-journey__list">
                {itineraryDays.filter((d: any) => d.day >= part.from && d.day <= part.to).map((d: any) => (
                  <li class="td-journey__item">
                    <span class="td-journey__num">{d.day}</span>
                    <article class="td-jcard">
                      <div class="td-dslider" data-dslider>
                        <div class="td-dslider__track">
                          {dayImgs(d).map((im: any, n: number) => (
                            <figure class="td-dslider__slide"><img src={im.src} alt={im.alt} loading={d.day === 1 && n === 0 ? 'eager' : 'lazy'} /></figure>
                          ))}
                        </div>
                        {dayImgs(d).length > 1 && (
                          <>
                            <button type="button" class="td-dslider__btn td-dslider__btn--prev" aria-label="Previous photo"><i class="ti ti-chevron-left" aria-hidden="true"></i></button>
                            <button type="button" class="td-dslider__btn td-dslider__btn--next" aria-label="Next photo"><i class="ti ti-chevron-right" aria-hidden="true"></i></button>
                            <div class="td-dslider__dots" aria-hidden="true">{dayImgs(d).map((_: any, n: number) => <span class={`td-dslider__dot${n === 0 ? ' is-active' : ''}`}></span>)}</div>
                          </>
                        )}
                      </div>
                      <div class="td-jcard__body">
                        <p class="td-jcard__day">Day {d.day}</p>
                        <h3 class="td-journey__route">{d.route || d.title}</h3>
                        <div class="td-journey__meta td-journey__meta--card">
                          {(d.modes || []).map((m: any) => (
                            <span class={`td-mode td-mode--${m.type}`}><i class={`ti ti-${m.type === 'bike' ? 'bike' : m.type === 'trek' ? 'walk' : m.type === 'boat' ? 'ship' : 'car'}`} aria-hidden="true"></i>{m.label}</span>
                          ))}
                        </div>
                        <div class="td-journey__meta td-journey__meta--card">
                          {d.accommodation && d.accommodation !== '—' && <span class="td-journey__stay"><i class="ti ti-home" aria-hidden="true"></i>{d.accommodation}</span>}
                          {d.meals && <span class="td-journey__stay"><i class="ti ti-tools-kitchen-2" aria-hidden="true"></i>{d.meals}</span>}
                        </div>
                        {d.narrative && <p class="td-jcard__text">{d.narrative}</p>}
                      </div>
                    </article>
                  </li>
                ))}
              </ol>
            </div>
          ))}
        </div>
      )}

      {showChart ? (
        <div class="td-timeline__chart-wrap">
          <svg
            class="td-timeline__svg"
            viewBox="0 0 1200 500"
            preserveAspectRatio="xMidYMid meet"
            role="img"
            aria-label={`Elevation timeline for ${tour.name}`}
          >
            <defs>
              <linearGradient id="elevGradTeal" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stop-color="var(--color-java)" stop-opacity="0.45" />
                <stop offset="100%" stop-color="var(--color-java)" stop-opacity="0.04" />
              </linearGradient>
              <linearGradient id="elevGradOrange" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stop-color="var(--color-sorbus)" stop-opacity="0.55" />
                <stop offset="100%" stop-color="var(--color-sorbus)" stop-opacity="0.06" />
              </linearGradient>
            </defs>

            {/* Y-axis gridlines + labels */}
            {Array.from({ length: Math.floor(elevMax / 300) + 1 }, (_, i) => i * 300).map((elev) => {
              const yPos = 320 - (elev / elevMax) * 270;
              return (
                <>
                  <line x1="60" y1={yPos} x2="1160" y2={yPos} stroke="rgba(4,51,65,0.07)" stroke-width="1" />
                  <text x="52" y={yPos + 4} text-anchor="end" font-size="11" fill="rgba(4,51,65,0.4)" font-family="Commissioner, sans-serif">{elev}m</text>
                </>
              );
            })}

            {/* Main chart rendering — supports day-coloring and duration splits */}
            {(() => {
              const allPts = elevation!;
              const hasDays = allPts.some((p: any) => p.day != null);
              const hasDurationSplit = allPts.some((p: any) => p.durationOnly);

              // --- helper: x/y from index within a flat array ---
              function ptX(i: number, total: number) { return 60 + i * (1100 / Math.max(1, total - 1)); }
              function ptY(elev: number) { return 320 - (elev / elevMax) * 270; }

              // --- build label lines ---
              function labelLines(label: string): [string, string, string] {
                const parts = label.split(' · ');
                if (parts.length >= 3) return [parts[0], parts[1], parts.slice(2).join(' · ')];
                if (parts.length === 2) return [parts[0], parts[1], ''];
                if (label.includes(' — ')) {
                  const idx = label.indexOf(' — ');
                  return [label.substring(0, idx), label.substring(idx + 3), ''];
                }
                if (label.length > 14) {
                  const mid = Math.floor(label.length / 2);
                  const spaceIdx = label.lastIndexOf(' ', mid + 4);
                  if (spaceIdx > 0) return [label.substring(0, spaceIdx), label.substring(spaceIdx + 1), ''];
                }
                return [label, '', ''];
              }

              // ── CASE A: day-colored segments (lai-chau-motortour style) ──
              // Also handles CASE A+B: hasDays + hasDurationSplit (e.g. sapa-nam-cang)
              // In that case we render one day-coloured chart per duration, toggle via CSS
              if (hasDays) {
                type DivInfo = { x: number; y: number };
                type Seg = { day: number; pathPts: DivInfo[] };

                function buildDayChart(pts: any[]) {
                  const total = pts.length;
                  const coords = pts.map((p: any, i: number) => ({
                    x: ptX(i, total), y: ptY(p.elevation), ...p,
                  }));

                  const dividers: DivInfo[] = [];
                  for (let i = 1; i < coords.length; i++) {
                    if ((coords[i].day ?? 1) !== (coords[i-1].day ?? 1)) {
                      const t = 0.5;
                      const x = coords[i-1].x + t * (coords[i].x - coords[i-1].x);
                      const y = coords[i-1].y + t * (coords[i].y - coords[i-1].y);
                      dividers.push({ x, y });
                    }
                  }

                  const segments: Seg[] = [];
                  {
                    let segDay = coords[0].day ?? 1;
                    let segPts: DivInfo[] = [{ x: coords[0].x, y: coords[0].y }];
                    let divIdx = 0;
                    for (let i = 1; i < coords.length; i++) {
                      const d = coords[i].day ?? 1;
                      if (d !== segDay) {
                        segPts.push({ x: dividers[divIdx].x, y: dividers[divIdx].y });
                        segments.push({ day: segDay, pathPts: segPts });
                        segDay = d;
                        segPts = [{ x: dividers[divIdx].x, y: dividers[divIdx].y }, { x: coords[i].x, y: coords[i].y }];
                        divIdx++;
                      } else {
                        segPts.push({ x: coords[i].x, y: coords[i].y });
                      }
                    }
                    segments.push({ day: segDay, pathPts: segPts });
                  }

                  function segPath(pts: DivInfo[], close: boolean) {
                    let d = pts.map((p, i) => `${i === 0 ? 'M' : 'L'} ${p.x} ${p.y}`).join(' ');
                    if (close) d += ` L ${pts[pts.length-1].x} 320 L ${pts[0].x} 320 Z`;
                    return d;
                  }

                  // Màu luân phiên theo parity (even/odd) để các ngày liền kề luôn khác màu.
                  // Day 1,3,5... = teal (Java). Day 2,4,6... = cam (Sorbus). Day 0 = NIGHT bus (teal mờ).
                  const dayColor = (day: number) => day % 2 === 0 && day !== 0 ? 'var(--color-sorbus)' : 'var(--color-java)';
                  const dayGrad  = (day: number) => day % 2 === 0 && day !== 0 ? 'url(#elevGradOrange)' : 'url(#elevGradTeal)';
                  const dayLabel = (day: number) => day === 0 ? 'NIGHT' : `DAY ${day}`;

                  return (
                    <>
                      {segments.map((seg: Seg) => {
                        const x0 = seg.pathPts[0].x;
                        const x1 = seg.pathPts[seg.pathPts.length - 1].x;
                        const isSorbus = seg.day % 2 === 0 && seg.day !== 0;
                        const bgColor = isSorbus ? 'rgba(234,103,57,0.07)' : seg.day === 0 ? 'rgba(29,160,160,0.05)' : 'rgba(29,160,160,0.08)';
                        return <rect x={x0} y={30} width={x1 - x0} height={290} fill={bgColor} rx="0" />;
                      })}
                      {dividers.map((div: DivInfo) => (
                        <line x1={div.x} y1={30} x2={div.x} y2={370} stroke="rgba(4,51,65,0.25)" stroke-width="1.5" stroke-dasharray="6 4" />
                      ))}
                      {segments.map((seg: Seg) => (
                        <path d={segPath(seg.pathPts, true)} fill={dayGrad(seg.day)} />
                      ))}
                      {segments.map((seg: Seg) => (
                        <path d={segPath(seg.pathPts, false)} fill="none" stroke={dayColor(seg.day)} stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
                      ))}
                      {segments.map((seg: Seg) => {
                        const midX = (seg.pathPts[0].x + seg.pathPts[seg.pathPts.length-1].x) / 2;
                        return (
                          <text x={midX} y={395} text-anchor="middle" font-size="11" font-weight="700" letter-spacing="0.08em" fill={dayColor(seg.day)} font-family="Commissioner, sans-serif" opacity="0.7">
                            {dayLabel(seg.day)}
                          </text>
                        );
                      })}
                      {coords.map((p: any) => {
                        const d = p.day ?? 1;
                        const dotColor = dayColor(d);
                        const dotR = p.highlight ? 10 : 7;
                        const [line1, line2, line3] = labelLines(p.label);
                        const fw = p.highlight ? '700' : '500';
                        const baseY = 340;
                        const showLabel = true;
                        const elevY = baseY + (line3 ? 39 : line2 ? 26 : 13);
                        return (
                          <g class={`td-timeline__point${p.highlight ? ' is-highlight' : ''}`}>
                            <circle cx={p.x} cy={p.y} r={dotR} fill={dotColor} stroke="white" stroke-width="2.5" />
                            {p.time && <text x={p.x} y={p.y - 18} text-anchor="middle" font-size="10" font-weight="700" fill="var(--color-nordic)" font-family="Commissioner, sans-serif">{p.time}</text>}
                            {showLabel && <text x={p.x} y={baseY} text-anchor="middle" font-size="10" fill="var(--color-nordic)" font-family="Commissioner, sans-serif" font-weight={fw}>{line1}</text>}
                            {showLabel && line2 && <text x={p.x} y={baseY + 13} text-anchor="middle" font-size="10" fill="var(--color-nordic)" font-family="Commissioner, sans-serif" font-weight={fw}>{line2}</text>}
                            {showLabel && line3 && <text x={p.x} y={baseY + 26} text-anchor="middle" font-size="10" fill="var(--color-nordic)" font-family="Commissioner, sans-serif" font-weight={fw}>{line3}</text>}
                            {showLabel && <text x={p.x} y={elevY} text-anchor="middle" font-size="9" fill="rgba(4,51,65,0.45)" font-family="Commissioner, sans-serif">{p.elevation}m</text>}
                          </g>
                        );
                      })}
                    </>
                  );
                }

                // CASE A+B: has both day-coloring AND duration split — render per-duration charts
                if (hasDurationSplit) {
                  const sharedPts = allPts.filter((p: any) => !p.durationOnly);
                  const pts1day = [...sharedPts, ...allPts.filter((p: any) => p.durationOnly === '1day')];
                  const pts2d1n = [...sharedPts, ...allPts.filter((p: any) => p.durationOnly === '2d1n')];
                  const pts3d2n = [...sharedPts, ...allPts.filter((p: any) => p.durationOnly === '3d2n')];
                  return (
                    <>
                      {pts1day.length > 0 && (
                        <g class="svg-path-1day">{buildDayChart(pts1day)}</g>
                      )}
                      {pts2d1n.length > 0 && (
                        <g class="svg-path-2d1n">{buildDayChart(pts2d1n)}</g>
                      )}
                      {pts3d2n.length > 0 && (
                        <g class="svg-path-3d2n">{buildDayChart(pts3d2n)}</g>
                      )}
                    </>
                  );
                }

                // CASE A pure: no durationOnly, just day-coloring
                return buildDayChart(allPts);
              }

              // ── CASE B: duration-split (1day / 2d1n / 3d2n) — original logic ──
              const sharedPts = allPts.filter((p: any) => !p.durationOnly);
              const pts1day = [...sharedPts, ...allPts.filter((p: any) => p.durationOnly === '1day')];
              const pts2d1n = [...sharedPts, ...allPts.filter((p: any) => p.durationOnly === '2d1n')];
              const pts3d2n = [...sharedPts, ...allPts.filter((p: any) => p.durationOnly === '3d2n')];

              function makePath(pts: any[], close: boolean) {
                const step = 1100 / Math.max(1, pts.length - 1);
                let d = pts.map((p: any, i: number) => {
                  const x = ptX(i, pts.length);
                  const y = ptY(p.elevation);
                  return `${i === 0 ? 'M' : 'L'} ${x} ${y}`;
                }).join(' ');
                if (close) {
                  const lastX = ptX(pts.length - 1, pts.length);
                  d += ` L ${lastX} 320 L 60 320 Z`;
                }
                return d;
              }

              function renderDots(pts: any[], durClass: string) {
                return pts.map((p: any, i: number) => {
                  const x = ptX(i, pts.length);
                  const y = ptY(p.elevation);
                  const [line1, line2, line3] = labelLines(p.label);
                  const fw = p.highlight ? '700' : '500';
                  const baseY = 340;
                  const elevY = baseY + (line3 ? 39 : line2 ? 26 : 13);
                  return (
                    <g class={`td-timeline__point ${durClass}${p.highlight ? ' is-highlight' : ''}`} data-duration={p.durationOnly || 'all'}>
                      <circle cx={x} cy={y} r={p.highlight ? 10 : 7} fill={p.highlight ? 'var(--color-sorbus)' : 'var(--color-java)'} stroke="white" stroke-width="2.5" />
                      <text x={x} y={y - 18} text-anchor="middle" font-size="10" font-weight="700" fill="var(--color-nordic)" font-family="Commissioner, sans-serif">{p.time}</text>
                      <text x={x} y={baseY} text-anchor="middle" font-size="10" fill="var(--color-nordic)" font-family="Commissioner, sans-serif" font-weight={fw}>{line1}</text>
                      {line2 && <text x={x} y={baseY + 13} text-anchor="middle" font-size="10" fill="var(--color-nordic)" font-family="Commissioner, sans-serif" font-weight={fw}>{line2}</text>}
                      {line3 && <text x={x} y={baseY + 26} text-anchor="middle" font-size="10" fill="var(--color-nordic)" font-family="Commissioner, sans-serif" font-weight={fw}>{line3}</text>}
                      <text x={x} y={elevY} text-anchor="middle" font-size="9" fill="rgba(4,51,65,0.45)" font-family="Commissioner, sans-serif">{p.elevation}m</text>
                    </g>
                  );
                });
              }

              return (
                <>
                  <path class="svg-path-1day" d={makePath(pts1day, true)} fill="url(#elevGradTeal)" />
                  {pts2d1n.length > 0 && <path class="svg-path-2d1n" d={makePath(pts2d1n, true)} fill="url(#elevGradTeal)" />}
                  {pts3d2n.length > 0 && <path class="svg-path-3d2n" d={makePath(pts3d2n, true)} fill="url(#elevGradTeal)" />}
                  <path class="svg-path-1day" d={makePath(pts1day, false)} fill="none" stroke="var(--color-java)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
                  {pts2d1n.length > 0 && <path class="svg-path-2d1n" d={makePath(pts2d1n, false)} fill="none" stroke="var(--color-java)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />}
                  {pts3d2n.length > 0 && <path class="svg-path-3d2n" d={makePath(pts3d2n, false)} fill="none" stroke="var(--color-java)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />}
                  {renderDots(pts1day, 'svg-path-1day')}
                  {pts2d1n.length > 0 && renderDots(pts2d1n, 'svg-path-2d1n')}
                  {pts3d2n.length > 0 && renderDots(pts3d2n, 'svg-path-3d2n')}
                </>
              );
            })()}

            {/* X-axis baseline */}
            <line x1="60" y1="320" x2="1160" y2="320" stroke="var(--color-nordic)" stroke-width="1" opacity="0.2" />
          </svg>
        </div>
      ) : (privateRoute || journeyParts) ? null : (
        <div class="td-timeline__placeholder">
          <strong>Timeline data pending.</strong>
          <p>Elevation profile for {tour.name} will be added once the route is finalized.</p>
        </div>
      )}
      {showChart && (
        <p class="td-timeline__disclaimer">⏱ Time markers are estimates — actual pace depends on each group's fitness level.</p>
      )}
      {(useDayCards && !journeyParts) ? (
        <div class="td-timeline__cards">
          {itineraryDays.map((day: any) => (
            <div class="td-timeline__act-card td-timeline__act-card--day">
              <div class="td-timeline__act-badges">
                <span class="td-timeline__act-badge td-timeline__act-badge--day">Day {day.day}</span>
                {day.accommodation && <span class="td-timeline__act-badge td-timeline__act-badge--accommodation"><i class="ti ti-home" aria-hidden="true"></i> {day.accommodation}</span>}
                {day.meals && <span class="td-timeline__act-badge td-timeline__act-badge--meal"><i class="ti ti-tools-kitchen-2" aria-hidden="true"></i> {day.meals}</span>}
              </div>
              <div class="td-timeline__act-title">{day.title}</div>
              {day.modes && day.modes.length > 0 && (
                <div class="td-journey__meta td-journey__meta--card">
                  {day.modes.map((m: any) => (
                    <span class={`td-mode td-mode--${m.type}`}><i class={`ti ti-${m.type === 'bike' ? 'bike' : m.type === 'trek' ? 'walk' : m.type === 'boat' ? 'ship' : 'car'}`} aria-hidden="true"></i>{m.label}</span>
                  ))}
                </div>
