    font-size: 18px;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .td-unlock__card-title {
    font-family: var(--font-heading);
    font-size: 19px;
    font-weight: 700;
    color: var(--color-riptide);
    line-height: 1.2;
  }

  .td-unlock__card-desc {
    font-size: 14px;
    line-height: 1.65;
    color: rgba(217,247,245,0.72);
  }

  .td-unlock__note {
