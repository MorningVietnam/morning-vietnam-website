    transition: background 0.18s, color 0.18s;
    white-space: nowrap;
  }

  .td-upcoming__pill:hover {
    background: var(--color-nordic);
    color: var(--color-light-cyan);
  }

  /* ── S2 td-marquee ──────────────────────────────── */
  .td-marquee {
    --marquee-bg: var(--color-nordic);
    --marquee-color: var(--color-riptide);
    padding: 14px 0;
  }

  /* ── S3 td-pitch ────────────────────────────────── */
  .td-pitch {
    background: var(--color-light-cyan);
    padding: 60px 0;
  }

  .td-pitch__inner {
    max-width: 880px;
    margin: 0 auto;
    padding: 0 48px;
  }

  .td-pitch__headline {
    font-family: var(--font-heading);
    font-size: clamp(28px, 3.6vw, 44px);
    font-weight: 700;
    line-height: 1.25;
    color: var(--color-nordic);
    letter-spacing: -0.015em;
    padding-left: 24px;
    border-left: 5px solid var(--color-sorbus);
    margin: 24px 0 40px;
  }

  .td-pitch__body p {
    font-size: 18px;
    line-height: 1.8;
    color: var(--color-nordic);
    opacity: 0.85;
    margin-bottom: 20px;
    max-width: 720px;
  }

  .td-pitch__closing {
    font-family: var(--font-heading);
    font-size: 20px !important;
    font-weight: 700;
    color: var(--color-nordic) !important;
    opacity: 1 !important;
    margin-top: 32px !important;
  }

  .td-pitch__bullets {
    list-style: none;
    padding: 0;
    margin: 40px 0 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
    max-width: 720px;
  }

  .td-pitch__bullets li {
    font-size: 17px;
    line-height: 1.55;
    color: var(--color-nordic);
    padding-left: 24px;
    position: relative;
  }

  .td-pitch__bullets li::before {
    content: '→';
    position: absolute;
    left: 0;
    color: var(--color-sorbus);
    font-weight: 700;
  }

  @media (max-width: 768px) {
    .td-pitch__inner    { padding: 0 24px; }
    .td-pitch__headline { padding-left: 16px; border-left-width: 4px; }
    .td-pitch          { padding: 40px 0; }
    .td-pitch__bullets li { font-size: 15px; }
  }

  /* ── S4 td-value ────────────────────────────────── */
  .td-value {
    background: var(--color-light-cyan);
    padding: 60px 0;
  }

  .td-value__inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 48px;
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: 64px;
    align-items: start;
  }

  .td-value__heading {
    font-family: var(--font-heading);
    font-size: clamp(32px, 4.4vw, 56px);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--color-nordic);
    margin: 12px 0 32px;
  }

  .td-value__heading em {
    font-style: italic;
    color: var(--color-sorbus);
  }

  :global(.td-value__body p) {
    font-size: 16px;
    line-height: 1.75;
    color: var(--color-nordic);
    opacity: 0.82;
    margin-bottom: 16px;
  }

  .td-value__table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    background: white;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 4px 24px rgba(4,51,65,0.08);
  }

  :global(.td-value__table th),
  :global(.td-value__table td) {
    padding: 16px 20px;
    text-align: left;
    font-size: 14px;
    border-bottom: 1px solid rgba(4,51,65,0.08);
  }

  :global(.td-value__table thead th) {
    font-family: var(--font-heading);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    background: var(--color-light-cyan);
    color: var(--color-nordic);
  }

  :global(.td-value__th-us) {
    background: var(--color-java) !important;
    color: white !important;
  }

  :global(.td-value__metric) {
    font-weight: 600;
    color: var(--color-nordic);
  }

  :global(.td-value__bad) {
    color: rgba(4,51,65,0.55);
    text-decoration: line-through;
    text-decoration-color: rgba(234,103,57,0.4);
  }

  :global(.td-value__bad--merged) {
    text-decoration: none;
    vertical-align: middle;
    text-align: center;
    font-style: italic;
    font-size: 13px;
    line-height: 1.5;
    color: rgba(4,51,65,0.45);
    background: rgba(4,51,65,0.02);
    border-left: 2px solid rgba(234,103,57,0.2);
  }

  :global(.td-value__good) {
    font-weight: 700;
    color: var(--color-java);
  }

  :global(.td-value__good)::before {
    content: '✓ ';
    color: var(--color-java);
    font-weight: 700;
  }

  :global(.td-value__table tbody tr:last-child td) { border-bottom: none; }

  @media (max-width: 960px) {
    .td-value__inner { grid-template-columns: 1fr; gap: 48px; padding: 0 24px; }
    .td-value        { padding: 40px 0; }
  }

  @media (max-width: 560px) {
    .td-value__table th,
    .td-value__table td { padding: 12px 14px; font-size: 13px; }
  }

  /* ── S5 td-overview ─────────────────────────────── */
  .td-overview {
    background: var(--color-white, #fff);
    padding: 60px 0 40px;
  }

  .td-overview__inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 48px;
    display: flex;
    flex-direction: column;
    gap: 48px;
  }

  .td-overview__top {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 80px;
    align-items: start;
  }

  .td-overview__cols {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
  }

  .td-overview__cols p {
    font-size: 17px;
    line-height: 1.75;
    color: var(--color-nordic);
    opacity: 0.85;
    margin: 0;
  }

  .td-overview__headline {
    font-family: var(--font-heading);
    font-size: clamp(36px, 5vw, 64px);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--color-nordic);
    margin-bottom: 32px;
  }

  .td-overview__body p {
    font-size: 17px;
    line-height: 1.75;
    color: var(--color-nordic);
    opacity: 0.85;
    margin-bottom: 18px;
  }

  .td-overview__right img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 20px;
    display: block;
  }

  .td-overview__photo-pending {
    width: 100%;
    aspect-ratio: 4 / 5;
    background: rgba(29, 160, 160, 0.08);
    border: 2px dashed var(--color-java);
    border-radius: 20px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 40px;
    color: var(--color-nordic);
  }

  .td-overview__photo-pending strong {
    display: block;
    font-family: var(--font-heading);
    font-size: 13px;
    letter-spacing: 0.14em;
    color: var(--color-sorbus);
    margin-bottom: 12px;
  }

  .td-overview__photo-pending p {
    font-size: 13px;
    opacity: 0.65;
    line-height: 1.6;
  }


  /* ── S4 td-timeline ──────────────────────────────── */
  .td-timeline {
    background: var(--color-light-cyan);
    padding: 60px 0;
  }

  .td-timeline__inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 48px;
  }

  .td-timeline__label {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-java);
    margin-bottom: 16px;
  }

  .td-timeline__heading {
    font-family: var(--font-heading);
    font-size: clamp(32px, 4.5vw, 56px);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--color-nordic);
    margin-bottom: 12px;
  }

  .td-timeline__sub {
    font-size: 16px;
    line-height: 1.65;
    color: var(--color-nordic);
    opacity: 0.7;
    margin-bottom: 48px;
    max-width: 560px;
  }

  .td-timeline__chart-wrap {
    width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .td-timeline__svg {
    display: block;
  }

  .td-timeline__placeholder {
    background: rgba(29, 160, 160, 0.06);
    border: 2px dashed var(--color-java);
    border-radius: 16px;
    padding: 64px 40px;
    text-align: center;
    color: var(--color-nordic);
    opacity: 0.6;
    font-size: 15px;
    line-height: 1.6;
  }

  .td-timeline__disclaimer {
    margin-top: 12px;
    font-size: 13px;
    color: rgba(4, 51, 65, 0.5);
    text-align: center;
    font-style: italic;
  }

  /* ── td-timeline activity cards ─────────────────── */
  .td-timeline__cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 16px;
    margin-top: 40px;
  }

  .td-timeline__act-card {
    background: white;
    border-radius: 12px;
    padding: 22px 20px;
    border-left: 4px solid var(--color-java);
    box-shadow: 0 2px 12px rgba(4,51,65,0.06);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .td-timeline__act-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 24px rgba(4,51,65,0.10);
  }

  .td-timeline__act-card.is-highlight { border-left-color: var(--color-sorbus); }

  .td-timeline__act-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 10px;
  }

  .td-timeline__act-badge {
    display: inline-block;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 3px 10px;
    border-radius: 12px;
  }

  /* Badge color per type */
  .td-timeline__act-badge--history       { background: rgba(4,51,65,0.08); color: var(--color-nordic); }
  /* ── Journey overview (multi-activity tours) ── */
  .td-journey { margin: 8px 0 32px; }
  .td-journey__legend { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 18px; }
  .td-journey__part { margin-bottom: 22px; }
  .td-journey__band { font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase; font-weight: 700; color: var(--color-nordic); background: var(--color-light-cyan); padding: 8px 14px; border-radius: 8px; margin: 0 0 16px; }
  .td-journey__list { list-style: none; margin: 0; padding: 0; position: relative; }
  .td-journey__item { display: grid; grid-template-columns: 34px minmax(0, 1fr); column-gap: 14px; position: relative; padding-bottom: 18px; }
  .td-journey__item:not(:last-child)::before { content: ''; position: absolute; left: 16px; top: 34px; bottom: 0; width: 2px; background: var(--color-light-cyan); }
  .td-journey__num { width: 34px; height: 34px; border-radius: 50%; background: var(--color-java); color: #fff; font-weight: 700; font-size: 14px; display: flex; align-items: center; justify-content: center; z-index: 1; }
  .td-journey__route { margin: 4px 0 8px; font-weight: 700; font-size: 16px; color: var(--color-nordic); }
  .td-journey__meta { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
  .td-journey__meta--card { margin: 2px 0 10px; }
  .td-journey__stay { font-size: 13px; color: var(--color-nordic); opacity: 0.75; display: inline-flex; gap: 5px; align-items: center; }
  .td-mode { font-size: 13px; font-weight: 600; padding: 4px 10px; border-radius: 999px; display: inline-flex; gap: 6px; align-items: center; }
  .td-mode--bike  { background: var(--color-light-cyan); color: var(--color-nordic); }
  .td-mode--trek  { background: var(--color-java); color: #fff; }
  .td-mode--drive { background: var(--color-white-nectar); color: var(--color-nordic); box-shadow: inset 0 0 0 1px rgba(4,51,65,0.15); }
  .td-mode--boat  { background: var(--color-riptide); color: var(--color-nordic); }
  .td-jcard { background: #fff; border-radius: 16px; overflow: hidden; box-shadow: 0 2px 14px rgba(4,51,65,0.10); min-width: 0; }
  .td-jcard__body { padding: 18px 22px 22px; }
  .td-jcard__day { margin: 0 0 2px; font-size: 12px; letter-spacing: 0.1em; text-transform: uppercase; font-weight: 700; color: var(--color-java); }
  .td-jcard__text { margin: 12px 0 0; line-height: 1.65; color: var(--color-nordic); }
  .td-journey__item { padding-bottom: 28px; }
  .td-journey__item:not(:last-child)::before { top: 40px; }
  .td-journey__route { margin: 2px 0 10px; }
  .td-dslider { position: relative; background: var(--color-nordic); }
  .td-dslider__track { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; -webkit-overflow-scrolling: touch; }
  .td-dslider__track::-webkit-scrollbar { display: none; }
  .td-dslider__slide { flex: 0 0 100%; margin: 0; scroll-snap-align: start; aspect-ratio: 4 / 3; }
  .td-dslider__slide img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .td-dslider__btn { position: absolute; top: 50%; transform: translateY(-50%); width: 38px; height: 38px; border-radius: 50%; border: none; background: rgba(255,255,255,0.92); color: var(--color-nordic); font-size: 20px; display: flex; align-items: center; justify-content: center; cursor: pointer; box-shadow: 0 1px 6px rgba(0,0,0,0.25); }
  .td-dslider__btn--prev { left: 12px; }
  .td-dslider__btn--next { right: 12px; }
  .td-dslider__dots { position: absolute; left: 0; right: 0; bottom: 10px; display: flex; justify-content: center; gap: 6px; }
  .td-dslider__dot { width: 7px; height: 7px; border-radius: 50%; background: rgba(255,255,255,0.55); }
  .td-dslider__dot.is-active { background: #fff; width: 18px; border-radius: 4px; }
  @media (min-width: 900px) {
    .td-jcard { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); }
  }
  .td-timeline__act-badge--meal          { background: #fde8d8; color: #8b3a10; }
  .td-timeline__act-badge--challenge     { background: #e8f5e9; color: #2e7d32; }
  .td-timeline__act-badge--hiking        { background: var(--color-light-cyan); color: var(--color-nordic); }
  .td-timeline__act-badge--accommodation { background: #ede7f6; color: #4527a0; }
  /* Fallbacks for old data */
  .td-timeline__act-badge--trek    { background: var(--color-light-cyan); color: var(--color-nordic); }
  .td-timeline__act-badge--food    { background: #fde8d8; color: #8b3a10; }
  .td-timeline__act-badge--culture { background: rgba(4,51,65,0.08); color: var(--color-nordic); }
  .td-timeline__act-badge--free    { background: #e8f5e9; color: #2e7d32; }

  .td-timeline__act-time {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-java);
    margin-bottom: 6px;
  }

  .td-timeline__act-time.is-highlight { color: var(--color-sorbus); }

  .td-timeline__act-title {
    font-family: var(--font-heading);
    font-size: 16px;
    font-weight: 700;
    color: var(--color-nordic);
    line-height: 1.3;
    margin-bottom: 8px;
  }

  .td-timeline__act-desc {
    font-size: 13px;
    line-height: 1.6;
    color: var(--color-nordic);
    opacity: 0.7;
  }

  /* ── S5 td-audience ──────────────────────────────── */
  .td-audience {
    background: var(--color-light-cyan);
    padding: 60px 0;
  }

  .td-audience__inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 48px;
  }

  .td-audience__label {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-java);
    margin-bottom: 16px;
  }

  .td-audience__heading {
    font-family: var(--font-heading);
    font-size: clamp(32px, 4.5vw, 56px);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--color-nordic);
    margin-bottom: 56px;
  }

  .td-audience__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }

  .td-audience__card {
    background: white;
    border-radius: 20px;
    padding: 36px 28px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .td-audience__card:hover {
    transform: translateY(-6px);
    box-shadow: 0 16px 40px rgba(4, 51, 65, 0.12);
  }

  .td-audience__icon {
    font-size: 36px;
    line-height: 1;
    margin-bottom: 4px;
  }

  .td-audience__card-title {
    font-family: var(--font-heading);
    font-size: 18px;
    font-weight: 700;
    color: var(--color-nordic);
    line-height: 1.2;
  }

  .td-audience__card-desc {
    font-size: 14px;
    line-height: 1.65;
    color: var(--color-nordic);
    opacity: 0.75;
  }

  /* ── Responsive ─────────────────────────────────── */
  @media (max-width: 960px) {
    .td-product__inner         { grid-template-columns: 1fr; }
    .td-product__gallery       { min-height: unset; padding: 20px 0 0; }
    .td-product__main-image    { flex: none; aspect-ratio: 1660/1480; margin: 0 auto; width: calc(100% - 40px); border-radius: 20px; }
    .td-product__thumbs        { display: grid; grid-template-columns: repeat(5, 1fr); gap: 8px; padding: 20px 0 16px; width: calc(100% - 40px); margin: 0 auto; flex-wrap: unset; }
    .td-product__thumb         { width: 100%; height: auto; aspect-ratio: 1/1; }
    .td-gallery__arrow         { width: 30px; height: 30px; }
    .td-product__panel         { padding: 40px 24px; }
    .td-overview__inner        { padding: 0 24px; gap: 32px; }
    .td-overview__top          { grid-template-columns: 1fr; gap: 32px; }
    .td-overview__cols         { grid-template-columns: 1fr; gap: 24px; }
    .td-overview               { padding: 40px 0 30px; }
    .td-timeline__inner        { padding: 0 24px; }
    .td-timeline               { padding: 40px 0; }
    .td-audience__inner        { padding: 0 24px; }
    .td-audience               { padding: 40px 0; }
    .td-audience__grid         { grid-template-columns: 1fr 1fr; }
  }

  @media (max-width: 768px) {
    .td-product__thumbs { display: none; }
  }

  @media (max-width: 480px) {
    .td-product__heading { font-size: 36px; }
    .td-product__price   { font-size: 28px; }
    .td-audience__grid { grid-template-columns: 1fr; }
    .td-tripinfo__grid { grid-template-columns: 1fr; }
    :global(.td-tripinfo__icon-wrap) { width: 36px; height: 36px; }
    :global(.td-tripinfo__icon-wrap i) { font-size: 17px; }
    .td-selector__select { font-size: 14px; padding: 11px 38px 11px 14px; }
  }

  /* ── S7 td-welcome ─────────────────────────────── */
  .td-welcome {
    background: #ffffff;
    padding: 80px 0;
  }

  .td-welcome__inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 48px;
  }

  .td-welcome__cols {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: center;
  }

  .td-welcome__text {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .td-welcome__heading {
    font-family: var(--font-heading);
    font-size: clamp(32px, 4vw, 56px);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--color-nordic);
    margin: 12px 0 24px;
  }

  .td-welcome__intro {
    font-size: 17px;
    line-height: 1.75;
    color: var(--color-nordic);
    opacity: 0.72;
    margin: 0;
  }

  .td-welcome__photo {
    border-radius: 24px;
    overflow: hidden;
    box-shadow: 0 24px 64px rgba(4, 51, 65, 0.14);
  }

  .td-welcome__photo img {
    width: 100%;
    height: auto;
    display: block;
  }

  @media (max-width: 900px) {
    .td-welcome__cols {
      grid-template-columns: 1fr;
      gap: 48px;
    }
    .td-welcome__photo {
      max-width: 480px;
      margin: 0 auto;
    }
  }

  @media (max-width: 768px) {
    .td-welcome__inner { padding: 0 24px; }
    .td-welcome        { padding: 56px 0; }
  }

  /* ── S6 td-unlock ──────────────────────────────── */
  .td-unlock {
    background: var(--color-nordic);
    padding: 60px 0;
  }

  .td-unlock__inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 48px;
  }

  .td-unlock .section-label { color: var(--color-sorbus); }

  .td-unlock__heading {
    font-family: var(--font-heading);
    font-size: clamp(40px, 5.5vw, 72px);
    font-weight: 700;
    line-height: 1.0;
    letter-spacing: -0.025em;
    color: var(--color-riptide);
    margin: 12px 0 20px;
  }

  .td-unlock__intro {
    font-size: 17px;
    line-height: 1.7;
    color: rgba(217,247,245,0.78);
    max-width: 640px;
    margin-bottom: 56px;
  }

  .td-unlock__cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin-bottom: 32px;
  }

  .td-unlock__card {
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(217,247,245,0.14);
    border-radius: 16px;
    padding: 32px 28px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .td-unlock__num {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--color-sorbus);
