          <p class="td-review__author"><strong>Léa M.</strong> · Friend group · Belgium · <em>verified</em></p>
        </article>
      </div>
    </div>
  </section>

  <!-- ═══ S8 · b-cta (full-bleed quote) ═════════════════════════ -->
  <section class="td-cta">
    <div class="td-cta__image">
      <img src="https://images.unsplash.com/photo-1528127269322-539801943592?w=2000&q=85" alt="" loading="lazy" />
    </div>
    <div class="td-cta__overlay"></div>
    <div class="td-cta__content">
      <blockquote class="td-cta__quote">
        Your moment.<br/>Your Vietnam.
      </blockquote>
      <p class="td-cta__sub">Tours that don't perform the country to you — they let you in.</p>
      <a href="/tours" class="c-button c-button--light">See all tours →</a>
    </div>
  </section>

  <!-- ═══ S-cta-bottom · inline CTA before FAQ ════════════════════ -->
  {!tour.comingSoon && ctaPrice && (
    <section class="td-cta-bottom">
      <div class="td-cta-bottom__inner">
        <div class="td-cta-bottom__text">
          <p class="td-cta-bottom__eyebrow">Ready to go?</p>
          <h2 class="td-cta-bottom__heading">{tour.name}</h2>
          <p class="td-cta-bottom__price">
            from ${ctaPrice}
            {ctaPriceVND && <span class="td-cta-bottom__vnd"> / {ctaPriceVND.toLocaleString('vi-VN')} VND</span>}
            <span class="td-cta-bottom__unit"> /person</span>
          </p>
          <p class="td-cta-bottom__note">No payment now — reserve your spot, pay 14 days before. Free cancellation.</p>
        </div>
        <div class="td-cta-bottom__actions">
          <a href={ctaContactLink} class="c-button c-button--primary">
            I'm in →
          </a>
          <a href="/contact" class="c-button c-button--ghost">Send an inquiry</a>
        </div>
      </div>
    </section>
  )}

  <!-- ═══ S9 · b-faq ════════════════════════════════════════════ -->
  <section class="td-faq">
    <div class="td-faq__inner">
      <div class="td-faq__left">
        <p class="section-label">FAQ</p>
        <h2 class="td-faq__heading">Questions, answered.</h2>
        <p class="td-faq__sub">Can't find what you're looking for? <a href="https://wa.me/84961836611" target="_blank" rel="noopener">WhatsApp us</a>.</p>
      </div>
      <div class="td-faq__right">
        {(faqs || []).map((f: any) => (
          <details class="td-faq__item">
            <summary>{f.q}</summary>
            <div class="td-faq__answer">{f.a}</div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ S11 · b-related ═══════════════════════════════════════ -->
  <section class="td-related">
    <div class="td-related__inner">
      <p class="section-label">More journeys</p>
      <h2 class="td-related__heading">If this resonates,<br/>you'll love these too.</h2>
      <div class="td-related__grid">
        {tours
          .filter((t: any) => t.slug !== tour.slug && !t.comingSoon)
          .slice(0, 3)
          .map((other: any) => (
            <a href={`/tours/${other.slug}`} class="td-related__card">
              <div class="td-related__card-image">
                <img src={other.image} alt={other.name} loading="lazy" />
              </div>
              <div class="td-related__card-body">
                <p class="td-related__card-region">{other.region === 'north' ? 'North Vietnam' : other.region}</p>
                <h3 class="td-related__card-name">{other.name}</h3>
                <p class="td-related__card-tagline">{other.tagline}</p>
                <span class="td-related__card-link">See this tour →</span>
              </div>
            </a>
          ))}
      </div>
    </div>
  </section>

  <NotifyPopup />

  <!-- ═══ Sticky bottom bar ════════════════════════════════════════ -->
  {!tour.comingSoon && ctaPrice && (
    <div class="td-sticky-bar" id="td-sticky-bar" aria-hidden="true">
      <div class="td-sticky-bar__inner">
        <div class="td-sticky-bar__info">
          <span class="td-sticky-bar__name">{tour.name}</span>
          <span class="td-sticky-bar__price">
            from ${ctaPrice}
            {ctaPriceVND && <span class="td-sticky-bar__vnd"> / {ctaPriceVND.toLocaleString('vi-VN')} VND</span>}
            <span class="td-sticky-bar__unit"> /person</span>
          </span>
        </div>
        <a href={ctaContactLink} class="td-sticky-bar__btn">
          I'm in →
        </a>
      </div>
    </div>
  )}
</BaseLayout>

<style>
  /* ── S1 b-product split ──────────────────────────── */
